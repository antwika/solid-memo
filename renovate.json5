{
    $schema: 'https://docs.renovatebot.com/renovate-schema.json',
    extends: [
        'config:recommended',
    ],
    baseBranchPatterns: [
        'main',
    ],
    automerge: true,
    automergeType: 'branch',
    packageRules: [
        // The end-to-end tests run against two majors of each Solid server,
        // each pinned in e2e/pod/servers/ (docs/testing.md): each stays on
        // its major, the Community Solid Server's in its compose file,
        // node-solid-server's in the lockfile its image is built from.
        // Its tags are versions, and 8's are prereleases: read as semver.
        {
            matchDepNames: ['solidproject/community-server'],
            versioning: 'semver',
        },
        {
            matchFileNames: ['e2e/pod/servers/css-6/compose.yml'],
            matchDepNames: ['solidproject/community-server'],
            allowedVersions: '<7',
        },
        {
            matchFileNames: ['e2e/pod/servers/css-7/compose.yml'],
            matchDepNames: ['solidproject/community-server'],
            allowedVersions: '<8',
        },
        // The advisory 8 follows its alphas to 8.0.0 (docs/testing.md); what
        // it reports is for a person to look at, so nothing merges itself.
        {
            matchFileNames: ['e2e/pod/servers/css-8/compose.yml'],
            matchDepNames: ['solidproject/community-server'],
            allowedVersions: '>=8.0.0-0 <9',
            ignoreUnstable: false,
            automerge: false,
        },
        {
            matchFileNames: ['e2e/pod/servers/nss/5/package.json'],
            matchDepNames: ['solid-server'],
            allowedVersions: '<6',
        },
        // Its image runs both node-solid-server majors: Node 24, the
        // newest both support.
        {
            matchFileNames: ['e2e/pod/servers/nss/Dockerfile'],
            matchDepNames: ['node'],
            allowedVersions: '<25',
        },
        // The Community Solid Server's tags are pushed again now and then:
        // a new digest for the same version is for a person to look at.
        {
            matchDepNames: ['solidproject/community-server'],
            matchUpdateTypes: ['digest'],
            automerge: false,
        },
        // The images the end-to-end tests build themselves are in no registry.
        {
            matchDepNames: ['/^localhost\\//'],
            enabled: false,
        },
    ],
}