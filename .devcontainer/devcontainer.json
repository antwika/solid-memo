{
  "name": "Turborepo",
  "build": {
    "dockerfile": "Dockerfile"
  },

  "features": {
    "ghcr.io/devcontainers/features/git:1": {}
  },

  "customizations": {
    "vscode": {
      "extensions": [
        "anthropic.claude-code"
      ],
      "settings": {
        "editor.formatOnSave": false
      }
    }
  },

  "forwardPorts": [
    4173,
    5173
  ],

  "postCreateCommand": "npm ci",

  "remoteUser": "node"
}
