@base <https://solid-memo.com/shapes/deck/v2.ttl> .

@prefix sh:         <http://www.w3.org/ns/shacl#> .
@prefix solid-memo: <https://solid-memo.com/vocab/v1#> .
@prefix xsd:        <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms:    <http://purl.org/dc/terms/> .
@prefix rdfs:       <http://www.w3.org/2000/01/rdf-schema#> .

# Deck format 2: format 1 plus the study direction, which a format-2 deck
# always states. Shaped two ways like format 1: <#inPod> and <#inLibrary>.
<#inPod>
    a sh:NodeShape ;
    sh:name "DeckV2" ;
    rdfs:comment "Deck format 2 as a catalog entry in a pod." ;
    sh:nodeKind sh:IRI ;
    sh:class solid-memo:Deck ;
    sh:property <#formatVersion> ,
                <#title> ,
                <#created> ,
                <#creator> ,
                <#license> ,
                <#description> ,
                <#direction> ,
                <#cardsDocument> ,
                <#reviewsDocument> ,
                <#source> .

<#inLibrary>
    a sh:NodeShape ;
    sh:name "LibraryDeckV2" ;
    rdfs:comment "Deck format 2 as a deck-library document." ;
    sh:nodeKind sh:IRI ;
    sh:class solid-memo:Deck ;
    sh:property <#formatVersion> ,
                <#title> ,
                <#created> ,
                <#creator> ,
                <#license> ,
                <#description> ,
                <#direction> ,
                <#noCardsDocument> ,
                <#noReviewsDocument> ,
                <#sources> .

<#formatVersion>
    a sh:PropertyShape ;
    sh:path solid-memo:formatVersion ;
    sh:datatype xsd:integer ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:hasValue 2 ;
    sh:message "Deck format 2 states its format version, 2." .

<#title>
    a sh:PropertyShape ;
    sh:path dcterms:title ;
    sh:datatype xsd:string ;
    sh:minCount 1 ;
    sh:maxCount 1 .

<#created>
    a sh:PropertyShape ;
    sh:path dcterms:created ;
    sh:datatype xsd:dateTime ;
    sh:maxCount 1 .

<#creator>
    a sh:PropertyShape ;
    sh:path dcterms:creator ;
    sh:datatype xsd:string .

<#license>
    a sh:PropertyShape ;
    sh:path dcterms:license ;
    sh:nodeKind sh:IRI ;
    sh:maxCount 1 ;
    sh:message "A licence is an IRI (<https://…>), never a string literal." .

<#description>
    a sh:PropertyShape ;
    sh:path dcterms:description ;
    sh:datatype xsd:string ;
    sh:maxCount 1 .

<#direction>
    a sh:PropertyShape ;
    sh:path solid-memo:direction ;
    sh:datatype xsd:string ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:in ( "front-to-back" "back-to-front" "bidirectional" ) ;
    sh:message "A format-2 deck states its direction: front-to-back, back-to-front or bidirectional." .

<#cardsDocument>
    a sh:PropertyShape ;
    sh:path solid-memo:cardsDocument ;
    sh:nodeKind sh:IRI ;
    sh:minCount 1 ;
    sh:maxCount 1 .

<#reviewsDocument>
    a sh:PropertyShape ;
    sh:path solid-memo:reviewsDocument ;
    sh:nodeKind sh:IRI ;
    sh:minCount 1 ;
    sh:maxCount 1 .

<#source>
    a sh:PropertyShape ;
    sh:path dcterms:source ;
    sh:nodeKind sh:IRI ;
    sh:maxCount 1 ;
    sh:message "In a pod, a deck's source is the one library document it was imported from." .

<#noCardsDocument>
    a sh:PropertyShape ;
    sh:path solid-memo:cardsDocument ;
    sh:maxCount 0 ;
    sh:message "A library deck has no cards document: its cards are in the file." .

<#noReviewsDocument>
    a sh:PropertyShape ;
    sh:path solid-memo:reviewsDocument ;
    sh:maxCount 0 ;
    sh:message "A library deck has no reviews document." .

<#sources>
    a sh:PropertyShape ;
    sh:path dcterms:source ;
    sh:nodeKind sh:IRI ;
    sh:message "A source is an IRI (<https://…>), never a string literal." .
