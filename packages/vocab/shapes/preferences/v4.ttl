@base <https://solid-memo.com/shapes/preferences/v4.ttl> .

@prefix sh:         <http://www.w3.org/ns/shacl#> .
@prefix solid-memo: <https://solid-memo.com/vocab/v1#> .
@prefix xsd:        <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms:    <http://purl.org/dc/terms/> .
@prefix rdfs:       <http://www.w3.org/2000/01/rdf-schema#> .

# Preferences format 4: format 3 plus the scheduler, a concept of
# solid-memo:Schedulers, and the desired retention FSRS schedules for.
<#shape>
    a sh:NodeShape ;
    sh:name "PreferencesV4" ;
    rdfs:comment "Preferences format 4: every field required, the scheduler and the desired retention among them." ;
    sh:nodeKind sh:IRI ;
    sh:class solid-memo:Preferences ;
    sh:property <#formatVersion> ,
                <#newCardsPerDay> ,
                <#maxReviewsPerDay> ,
                <#dayBoundaryHour> ,
                <#answerScale> ,
                <#developerMode> ,
                <#invalidDataPolicy> ,
                <#scheduler> ,
                <#desiredRetention> .

<#formatVersion>
    a sh:PropertyShape ;
    sh:path solid-memo:formatVersion ;
    sh:datatype xsd:integer ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:hasValue 4 ;
    sh:message "Preferences format 4 states its format version, 4."@en ,
               "Inställningsformat 4 anger sin formatversion, 4."@sv .

<#newCardsPerDay>
    a sh:PropertyShape ;
    sh:path solid-memo:newCardsPerDay ;
    sh:datatype xsd:integer ;
    sh:minInclusive 0 ;
    sh:minCount 1 ;
    sh:maxCount 1 .

<#maxReviewsPerDay>
    a sh:PropertyShape ;
    sh:path solid-memo:maxReviewsPerDay ;
    sh:datatype xsd:integer ;
    sh:minInclusive 0 ;
    sh:minCount 1 ;
    sh:maxCount 1 .

<#dayBoundaryHour>
    a sh:PropertyShape ;
    sh:path solid-memo:dayBoundaryHour ;
    sh:datatype xsd:integer ;
    sh:minInclusive 0 ;
    sh:maxInclusive 23 ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:message "The day boundary is an hour of the day, 0 to 23."@en ,
               "Dagens början är en timme på dygnet, 0 till 23."@sv .

<#answerScale>
    a sh:PropertyShape ;
    sh:path solid-memo:answerScale ;
    sh:datatype xsd:string ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:in ( "sm2" "minimal" ) ;
    sh:message "The answer scale is sm2 or minimal."@en ,
               "Svarsskalan är sm2 eller minimal."@sv .

<#developerMode>
    a sh:PropertyShape ;
    sh:path solid-memo:developerMode ;
    sh:datatype xsd:boolean ;
    sh:minCount 1 ;
    sh:maxCount 1 .

<#invalidDataPolicy>
    a sh:PropertyShape ;
    sh:path solid-memo:invalidDataPolicy ;
    sh:nodeKind sh:IRI ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:in ( solid-memo:blockInstance solid-memo:blockSubject solid-memo:warnOnly ) ;
    sh:message "Preferences state what to do with invalid data: a concept of solid-memo:InvalidDataPolicies."@en ,
               "Inställningarna anger vad som ska göras med ogiltig data: ett begrepp i solid-memo:InvalidDataPolicies."@sv .

<#scheduler>
    a sh:PropertyShape ;
    sh:path solid-memo:scheduler ;
    sh:nodeKind sh:IRI ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:in ( solid-memo:sm2 solid-memo:fsrs ) ;
    sh:message "Preferences state which algorithm schedules: a concept of solid-memo:Schedulers."@en ,
               "Inställningarna anger vilken algoritm som schemalägger: ett begrepp i solid-memo:Schedulers."@sv .

<#desiredRetention>
    a sh:PropertyShape ;
    sh:path solid-memo:desiredRetention ;
    sh:datatype xsd:decimal ;
    sh:minInclusive 0.7 ;
    sh:maxInclusive 0.97 ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:message "The desired retention is a decimal from 0.70 to 0.97."@en ,
               "Önskad minnesgrad är ett decimaltal från 0,70 till 0,97."@sv .
