@base <https://solid-memo.com/shapes/card/v3.ttl> .

@prefix sh:         <http://www.w3.org/ns/shacl#> .
@prefix solid-memo: <https://solid-memo.com/vocab/v1#> .
@prefix xsd:        <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms:    <http://purl.org/dc/terms/> .
@prefix rdfs:       <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:        <http://www.w3.org/2002/07/owl#> .

# Card format 3: card format 2, and a card may be retired (owl:deprecated true).
<#shape>
    a sh:NodeShape ;
    sh:name "CardV3" ;
    rdfs:comment "Card format 3: each side has text, a picture or both (a picture is always an IRI); a retired card, which is kept but no longer studied, states owl:deprecated true." ;
    sh:nodeKind sh:IRI ;
    sh:class solid-memo:Card ;
    sh:property <#formatVersion> ,
                <#front> ,
                <#back> ,
                <#frontImage> ,
                <#backImage> ,
                <#created> ,
                <#deprecated> ;
    sh:or ( [ sh:path solid-memo:front ; sh:minCount 1 ] [ sh:path solid-memo:frontImage ; sh:minCount 1 ] ) ,
          ( [ sh:path solid-memo:back ; sh:minCount 1 ] [ sh:path solid-memo:backImage ; sh:minCount 1 ] ) ;
    sh:message "Each side of a card needs text or a picture." .

<#formatVersion>
    a sh:PropertyShape ;
    sh:path solid-memo:formatVersion ;
    sh:datatype xsd:integer ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:hasValue 3 ;
    sh:message "Card format 3 states its format version, 3." .

<#front>
    a sh:PropertyShape ;
    sh:path solid-memo:front ;
    sh:datatype xsd:string ;
    sh:maxCount 1 .

<#back>
    a sh:PropertyShape ;
    sh:path solid-memo:back ;
    sh:datatype xsd:string ;
    sh:maxCount 1 .

<#frontImage>
    a sh:PropertyShape ;
    sh:path solid-memo:frontImage ;
    sh:nodeKind sh:IRI ;
    sh:maxCount 1 ;
    sh:message "A picture is an IRI (<https://…>), never a string literal." .

<#backImage>
    a sh:PropertyShape ;
    sh:path solid-memo:backImage ;
    sh:nodeKind sh:IRI ;
    sh:maxCount 1 ;
    sh:message "A picture is an IRI (<https://…>), never a string literal." .

<#created>
    a sh:PropertyShape ;
    sh:path dcterms:created ;
    sh:datatype xsd:dateTime ;
    sh:maxCount 1 .

<#deprecated>
    a sh:PropertyShape ;
    sh:path owl:deprecated ;
    sh:datatype xsd:boolean ;
    sh:maxCount 1 ;
    sh:message "A retired card states owl:deprecated true, a boolean." .
