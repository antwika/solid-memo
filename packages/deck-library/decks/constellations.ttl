<>
    a solid-memo:Deck ,
      dcat:Dataset ;
    dcterms:title "Constellations"@en ,
                  "Stjärnbilder"@sv ;
    dcterms:creator <#anton-wiklund> ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:description "All 88 constellations recognised by the International Astronomical Union, in 88 cards studied both ways. Front: the constellation's official Latin name; back: its English and Swedish names, with the IAU abbreviation in a note. Names from the IAU's constellation table and Wikidata, checked against NASA, Wikipedia and Nationalencyklopedin. Sources, method and quality control: https://github.com/antwika/solid-memo/blob/main/packages/deck-library/authored/constellations.md"@en ,
                        "Alla 88 stjärnbilder som Internationella astronomiska unionen (IAU) erkänner, på 88 kort som övas åt båda hållen. Framsida: stjärnbildens officiella latinska namn; baksida: dess engelska och svenska namn, med IAU:s förkortning i en anteckning. Namnen kommer från IAU:s tabell över stjärnbilderna och från Wikidata och är kontrollerade mot NASA, Wikipedia och Nationalencyklopedin. Källor, metod och kvalitetskontroll: https://github.com/antwika/solid-memo/blob/main/packages/deck-library/authored/constellations.md"@sv ;
    prov:wasDerivedFrom <https://iauarchive.eso.org/public/themes/constellations/> ,
                        <https://www.wikidata.org/wiki/Wikidata:Main_Page> ;
    prov:wasGeneratedBy <#compilation> ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    dcat:theme <http://publications.europa.eu/resource/authority/data-theme/EDUC> ,
               topic:astronomy ;
    dcat:keyword "constellations" ,
                 "astronomy" ,
                 "IAU" ,
                 "night sky" ,
                 "stars" ,
                 "stjärnbilder" ,
                 "astronomi" ,
                 "stjärnhimlen" ,
                 "stjärnor" ;
    dcterms:language <http://publications.europa.eu/resource/authority/language/ENG> ,
                     <http://publications.europa.eu/resource/authority/language/SWE> ,
                     <http://publications.europa.eu/resource/authority/language/LAT> ;
    solid-memo:studyDirection solid-memo:bidirectional ;
    solid-memo:formatVersion 4 .

