# How this deck was made (W3C PROV-O): researched card by card from the sources below,
# each card checked against at least two of them. The full record is the provenance report.
<#compilation>
    a prov:Activity ;
    prov:endedAtTime "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    prov:used <https://iauarchive.eso.org/public/themes/constellations/> ,
              <https://www.wikidata.org/wiki/Wikidata:Main_Page> ,
              <https://asd.gsfc.nasa.gov/archive/ircatalog/constel_names.html> ,
              <https://sv.wikipedia.org/wiki/Stj%C3%A4rnbild> ,
              <https://en.wikipedia.org/wiki/IAU_designated_constellations> ,
              <https://en.wikipedia.org/wiki/Category:Constellations> ,
              <https://www.ne.se/uppslagsverk/encyklopedi/> ;
    prov:wasAssociatedWith <#anton-wiklund> ,
                           <https://github.com/antwika/solid-memo/blob/main/packages/deck-library/scripts/authored_decks.py> ;
    rdfs:seeAlso <https://github.com/antwika/solid-memo/blob/main/packages/deck-library/authored/constellations.md> ;
    rdfs:comment "Compiled from the dossier authored/constellations.json, which records every source, the method, the quality-control rounds and the evidence for each card; built with python3 packages/deck-library/scripts/authored_decks.py build constellations." .

<https://github.com/antwika/solid-memo/blob/main/packages/deck-library/scripts/authored_decks.py>
