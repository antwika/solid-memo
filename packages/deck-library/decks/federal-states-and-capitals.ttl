<>
    a solid-memo:Deck ,
      dcat:Dataset ;
    dcterms:title "States and capitals: Germany, Austria, Canada, Australia"@en ,
                  "Delstater och huvudstäder: Tyskland, Österrike, Kanada, Australien"@sv ;
    dcterms:creator <#anton-wiklund> ;
    dcterms:license <https://creativecommons.org/publicdomain/zero/1.0/> ;
    dcterms:description "The constituent states of four federations and their capitals, as of October 2026: Germany's 16 and Austria's 9 states, Canada's 10 provinces and 3 territories, and Australia's 6 states and 2 self-governing mainland territories, 46 cards. Front: the state, province or territory, e.g. \"Bavaria\" (Swedish \"Bayern\"), with its country in a note; back: its capital, e.g. \"Munich\" (\"München\"). For Berlin, Hamburg and Vienna, cities that are themselves states, the answer is the city itself. Taken from Wikidata and checked against official sites of each country, the Swedish Wikipedia and Nationalencyklopedin. Sources, method and quality control: https://github.com/antwika/solid-memo/blob/main/packages/deck-library/authored/federal-states-and-capitals.md"@en ,
                        "Delstaterna i fyra förbundsstater och deras huvudstäder, enligt läget i oktober 2026: Tysklands 16 och Österrikes 9 förbundsländer, Kanadas 10 provinser och 3 territorier samt Australiens 6 delstater och 2 självstyrande fastlandsterritorier, 46 kort. Framsida: delstaten, provinsen eller territoriet, t.ex. ”Bayern”, med landet i en anteckning; baksida: huvudstaden, t.ex. ”München”. För Berlin, Hamburg och Wien, städer som själva är förbundsländer, är svaret staden själv. Uppgifterna är hämtade från Wikidata och kontrollerade mot officiella webbplatser i varje land, svenskspråkiga Wikipedia och Nationalencyklopedin. Källor, metod och kvalitetskontroll: https://github.com/antwika/solid-memo/blob/main/packages/deck-library/authored/federal-states-and-capitals.md"@sv ;
    prov:wasDerivedFrom <https://www.wikidata.org/wiki/Q1221156> ;
    prov:wasGeneratedBy <#compilation> ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    dcat:theme <http://publications.europa.eu/resource/authority/data-theme/EDUC> ,
               topic:geography ;
    dcat:keyword "federal states"@en ,
                 "capitals"@en ,
                 "Germany"@en ,
                 "Austria"@en ,
                 "Canada"@en ,
                 "Australia"@en ,
                 "delstater"@sv ,
                 "huvudstäder"@sv ,
                 "Tyskland"@sv ,
                 "Österrike"@sv ,
                 "Kanada"@sv ,
                 "Australien"@sv ;
    dcterms:language <http://publications.europa.eu/resource/authority/language/ENG> ,
                     <http://publications.europa.eu/resource/authority/language/SWE> ;
    solid-memo:studyDirection solid-memo:frontToBack ;
    solid-memo:formatVersion 5 .

