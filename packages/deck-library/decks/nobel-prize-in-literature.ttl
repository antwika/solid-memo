<>
    a solid-memo:Deck ,
      dcat:Dataset ;
    dcterms:title "Nobel Prize in Literature"@en ,
                  "Nobelpriset i litteratur"@sv ;
    dcterms:creator <#anton-wiklund> ;
    dcterms:license <https://creativecommons.org/publicdomain/zero/1.0/> ;
    dcterms:description "Every Nobel Prize in Literature from 1901 to 2025, one card per prize year: 118 cards with the year on the front and the laureate or laureates on the back, and a note on the language they wrote in (from Wikidata, checked against NobelPrize.org). Years with no award are left out; the deck ends with the 2025 prize, as the 2026 prize had not been announced when the deck was made on 4 October 2026. From the Nobel Prize API and Wikidata. Not affiliated with or endorsed by the Nobel Foundation. Sources, method and quality control: https://github.com/antwika/solid-memo/blob/main/packages/deck-library/authored/nobel-prize-in-literature.md"@en ,
                        "Varje Nobelpris i litteratur från 1901 till 2025, ett kort per prisår: 118 kort med året på framsidan och pristagaren eller pristagarna på baksidan, och en anteckning om vilket språk de skrev på (från Wikidata, kontrollerad mot NobelPrize.org). År då priset inte delades ut är utelämnade; kortleken slutar med 2025 års pris, eftersom 2026 års pris inte var tillkännagivet när kortleken gjordes den 4 oktober 2026. Från Nobelprisets API och Wikidata. Inte knuten till eller godkänd av Nobelstiftelsen. Källor, metod och kvalitetskontroll: https://github.com/antwika/solid-memo/blob/main/packages/deck-library/authored/nobel-prize-in-literature.md"@sv ;
    prov:wasDerivedFrom <https://api.nobelprize.org/2.1/> ,
                        <https://www.wikidata.org/wiki/Q37922> ,
                        <https://www.cia.gov/legacy/museum/artifact/miniature-volume-of-pasternaks-doctor-zhivago/> ;
    prov:wasGeneratedBy <#compilation> ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    dcat:theme <http://publications.europa.eu/resource/authority/data-theme/EDUC> ,
               topic:literature ;
    dcat:keyword "Nobel Prize in Literature"@en ,
                 "Nobel laureates"@en ,
                 "literature"@en ,
                 "authors"@en ,
                 "Nobelpriset i litteratur"@sv ,
                 "nobelpristagare"@sv ,
                 "litteratur"@sv ,
                 "författare"@sv ;
    dcterms:language <http://publications.europa.eu/resource/authority/language/ENG> ,
                     <http://publications.europa.eu/resource/authority/language/SWE> ;
    solid-memo:studyDirection solid-memo:bidirectional ;
    solid-memo:formatVersion 5 .

<#anton-wiklund>
    a foaf:Agent ;
    foaf:name "Anton Wiklund" ;
    foaf:mbox <mailto:antonwiklund91@gmail.com> .

<https://creativecommons.org/publicdomain/zero/1.0/>
    a dcterms:LicenseDocument .

# How this deck was made (W3C PROV-O): researched card by card from the sources below,
# each card checked against at least two of them. The full record is the provenance report.
<#compilation>
    a prov:Activity ;
    prov:endedAtTime "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    prov:used <https://api.nobelprize.org/2.1/> ,
              <https://www.wikidata.org/wiki/Q37922> ,
              <https://www.nobelprize.org/prizes/lists/all-nobel-prizes-in-literature/> ,
              <https://www.cia.gov/legacy/museum/artifact/miniature-volume-of-pasternaks-doctor-zhivago/> ;
    prov:wasAssociatedWith <#anton-wiklund> ,
                           <https://github.com/antwika/solid-memo/blob/main/packages/deck-library/scripts/authored_decks.py> ;
    rdfs:seeAlso <https://github.com/antwika/solid-memo/blob/main/packages/deck-library/authored/nobel-prize-in-literature.md> ;
    rdfs:comment "Compiled from the dossier authored/nobel-prize-in-literature.json, which records every source, the method, the quality-control rounds and the evidence for each card; built with python3 packages/deck-library/scripts/authored_decks.py build nobel-prize-in-literature." .

<https://github.com/antwika/solid-memo/blob/main/packages/deck-library/scripts/authored_decks.py>
    a prov:SoftwareAgent ;
    dcterms:title "authored_decks.py" .

<https://api.nobelprize.org/2.1/>
    dcterms:title "Nobel Prize API 2.1 (api.nobelprize.org): Nobel Prizes and laureates in literature (nobelPrizes and laureate endpoints)" ;
    dcterms:creator "Nobel Prize Outreach" ;
    dcterms:license <https://creativecommons.org/publicdomain/zero/1.0/> .

<https://www.wikidata.org/wiki/Q37922>
