<>
    a solid-memo:Deck ,
      dcat:Dataset ;
    dcterms:title "World currencies"@en ,
                  "Världens valutor"@sv ;
    dcterms:creator <#anton-wiklund> ;
    dcterms:license <https://creativecommons.org/publicdomain/zero/1.0/> ;
    dcterms:description "The currency of each of the 193 UN member states, with its ISO 4217 code: 193 cards with a country on the front and its currency on the back, in English and Swedish, such as Sweden → Swedish krona (SEK). Compiled from Wikidata and checked against the ISO 4217 lists of the maintenance agency SIX and the EU Interinstitutional Style Guide. Sources, method and quality control: https://github.com/antwika/solid-memo/blob/main/packages/deck-library/authored/world-currencies.md"@en ,
                        "Valutan i vart och ett av FN:s 193 medlemsländer, med sin ISO 4217-kod: 193 kort med ett land på framsidan och dess valuta på baksidan, på engelska och svenska, till exempel Sverige → svensk krona (SEK). Sammanställd från Wikidata och kontrollerad mot ISO 4217-listorna från förvaltaren SIX och EU:s interinstitutionella publikationshandbok. Källor, metod och kvalitetskontroll: https://github.com/antwika/solid-memo/blob/main/packages/deck-library/authored/world-currencies.md"@sv ;
    prov:wasDerivedFrom <https://www.wikidata.org/> ;
    prov:wasGeneratedBy <#compilation> ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    dcat:theme <http://publications.europa.eu/resource/authority/data-theme/EDUC> ,
               topic:geography ,
               topic:economics ;
    dcat:keyword "currencies"@en ,
                 "ISO 4217"@en ,
                 "countries"@en ,
                 "money"@en ,
                 "geography"@en ,
                 "valutor"@sv ,
                 "valutakoder"@sv ,
                 "länder"@sv ,
                 "pengar"@sv ,
                 "geografi"@sv ,
                 "ISO 4217"@sv ;
    dcterms:language <http://publications.europa.eu/resource/authority/language/ENG> ,
                     <http://publications.europa.eu/resource/authority/language/SWE> ;
    solid-memo:studyDirection solid-memo:frontToBack ;
    solid-memo:formatVersion 5 .

