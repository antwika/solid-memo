<>
    a solid-memo:Deck ,
      dcat:Dataset ;
    dcterms:title "Italian musical terms"@en ,
                  "Italienska musiktermer"@sv ;
    dcterms:creator <#anton-wiklund> ;
    dcterms:license <https://creativecommons.org/publicdomain/zero/1.0/> ;
    dcterms:description "61 Italian terms from sheet music for tempo, dynamics, articulation and expression, from adagio and allegro to crescendo, staccato and dolce. The Italian term on the front, with its usual abbreviation where it has one; what it asks of the performer on the back, in English and Swedish, in our own words. Tempo terms describe a character, not a metronome figure. Checked against Theodore Baker's Dictionary of Musical Terms (1904), in the public domain, and Karl Gehrkens' Music Notation and Terminology (1914), in the public domain in the United States, with Wiktionary and Svensk ordbok. Sources, method and quality control: https://github.com/antwika/solid-memo/blob/main/packages/deck-library/authored/musical-terms.md"@en ,
                        "61 italienska termer ur notblad för tempo, dynamik, artikulation och uttryck, från adagio och allegro till crescendo, staccato och dolce. Den italienska termen på framsidan, med sin vanliga förkortning om den har någon; vad den ber musikern om på baksidan, på engelska och svenska, med egna ord. Tempotermerna beskriver en karaktär, inte en metronomsiffra. Kontrollerade mot Theodore Bakers Dictionary of Musical Terms (1904), fri från upphovsrätt, och Karl Gehrkens Music Notation and Terminology (1914), fri från upphovsrätt i USA, samt Wiktionary och Svensk ordbok. Källor, metod och kvalitetskontroll: https://github.com/antwika/solid-memo/blob/main/packages/deck-library/authored/musical-terms.md"@sv ;
    prov:wasDerivedFrom <https://archive.org/details/cu31924017810106> ,
                        <https://www.gutenberg.org/ebooks/19499> ;
    prov:wasGeneratedBy <#compilation> ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    dcat:theme <http://publications.europa.eu/resource/authority/data-theme/EDUC> ,
               topic:music ,
               topic:languages ;
    dcat:keyword "music"@en ,
                 "musical terms"@en ,
                 "Italian"@en ,
                 "tempo"@en ,
                 "dynamics"@en ,
                 "articulation"@en ,
                 "musik"@sv ,
                 "musiktermer"@sv ,
                 "italienska"@sv ,
                 "dynamik"@sv ,
                 "artikulation"@sv ,
                 "tempo"@sv ;
    dcterms:language <http://publications.europa.eu/resource/authority/language/ENG> ,
                     <http://publications.europa.eu/resource/authority/language/SWE> ,
                     <http://publications.europa.eu/resource/authority/language/ITA> ;
    solid-memo:studyDirection solid-memo:frontToBack ;
    solid-memo:formatVersion 5 .

