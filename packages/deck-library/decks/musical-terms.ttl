<#grave>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "grave"@it ;
    solid-memo:back "Very slow and solemn"@en ,
                    "Mycket långsamt och allvarligt"@sv .

<#largo>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "largo"@it ;
    solid-memo:back "Slow and broad"@en ,
                    "Långsamt och brett"@sv ;
    solid-memo:backNote "Literally ‘broad’."@en ,
                        "Ordagrant ’bred’."@sv .

<#larghetto>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "larghetto"@it ;
    solid-memo:back "Fairly slow; a little less slow than largo"@en ,
                    "Ganska långsamt; något mindre långsamt än largo"@sv .

<#adagio>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "adagio"@it ;
    solid-memo:back "Slow and at ease"@en ,
                    "Långsamt och lugnt"@sv ;
    solid-memo:backNote "Literally ‘at ease’."@en ,
                        "Ordagrant ’i lugn och ro’."@sv .

<#lento>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "lento"@it ;
    solid-memo:back "Slow"@en ,
                    "Långsamt"@sv .

<#andante>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "andante"@it ;
    solid-memo:back "At a walking pace, moderately slow"@en ,
                    "I gångtakt, måttligt långsamt"@sv ;
    solid-memo:backNote "Literally ‘going, walking’."@en ,
                        "Ordagrant ’gående’."@sv .

<#moderato>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "moderato"@it ;
    solid-memo:back "At a moderate speed"@en ,
                    "I måttligt tempo"@sv .

<#allegretto>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "allegretto"@it ;
    solid-memo:back "Moderately fast; a little less fast than allegro"@en ,
                    "Ganska snabbt; något mindre snabbt än allegro"@sv .

<#allegro>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "allegro"@it ;
    solid-memo:back "Fast and lively"@en ,
                    "Snabbt och livligt"@sv ;
    solid-memo:backNote "Literally ‘cheerful’."@en ,
                        "Ordagrant ’glad’."@sv .

<#vivace>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "vivace"@it ;
    solid-memo:back "Lively and brisk, at least as fast as allegro"@en ,
                    "Livligt och rappt, minst lika snabbt som allegro"@sv .

<#presto>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "presto"@it ;
    solid-memo:back "Very fast"@en ,
                    "Mycket snabbt"@sv .

<#prestissimo>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "prestissimo"@it ;
    solid-memo:back "As fast as possible"@en ,
                    "Så snabbt som möjligt"@sv .

<#accelerando>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "accelerando"@it ;
    solid-memo:frontNote "Abbreviation: accel."@en ,
                         "Förkortning: accel."@sv ;
    solid-memo:back "Gradually getting faster"@en ,
                    "Gradvis allt snabbare"@sv .

<#ritardando>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "ritardando"@it ;
    solid-memo:frontNote "Abbreviation: ritard., rit."@en ,
                         "Förkortning: ritard., rit."@sv ;
    solid-memo:back "Gradually getting slower"@en ,
                    "Gradvis allt långsammare"@sv ;
    solid-memo:backNote "rit. can also stand for ritenuto (held back)."@en ,
                        "rit. kan också stå för ritenuto (återhållet)."@sv .

<#rallentando>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "rallentando"@it ;
    solid-memo:frontNote "Abbreviation: rall."@en ,
                         "Förkortning: rall."@sv ;
    solid-memo:back "Gradually slowing down"@en ,
                    "Gradvis saktare"@sv ;
    solid-memo:backNote "Means the same as ritardando."@en ,
                        "Betyder samma sak som ritardando."@sv .

<#allargando>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "allargando"@it ;
    solid-memo:back "Broadening: slower, and usually fuller in tone"@en ,
                    "Breddande: långsammare och oftast fylligare i tonen"@sv .

<#a-tempo>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "a tempo"@it ;
    solid-memo:back "Back to the normal tempo after a change"@en ,
                    "Tillbaka till grundtempot efter en ändring"@sv ;
    solid-memo:backNote "Tempo primo is used in the same way."@en ,
                        "Tempo primo används på samma sätt."@sv .

<#tempo-primo>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "tempo primo"@it ;
    solid-memo:frontNote "Also written: Tempo I"@en ,
                         "Skrivs även: Tempo I"@sv ;
    solid-memo:back "Back to the original tempo"@en ,
                    "Tillbaka till det ursprungliga tempot"@sv ;
    solid-memo:backNote "Literally ‘first tempo’. A tempo is used in the same way."@en ,
                        "Ordagrant ’första tempot’. A tempo används på samma sätt."@sv .

<#rubato>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "rubato"@it ;
    solid-memo:back "Flexible tempo: time taken from some notes and given to others"@en ,
                    "Fritt tempo: tid tas från vissa toner och ges till andra"@sv ;
    solid-memo:backNote "Short for tempo rubato, literally ‘robbed time’."@en ,
                        "Kortform av tempo rubato, ordagrant ’stulen tid’."@sv .

<#meno-mosso>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "meno mosso"@it ;
    solid-memo:back "Less motion: immediately slower"@en ,
                    "Mindre rörelse: genast långsammare"@sv .

<#piu-mosso>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "più mosso"@it ;
    solid-memo:back "More motion: immediately faster"@en ,
                    "Mer rörelse: genast snabbare"@sv .

