<#pwd>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Print the full path of the directory you are in"@en ,
                     "Skriv ut den fullständiga sökvägen till katalogen du står i"@sv ;
    solid-memo:back "pwd"@zxx .

<#cd-home>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Go to your home directory"@en ,
                     "Gå till din hemkatalog"@sv ;
    solid-memo:back "cd"@zxx ;
    solid-memo:backNote "cd ~ does the same: the shell replaces ~ with your home directory."@en ,
                        "cd ~ gör samma sak: skalet ersätter ~ med din hemkatalog."@sv .

<#cd-parent>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Move up to the parent of the current directory"@en ,
                     "Gå upp till den aktuella katalogens föräldrakatalog"@sv ;
    solid-memo:back "cd .."@zxx .

<#cd-previous>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Go back to the directory you were in before the last change of directory"@en ,
                     "Gå tillbaka till katalogen du var i före det senaste katalogbytet"@sv ;
    solid-memo:back "cd -"@zxx ;
    solid-memo:backNote "cd - also prints the directory it changes to."@en ,
                        "cd - skriver också ut katalogen som den byter till."@sv .

<#ls-all>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "List all files in the current directory, including hidden ones"@en ,
                     "Lista alla filer i aktuell katalog, även dolda"@sv ;
    solid-memo:back "ls -a"@zxx ;
    solid-memo:backNote "Hidden files are those whose names begin with a dot. ls -A shows them too but leaves out the entries . and .."@en ,
                        "Dolda filer är de vars namn börjar med punkt. ls -A visar dem också men utelämnar posterna . och .."@sv .

<#ls-long>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "List the files in the current directory in long format, with permissions, owner, size and modification time"@en ,
                     "Lista filerna i aktuell katalog i långt format, med rättigheter, ägare, storlek och ändringstid"@sv ;
    solid-memo:back "ls -l"@zxx .

<#ls-time>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "List the files in the current directory in long format, most recently modified first"@en ,
                     "Lista filerna i aktuell katalog i långt format, de senast ändrade först"@sv ;
    solid-memo:back "ls -lt"@zxx .

<#mkdir>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Create a new directory"@en ,
                     "Skapa en ny katalog"@sv ;
    solid-memo:back "mkdir <dir>"@zxx .

<#mkdir-parents>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Create a directory, along with any parent directories in its path that do not exist yet"@en ,
                     "Skapa en katalog, tillsammans med de föräldrakataloger i sökvägen som inte finns ännu"@sv ;
    solid-memo:back "mkdir -p <path>"@zxx ;
    solid-memo:backNote "Without -p, mkdir fails when a parent directory is missing."@en ,
                        "Utan -p misslyckas mkdir när en föräldrakatalog saknas."@sv .

<#rmdir>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Remove an empty directory"@en ,
                     "Ta bort en tom katalog"@sv ;
    solid-memo:back "rmdir <dir>"@zxx ;
    solid-memo:backNote "rmdir refuses to remove a directory that is not empty."@en ,
                        "rmdir vägrar ta bort en katalog som inte är tom."@sv .

<#rm>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Delete a file"@en ,
                     "Ta bort en fil"@sv ;
    solid-memo:back "rm <file>"@zxx .

<#rm-recursive>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Delete a directory together with everything in it"@en ,
                     "Ta bort en katalog tillsammans med allt dess innehåll"@sv ;
    solid-memo:back "rm -r <dir>"@zxx ;
    solid-memo:backNote "-R is the same. rm -rf also skips the prompt for write-protected files and stays silent about missing names; use it with care."@en ,
                        "-R är detsamma. rm -rf hoppar dessutom över frågan för skrivskyddade filer och tiger om namn som saknas; använd det med försiktighet."@sv .

<#cp>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Copy a file"@en ,
                     "Kopiera en fil"@sv ;
    solid-memo:back "cp <source> <target>"@zxx .

<#cp-recursive>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Copy a directory together with everything in it"@en ,
                     "Kopiera en katalog tillsammans med allt dess innehåll"@sv ;
    solid-memo:back "cp -R <source> <target>"@zxx ;
    solid-memo:backNote "POSIX specifies -R; GNU cp also accepts -r, as BSD systems historically did."@en ,
                        "POSIX anger -R; GNU:s cp godtar också -r, liksom BSD-system traditionellt har gjort."@sv .

<#mv-rename>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Rename a file"@en ,
                     "Byt namn på en fil"@sv ;
    solid-memo:back "mv <old> <new>"@zxx ;
    solid-memo:backNote "If <new> is an existing directory, the file is moved into it instead."@en ,
                        "Om <new> är en befintlig katalog flyttas filen in i den i stället."@sv .

<#touch>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Create an empty file, or update the timestamps of a file that already exists"@en ,
                     "Skapa en tom fil, eller uppdatera tidsstämplarna för en fil som redan finns"@sv ;
    solid-memo:back "touch <file>"@zxx .

<#ln-symbolic>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Create a symbolic link that points to a file"@en ,
                     "Skapa en symbolisk länk som pekar på en fil"@sv ;
    solid-memo:back "ln -s <target> <link>"@zxx ;
    solid-memo:backNote "First what the link points to, then the name of the new link. A relative target is resolved from the link's directory, not from the current one."@en ,
                        "Först det länken pekar på, sedan namnet på den nya länken. Ett relativt mål tolkas från länkens katalog, inte från den aktuella."@sv .

<#cat>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Print the whole contents of a file to the terminal"@en ,
                     "Skriv ut hela innehållet i en fil i terminalen"@sv ;
    solid-memo:back "cat <file>"@zxx .

<#head-20>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Show the first 20 lines of a file"@en ,
                     "Visa de 20 första raderna i en fil"@sv ;
    solid-memo:back "head -n 20 <file>"@zxx ;
    solid-memo:backNote "Without -n, head shows the first 10 lines."@en ,
                        "Utan -n visar head de 10 första raderna."@sv .

<#tail-20>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Show the last 20 lines of a file"@en ,
                     "Visa de 20 sista raderna i en fil"@sv ;
    solid-memo:back "tail -n 20 <file>"@zxx ;
    solid-memo:backNote "Without -n, tail shows the last 10 lines."@en ,
                        "Utan -n visar tail de 10 sista raderna."@sv .

<#tail-follow>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Show the end of a file and keep printing new lines as they are added to it"@en ,
                     "Visa slutet av en fil och fortsätt skriva ut nya rader när de läggs till"@sv ;
    solid-memo:back "tail -f <file>"@zxx .

<#wc-lines>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Count the lines in a file"@en ,
                     "Räkna raderna i en fil"@sv ;
    solid-memo:back "wc -l <file>"@zxx ;
    solid-memo:backNote "Strictly, wc -l counts newline characters, so a last line without a newline is not counted."@en ,
                        "Strikt taget räknar wc -l radbrytningstecken, så en sista rad utan radbrytning räknas inte."@sv .

<#diff>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Show the line-by-line differences between two files"@en ,
                     "Visa skillnaderna rad för rad mellan två filer"@sv ;
    solid-memo:back "diff <file1> <file2>"@zxx .

<#sort>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Print the lines of a file in sorted order"@en ,
                     "Skriv ut raderna i en fil i sorterad ordning"@sv ;
    solid-memo:back "sort <file>"@zxx .

<#grep>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Print the lines of a file that match a pattern"@en ,
                     "Skriv ut de rader i en fil som matchar ett mönster"@sv ;
    solid-memo:back "grep <pattern> <file>"@zxx ;
    solid-memo:backNote "The pattern is a basic regular expression; quote it if it contains spaces or special characters."@en ,
                        "Mönstret är ett grundläggande reguljärt uttryck; sätt det inom citattecken om det innehåller blanksteg eller specialtecken."@sv .

<#grep-i>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Print the lines of a file that match a pattern, ignoring the difference between upper and lower case"@en ,
                     "Skriv ut de rader i en fil som matchar ett mönster, utan att skilja på versaler och gemener"@sv ;
    solid-memo:back "grep -i <pattern> <file>"@zxx .

<#grep-v>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Print the lines of a file that do not match a pattern"@en ,
                     "Skriv ut de rader i en fil som inte matchar ett mönster"@sv ;
    solid-memo:back "grep -v <pattern> <file>"@zxx .

<#grep-n>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Print the lines of a file that match a pattern, each preceded by its line number"@en ,
                     "Skriv ut de rader i en fil som matchar ett mönster, var och en med sitt radnummer först"@sv ;
    solid-memo:back "grep -n <pattern> <file>"@zxx .

<#grep-r>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Search all files in a directory and its subdirectories, recursively, for a pattern"@en ,
                     "Sök rekursivt efter ett mönster i alla filer i en katalog och dess underkataloger"@sv ;
    solid-memo:back "grep -r <pattern> <dir>"@zxx ;
    solid-memo:backNote "Not in POSIX (GNU grep has it). A portable equivalent: find <dir> -type f -exec grep <pattern> /dev/null {} +"@en ,
                        "Finns inte i POSIX (GNU grep har den). Portabel motsvarighet: find <dir> -type f -exec grep <pattern> /dev/null {} +"@sv .

<#find-name>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Find all files whose names end in .txt in the current directory and all its subdirectories"@en ,
                     "Hitta alla filer vars namn slutar på .txt i aktuell katalog och alla dess underkataloger"@sv ;
    solid-memo:back "find . -name '*.txt'"@zxx ;
    solid-memo:backNote "Quote the pattern so that find, not the shell, matches it: an unquoted *.txt is replaced by matching names in the current directory before find runs."@en ,
                        "Sätt mönstret inom citattecken så att find och inte skalet matchar det: utan citattecken ersätts *.txt av matchande namn i aktuell katalog innan find körs."@sv .

<#find-dirs>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "List the current directory and all directories below it, at every depth"@en ,
                     "Lista aktuell katalog och alla kataloger under den, på alla nivåer"@sv ;
    solid-memo:back "find . -type d"@zxx ;
    solid-memo:backNote "The current directory comes first in the list, written as a dot."@en ,
                        "Den aktuella katalogen kommer först i listan, skriven som en punkt."@sv .

<#chmod-x>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Make a file executable"@en ,
                     "Gör en fil körbar"@sv ;
    solid-memo:back "chmod +x <file>"@zxx ;
    solid-memo:backNote "Without u, g, o or a, chmod leaves out the bits your umask masks; chmod a+x gives everyone execute permission regardless."@en ,
                        "Utan u, g, o eller a hoppar chmod över de bitar som din umask maskerar; chmod a+x ger alla körrättighet oavsett umask."@sv .

<#chmod-644>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Using an octal number, give a file read and write permission for its owner and read-only permission for everyone else"@en ,
                     "Använd ett oktalt tal för att ge en fil läs- och skrivrättighet för ägaren och enbart läsrättighet för alla andra"@sv ;
    solid-memo:back "chmod 644 <file>"@zxx ;
    solid-memo:backNote "The digits are for owner, group and others; 6 = read (4) + write (2), 4 = read."@en ,
                        "Siffrorna gäller ägare, grupp och övriga; 6 = läsa (4) + skriva (2), 4 = läsa."@sv .

<#chown>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Change the owner of a file"@en ,
                     "Byt ägare på en fil"@sv ;
    solid-memo:back "chown <user> <file>"@zxx ;
    solid-memo:backNote "Giving a file to another user usually requires superuser (root) privileges."@en ,
                        "Att ge en fil till en annan användare kräver oftast superanvändarbehörighet (root)."@sv .

<#ps-ef>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "List every process running on the system, in full format"@en ,
                     "Lista alla processer som körs på systemet, i fullständigt format"@sv ;
    solid-memo:back "ps -ef"@zxx ;
    solid-memo:backNote "ps itself, like -e and -f, is in POSIX's XSI option group. The BSD-style ps aux gives a similar list; the procps ps on Linux accepts both."@en ,
                        "ps självt hör, liksom -e och -f, till POSIX:s XSI-tillägg. Den BSD-liknande formen ps aux ger en liknande lista; procps ps på Linux godtar båda."@sv .

<#kill>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Ask a process to terminate, given its process ID"@en ,
                     "Be en process att avsluta sig, med hjälp av dess process-id"@sv ;
    solid-memo:back "kill <pid>"@zxx ;
    solid-memo:backNote "Sends SIGTERM, which a process can catch or ignore."@en ,
                        "Skickar SIGTERM, som en process kan fånga eller ignorera."@sv .

<#kill-9>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Force a process to stop immediately with a signal it cannot catch or ignore, given its process ID"@en ,
                     "Tvinga en process att avslutas omedelbart med en signal som den inte kan fånga eller ignorera, med hjälp av dess process-id"@sv ;
    solid-memo:back "kill -9 <pid>"@zxx ;
    solid-memo:backNote "9 is SIGKILL. The numeric form is an XSI option; kill -s KILL <pid> does the same on every POSIX system."@en ,
                        "9 är SIGKILL. Den numeriska formen är ett XSI-tillägg; kill -s KILL <pid> gör samma sak på alla POSIX-system."@sv .

<#background>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Start a command in the background, so that the shell is ready for the next command at once"@en ,
                     "Starta ett kommando i bakgrunden, så att skalet genast är redo för nästa kommando"@sv ;
    solid-memo:back "<command> &"@zxx .

<#jobs>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "List the background jobs started from the current shell"@en ,
                     "Lista bakgrundsjobben som startats från det aktuella skalet"@sv ;
    solid-memo:back "jobs"@zxx .

<#fg>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Bring the most recent background job back to the foreground"@en ,
                     "Ta tillbaka det senaste bakgrundsjobbet till förgrunden"@sv ;
    solid-memo:back "fg"@zxx .

<#tar-create>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Pack a directory into a gzip-compressed tar archive"@en ,
                     "Packa ihop en katalog till ett gzip-komprimerat tar-arkiv"@sv ;
    solid-memo:back "tar -czf <archive>.tar.gz <dir>"@zxx ;
    solid-memo:backNote "c = create, z = gzip, f = archive file name, which must follow straight after. tar is not in POSIX (which specifies pax); these are GNU tar's options."@en ,
                        "c = skapa, z = gzip, f = arkivets filnamn, som måste följa direkt efter. tar finns inte i POSIX (som anger pax); flaggorna är GNU tar:s."@sv .

<#tar-extract>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Unpack a gzip-compressed tar archive into the current directory"@en ,
                     "Packa upp ett gzip-komprimerat tar-arkiv i aktuell katalog"@sv ;
    solid-memo:back "tar -xzf <archive>.tar.gz"@zxx ;
    solid-memo:backNote "GNU tar recognizes the compression by itself when reading, so tar -xf <archive>.tar.gz works too."@en ,
                        "GNU tar känner själv igen komprimeringen vid läsning, så tar -xf <archive>.tar.gz fungerar också."@sv .

<#redirect-out>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Write a command's output to a file, replacing whatever the file contained"@en ,
                     "Skriv ett kommandos utdata till en fil och ersätt det som fanns i filen"@sv ;
    solid-memo:back "<command> > <file>"@zxx .

<#redirect-append>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Add a command's output to the end of a file"@en ,
                     "Lägg till ett kommandos utdata i slutet av en fil"@sv ;
    solid-memo:back "<command> >> <file>"@zxx .

<#redirect-stderr>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Write a command's error messages to a file"@en ,
                     "Skriv ett kommandos felmeddelanden till en fil"@sv ;
    solid-memo:back "<command> 2> <file>"@zxx ;
    solid-memo:backNote "2 is file descriptor 2, standard error (stderr)."@en ,
                        "2 är fildeskriptor 2, standard error (stderr)."@sv .

<#redirect-both>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Write both a command's output and its error messages to the same file"@en ,
                     "Skriv både ett kommandos utdata och dess felmeddelanden till samma fil"@sv ;
    solid-memo:back "<command> > <file> 2>&1"@zxx ;
    solid-memo:backNote "Order matters: 2>&1 must come after > <file>. Bash also accepts &> <file>, which is not POSIX: dash runs the command in the background and leaves the file empty."@en ,
                        "Ordningen spelar roll: 2>&1 måste stå efter > <file>. Bash godtar också &> <file>, som inte är POSIX: dash kör då kommandot i bakgrunden och lämnar filen tom."@sv .

<#pipe>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Use one command's output as the input of another command"@en ,
                     "Använd ett kommandos utdata som indata till ett annat kommando"@sv ;
    solid-memo:back "<command1> | <command2>"@zxx .

<#tee>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Show a command's output on the screen and save it to a file at the same time"@en ,
                     "Visa ett kommandos utdata på skärmen och spara det i en fil samtidigt"@sv ;
    solid-memo:back "<command> | tee <file>"@zxx ;
    solid-memo:backNote "tee -a appends to the file instead of replacing its contents."@en ,
                        "tee -a lägger till i filen i stället för att ersätta innehållet."@sv .

<#df-h>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Show the size, used and free space of the mounted file systems, in human-readable units"@en ,
                     "Visa storlek, använt och ledigt utrymme för de monterade filsystemen, i lättlästa enheter"@sv ;
    solid-memo:back "df -h"@zxx ;
    solid-memo:backNote "-h is not in POSIX (GNU df has it), and df itself is in POSIX's XSI option group, with -k (1024-byte units) and -P (portable output format). GNU df leaves out pseudo file systems such as /proc unless -a is given."@en ,
                        "-h finns inte i POSIX (GNU df har den), och df hör självt till POSIX:s XSI-tillägg, med -k (enheter om 1024 byte) och -P (portabelt utdataformat). GNU df utelämnar pseudofilsystem som /proc om inte -a anges."@sv .

<#du-sh>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Show the total disk space used by a directory, in human-readable units"@en ,
                     "Visa det totala diskutrymme som en katalog använder, i lättlästa enheter"@sv ;
    solid-memo:back "du -sh <dir>"@zxx ;
    solid-memo:backNote "-s gives one total; -h is not in POSIX (GNU du has it). Portable: du -sk <dir> gives the total in kibibytes."@en ,
                        "-s ger en enda summa; -h finns inte i POSIX (GNU du har den). Portabelt: du -sk <dir> ger summan i kibibyte."@sv .

<#ping>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Check whether a host answers on the network, sending exactly 4 echo requests"@en ,
                     "Kontrollera om en värd svarar i nätverket genom att skicka exakt 4 ekoförfrågningar"@sv ;
    solid-memo:back "ping -c 4 <host>"@zxx ;
    solid-memo:backNote "ping is not a POSIX utility; this is the Linux (iputils) ping."@en ,
                        "ping är inget POSIX-verktyg; detta är Linux-varianten (iputils)."@sv .

<#curl-o>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Download a file with curl into the current directory, keeping the file name from the URL"@en ,
                     "Ladda ned en fil med curl till aktuell katalog och behåll filnamnet från URL:en"@sv ;
    solid-memo:back "curl -O <url>"@zxx ;
    solid-memo:backNote "Capital O. Without it curl writes the data to the terminal; lower-case -o <file> saves it under a name you choose."@en ,
                        "Versalt O. Utan flaggan skriver curl data till terminalen; gement -o <file> sparar under ett namn du väljer."@sv .

<#ssh>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Log in to a remote machine over SSH as a given user"@en ,
                     "Logga in på en fjärrdator via SSH som en viss användare"@sv ;
    solid-memo:back "ssh <user>@<host>"@zxx .

<#scp>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Copy a local file to a directory on a remote machine with scp (secure copy over SSH)"@en ,
                     "Kopiera en lokal fil till en katalog på en fjärrdator med scp (säker kopiering över SSH)"@sv ;
    solid-memo:back "scp <file> <user>@<host>:<dir>"@zxx ;
    solid-memo:backNote "Mind the colon after the host: without it, scp makes a local copy named <user>@<host>."@en ,
                        "Glöm inte kolonet efter värden: utan det gör scp en lokal kopia med namnet <user>@<host>."@sv .

<#man>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Show the manual page of a command"@en ,
                     "Visa manualsidan för ett kommando"@sv ;
    solid-memo:back "man <command>"@zxx .
