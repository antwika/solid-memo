<>
    a solid-memo:Deck ,
      dcat:Dataset ;
    dcterms:title "Unix shell commands"@en ,
                  "Unix-skalkommandon"@sv ;
    dcterms:creator <#anton-wiklund> ;
    dcterms:license <https://creativecommons.org/publicdomain/zero/1.0/> ;
    dcterms:description "55 everyday Unix and Linux shell commands: the front describes a task in plain words in English and Swedish, the back is the command that does it, with placeholders such as <file> or <dir>. Covers moving around the directory tree, files and directories, viewing and searching files (grep, find), permissions, processes and jobs, tar archives, pipes and redirection, disk usage and networking basics. POSIX commands and options are preferred; notes say where a command is GNU, XSI or Linux-specific. Every command was run with dash and bash on Linux (uutils and GNU coreutils) and checked against the POSIX.1-2024 specification and the GNU manuals. Sources, method and quality control: https://github.com/antwika/solid-memo/blob/main/packages/deck-library/authored/unix-shell-commands.md"@en ,
                        "55 vardagliga skalkommandon för Unix och Linux: på framsidan en uppgift beskriven med vanliga ord på engelska och svenska, på baksidan kommandot som utför den, med platshållare som <file> eller <dir>. Omfattar förflyttning i katalogträdet, filer och kataloger, att visa och söka i filer (grep, find), rättigheter, processer och jobb, tar-arkiv, rör (pipes) och omdirigering, diskanvändning och grundläggande nätverkskommandon. POSIX-kommandon och POSIX-flaggor föredras; anteckningar talar om när ett kommando är specifikt för GNU, XSI eller Linux. Varje kommando har körts med dash och bash på Linux (uutils och GNU coreutils) och kontrollerats mot specifikationen POSIX.1-2024 och GNU:s handböcker. Källor, metod och kvalitetskontroll: https://github.com/antwika/solid-memo/blob/main/packages/deck-library/authored/unix-shell-commands.md"@sv ;
    prov:wasDerivedFrom <https://github.com/antwika/solid-memo/blob/main/packages/deck-library/authored/unix-shell-commands.md#queries> ;
    prov:wasGeneratedBy <#compilation> ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    dcat:theme <http://publications.europa.eu/resource/authority/data-theme/EDUC> ,
               topic:computing ;
    dcat:keyword "Unix" ,
                 "Linux" ,
                 "shell" ,
                 "command line" ,
                 "POSIX" ,
                 "terminal" ,
                 "skal" ,
                 "kommandorad" ,
                 "skalkommandon" ,
                 "kommandotolk" ;
    dcterms:language <http://publications.europa.eu/resource/authority/language/ENG> ,
                     <http://publications.europa.eu/resource/authority/language/SWE> ;
    solid-memo:studyDirection solid-memo:frontToBack ;
    solid-memo:formatVersion 4 .

