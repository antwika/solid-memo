    dcterms:title "Organs of the human body"@en ,
                  "Människokroppens organ"@sv ;
    dcterms:creator <#anton-wiklund> ;
    dcterms:license <https://creativecommons.org/publicdomain/zero/1.0/> ;
    dcterms:description "44 organs and organ parts of the human body, from the brain to the lymph nodes. Front: the organ's common name in English and Swedish; back: its Latin name in Terminologia Anatomica (TA98). A note on the back names the organ system or the organ's main function. Compiled from Wikidata and Svensk MeSH (Karolinska Institutet's Swedish translation of MeSH), with the Latin checked against TA98 and the facts against the Swedish and English Wikipedia. Sources, method and quality control: https://github.com/antwika/solid-memo/blob/main/packages/deck-library/authored/human-organs.md"@en ,
                        "44 organ och organdelar i människokroppen, från hjärnan till lymfknutorna. Framsida: organets gängse namn på engelska och svenska; baksida: dess latinska namn enligt Terminologia Anatomica (TA98). En anteckning på baksidan anger organsystemet eller organets huvudsakliga uppgift. Sammanställd från Wikidata och Svensk MeSH (Karolinska Institutets svenska översättning av MeSH), med latinet kontrollerat mot TA98 och fakta mot svenskspråkiga och engelskspråkiga Wikipedia. Källor, metod och kvalitetskontroll: https://github.com/antwika/solid-memo/blob/main/packages/deck-library/authored/human-organs.md"@sv ;
    prov:wasDerivedFrom <https://www.wikidata.org/> ,
                        <https://mesh.kib.ki.se/> ;
    prov:wasGeneratedBy <#compilation> ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    dcat:theme <http://publications.europa.eu/resource/authority/data-theme/EDUC> ,
               topic:biology ;
    dcat:keyword "anatomy"@en ,
                 "organs"@en ,
                 "human body"@en ,
                 "Latin"@en ,
                 "Terminologia Anatomica"@en ,
                 "anatomi"@sv ,
                 "organ"@sv ,
                 "människokroppen"@sv ,
                 "latin"@sv ,
                 "Terminologia Anatomica"@sv ;
    dcterms:language <http://publications.europa.eu/resource/authority/language/ENG> ,
                     <http://publications.europa.eu/resource/authority/language/SWE> ,
                     <http://publications.europa.eu/resource/authority/language/LAT> ;
    solid-memo:studyDirection solid-memo:bidirectional ;
    solid-memo:formatVersion 5 .

