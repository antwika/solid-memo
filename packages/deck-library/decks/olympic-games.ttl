<>
    a solid-memo:Deck ,
      dcat:Dataset ;
    dcterms:title "Olympic Games host cities"@en ,
                  "Olympiska spelens värdstäder"@sv ;
    dcterms:creator <#anton-wiklund> ;
    dcterms:license <https://creativecommons.org/publicdomain/zero/1.0/> ;
    dcterms:description "The host cities of all 55 Summer and Winter Olympic Games held from Athens 1896 to Milano Cortina 2026 (the Games cancelled in 1916, 1940 and 1944 and the 1906 Intercalated Games are not included). Front: the Games, e.g. \"1912 Summer Olympics\"; back: the host city in English and Swedish, both cities for the co-hosted 2026 Games, with a note where it helps (such as the 1956 equestrian events in Stockholm). Taken from Wikidata and checked against the IOC's list of Games (olympics.com) and Olympedia. Sources, method and quality control: https://github.com/antwika/solid-memo/blob/main/packages/deck-library/authored/olympic-games.md"@en ,
                        "Värdstäderna för alla 55 olympiska sommar- och vinterspel som hållits från Aten 1896 till Milano Cortina 2026 (de inställda spelen 1916, 1940 och 1944 och extraspelen i Aten 1906 ingår inte). Framsida: spelen, t.ex. ”Olympiska sommarspelen 1912”; baksida: värdstaden på engelska och svenska, båda städerna för spelen 2026, som hade två värdstäder, med en anteckning där den hjälper (som ridsporten i Stockholm 1956). Uppgifterna är hämtade från Wikidata och kontrollerade mot IOK:s lista över spelen (olympics.com) och Olympedia. Källor, metod och kvalitetskontroll: https://github.com/antwika/solid-memo/blob/main/packages/deck-library/authored/olympic-games.md"@sv ;
    prov:wasDerivedFrom <https://www.wikidata.org/wiki/Q159821> ;
    prov:wasGeneratedBy <#compilation> ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    dcat:theme <http://publications.europa.eu/resource/authority/data-theme/EDUC> ,
               topic:sports ;
    dcat:keyword "Olympic Games"@en ,
                 "Summer Olympics"@en ,
                 "Winter Olympics"@en ,
                 "host cities"@en ,
                 "sports history"@en ,
                 "olympiska spelen"@sv ,
                 "sommar-OS"@sv ,
                 "vinter-OS"@sv ,
                 "värdstäder"@sv ,
                 "idrottshistoria"@sv ;
    dcterms:language <http://publications.europa.eu/resource/authority/language/ENG> ,
                     <http://publications.europa.eu/resource/authority/language/SWE> ;
    solid-memo:studyDirection solid-memo:frontToBack ;
    solid-memo:formatVersion 5 .

<#anton-wiklund>
    a foaf:Agent ;
    foaf:name "Anton Wiklund" ;
    foaf:mbox <mailto:antonwiklund91@gmail.com> .

<https://creativecommons.org/licenses/by-sa/4.0/>
    a dcterms:LicenseDocument .

<https://creativecommons.org/publicdomain/zero/1.0/>
    a dcterms:LicenseDocument .

# How this deck was made (W3C PROV-O): researched card by card from the sources below,
# each card checked against at least two of them. The full record is the provenance report.
<#compilation>
    a prov:Activity ;
    prov:endedAtTime "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    prov:used <https://www.wikidata.org/wiki/Q159821> ,
              <https://www.olympics.com/en/olympic-games> ,
              <https://www.olympedia.org/editions> ,
              <https://sv.wikipedia.org/wiki/Olympiska_spelen> ,
              <https://en.wikipedia.org/wiki/Olympic_Games> ;
    prov:wasAssociatedWith <#anton-wiklund> ,
                           <https://github.com/antwika/solid-memo/blob/main/packages/deck-library/scripts/authored_decks.py> ;
    rdfs:seeAlso <https://github.com/antwika/solid-memo/blob/main/packages/deck-library/authored/olympic-games.md> ;
    rdfs:comment "Compiled from the dossier authored/olympic-games.json, which records every source, the method, the quality-control rounds and the evidence for each card; built with python3 packages/deck-library/scripts/authored_decks.py build olympic-games." .

<https://github.com/antwika/solid-memo/blob/main/packages/deck-library/scripts/authored_decks.py>
    a prov:SoftwareAgent ;
    dcterms:title "authored_decks.py" .

<https://www.wikidata.org/wiki/Q159821>
    dcterms:title "Wikidata: the editions of the Summer Olympic Games (Q159821) and Winter Olympic Games (Q82414), their locations (P276) and the labels of the Games and the host cities" ;
    dcterms:creator "Wikidata contributors" ;
    dcterms:license <https://creativecommons.org/publicdomain/zero/1.0/> .

<https://www.olympics.com/en/olympic-games>
    dcterms:title "Olympic Games — every edition (olympics.com), with the Melbourne 1956 page" ;
    dcterms:creator "International Olympic Committee" .

<https://www.olympedia.org/editions>
    dcterms:title "Olympedia — Games overview (editions)" ;
    dcterms:creator "OlyMADMen (Olympedia)" .

<https://sv.wikipedia.org/wiki/Olympiska_spelen>
    dcterms:title "Svenskspråkiga Wikipedia: artiklarna om de olympiska spelen (Olympiska sommarspelen 1896 … Olympiska vinterspelen 2026), inledningarna" ;
    dcterms:creator "Wikipedia contributors" ;
    dcterms:license <https://creativecommons.org/licenses/by-sa/4.0/> .

<https://en.wikipedia.org/wiki/Olympic_Games>
    dcterms:title "English Wikipedia: the articles on the Olympic Games with a note (1956 Summer, 2020 Summer, 1960, 1984, 2006, 2018 and 2026 Winter Olympics) and on Chamonix (the 1924 note), introductions" ;
    dcterms:creator "Wikipedia contributors" ;
    dcterms:license <https://creativecommons.org/licenses/by-sa/4.0/> .

