    solid-memo:back "wine"@en ,
                    "vinet"@sv ;
    solid-memo:backNote "Originally a god of vegetation, worshipped with ecstatic rites."@en ,
                        "Ursprungligen en växtlighetens gud, dyrkad med extatiska riter."@sv .

<#hades-domain>
    a solid-memo:Card ;
