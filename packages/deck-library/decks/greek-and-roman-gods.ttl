<>
    a solid-memo:Deck ,
      dcat:Dataset ;
    dcterms:title "Greek and Roman gods"@en ,
                  "Grekiska och romerska gudar"@sv ;
    dcterms:creator <#anton-wiklund> ;
    dcterms:license <https://creativecommons.org/publicdomain/zero/1.0/> ;
    dcterms:description "43 cards on 22 Greek gods: the twelve Olympians (counting both Hestia and Dionysus, as lists differ), Hades, Persephone, Eros, Cronus and five personified gods such as Helios and Nike. One kind of card asks for the god's Roman counterpart (Zeus → Jupiter), the other for what the god is god of (Zeus → the sky and thunder), in English and Swedish. Correspondences, names and domains from Wikidata and the 1911 Encyclopædia Britannica, in our own words, checked against the Theoi Project and Swedish Wikipedia. Sources, method and quality control: https://github.com/antwika/solid-memo/blob/main/packages/deck-library/authored/greek-and-roman-gods.md"@en ,
                        "43 kort om 22 grekiska gudar: de tolv olympierna (både Hestia och Dionysos medräknade, eftersom listorna skiljer sig åt), Hades, Persefone, Eros, Kronos och fem personifierade gudar som Helios och Nike. Den ena sortens kort frågar efter gudens romerska motsvarighet (Zeus → Jupiter), den andra efter vad guden är gud för (Zeus → himlen och åskan), på engelska och svenska. Motsvarigheter, namn och gudarnas områden från Wikidata och Encyclopædia Britannica från 1911, med egna ord, kontrollerade mot Theoi Project och svenska Wikipedia. Källor, metod och kvalitetskontroll: https://github.com/antwika/solid-memo/blob/main/packages/deck-library/authored/greek-and-roman-gods.md"@sv ;
    prov:wasDerivedFrom <https://www.wikidata.org/> ,
                        <https://en.wikisource.org/wiki/1911_Encyclop%C3%A6dia_Britannica> ;
    prov:wasGeneratedBy <#compilation> ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    dcat:theme <http://publications.europa.eu/resource/authority/data-theme/EDUC> ,
               topic:mythology ,
               topic:history ;
    dcat:keyword "Greek mythology"@en ,
                 "Roman mythology"@en ,
                 "Olympians"@en ,
                 "gods"@en ,
                 "grekisk mytologi"@sv ,
                 "romersk mytologi"@sv ,
                 "olympier"@sv ,
                 "gudar"@sv ;
    dcterms:language <http://publications.europa.eu/resource/authority/language/ENG> ,
                     <http://publications.europa.eu/resource/authority/language/SWE> ;
    solid-memo:studyDirection solid-memo:frontToBack ;
    solid-memo:formatVersion 5 .

