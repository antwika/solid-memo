<>
    a solid-memo:Deck ,
      dcat:Dataset ;
    dcterms:title "Nobel Prize in Chemistry"@en ,
                  "Nobelpriset i kemi"@sv ;
    dcterms:creator <#anton-wiklund> ;
    dcterms:license <https://creativecommons.org/publicdomain/zero/1.0/> ;
    dcterms:description "Every Nobel Prize in Chemistry from 1901 to 2025, one card per prize year: 117 cards with the year on the front and the laureate or laureates on the back, with a short note on what the prize was for. Years with no award are left out; the deck ends with the 2025 prize, as the 2026 prize had not been announced when the deck was made on 4 October 2026. From the Nobel Prize API and Wikidata, checked against NobelPrize.org. Not affiliated with or endorsed by the Nobel Foundation or the Royal Swedish Academy of Sciences. Sources, method and quality control: https://github.com/antwika/solid-memo/blob/main/packages/deck-library/authored/nobel-prize-in-chemistry.md"@en ,
                        "Varje nobelpris i kemi från 1901 till 2025, ett kort per prisår: 117 kort med året på framsidan och pristagaren eller pristagarna på baksidan, med en kort anteckning om vad priset gavs för. År då priset inte delades ut är utelämnade; kortleken slutar med 2025 års pris, eftersom 2026 års pris inte var tillkännagivet när kortleken gjordes den 4 oktober 2026. Från Nobelprisets API och Wikidata, kontrollerat mot NobelPrize.org. Inte knuten till eller godkänd av Nobelstiftelsen eller Kungl. Vetenskapsakademien. Källor, metod och kvalitetskontroll: https://github.com/antwika/solid-memo/blob/main/packages/deck-library/authored/nobel-prize-in-chemistry.md"@sv ;
    prov:wasDerivedFrom <https://api.nobelprize.org/2.1/> ,
                        <https://www.wikidata.org/wiki/Q44585> ;
    prov:wasGeneratedBy <#compilation> ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    dcat:theme <http://publications.europa.eu/resource/authority/data-theme/EDUC> ,
               topic:chemistry ,
               topic:history ;
    dcat:keyword "Nobel Prize in Chemistry"@en ,
                 "Nobel laureates"@en ,
                 "chemistry"@en ,
                 "history of science"@en ,
                 "Nobelpriset i kemi"@sv ,
                 "nobelpristagare"@sv ,
                 "kemi"@sv ,
                 "vetenskapshistoria"@sv ;
    dcterms:language <http://publications.europa.eu/resource/authority/language/ENG> ,
                     <http://publications.europa.eu/resource/authority/language/SWE> ;
    solid-memo:studyDirection solid-memo:frontToBack ;
    solid-memo:formatVersion 5 .

