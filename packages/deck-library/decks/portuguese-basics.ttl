<>
    a solid-memo:Deck ,
      dcat:Dataset ;
    dcterms:title "Basic Portuguese"@en ,
                  "Grundläggande portugisiska"@sv ;
    dcterms:creator <#anton-wiklund> ;
    dcterms:license <https://creativecommons.org/publicdomain/zero/1.0/> ;
    dcterms:description "120 basic Portuguese words and phrases for beginners: the numbers 0–20, the tens and 100, the days of the week, the months, eight colours, family members, greetings and polite phrases, everyday nouns, six adjectives and 16 verbs, in European Portuguese spelt by the 1990 Orthographic Agreement, with Brazilian forms in notes where they differ. The front shows the Portuguese word, nouns with their article (o livro, a casa); the back gives its English and Swedish meaning, or the digits for a number. Words from Wikidata's lexemes and the US Foreign Service Institute's Portuguese course (public domain), checked against Priberam, Wiktionary and Folkets lexikon. Sources, method and quality control: https://github.com/antwika/solid-memo/blob/main/packages/deck-library/authored/portuguese-basics.md"@en ,
                        "120 grundläggande portugisiska ord och fraser för nybörjare: talen 0–20, tiotalen och 100, veckodagarna, månaderna, åtta färger, familjemedlemmar, hälsningar och artighetsfraser, vardagliga substantiv, sex adjektiv och 16 verb, på europeisk portugisiska med stavning enligt 1990 års stavningsavtal och brasilianska former i anteckningar där de skiljer sig. Framsidan visar det portugisiska ordet, substantiv med sin artikel (o livro, a casa); baksidan ger betydelsen på engelska och svenska, eller siffrorna för ett tal. Ord från Wikidatas lexem och amerikanska Foreign Service Institutes portugisiskkurs (fri från upphovsrätt), kontrollerade mot Priberam, Wiktionary och Folkets lexikon. Källor, metod och kvalitetskontroll: https://github.com/antwika/solid-memo/blob/main/packages/deck-library/authored/portuguese-basics.md"@sv ;
    prov:wasDerivedFrom <https://www.wikidata.org/> ,
                        <https://archive.org/details/ERIC_ED096854> ;
    prov:wasGeneratedBy <#compilation> ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    dcat:theme <http://publications.europa.eu/resource/authority/data-theme/EDUC> ,
               topic:languages ,
               topic:portuguese ;
    dcat:keyword "Portuguese"@en ,
                 "vocabulary"@en ,
                 "beginners"@en ,
                 "phrases"@en ,
                 "European Portuguese"@en ,
                 "portugisiska"@sv ,
                 "ordförråd"@sv ,
                 "nybörjare"@sv ,
                 "fraser"@sv ,
                 "europeisk portugisiska"@sv ;
    dcterms:language <http://publications.europa.eu/resource/authority/language/ENG> ,
                     <http://publications.europa.eu/resource/authority/language/SWE> ,
                     <http://publications.europa.eu/resource/authority/language/POR> ;
    solid-memo:studyDirection solid-memo:frontToBack ;
    solid-memo:formatVersion 5 .

