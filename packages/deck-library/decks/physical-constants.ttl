<>
    a solid-memo:Deck ,
      dcat:Dataset ;
    dcterms:title "Physical constants"@en ,
                  "Fysikaliska konstanter"@sv ;
    dcterms:creator <#anton-wiklund> ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:description "35 fundamental physical constants in 70 cards: the seven exact defining constants of the SI, constants derived exactly from them, and measured constants of electromagnetism, atomic physics and gravitation, including the Planck units. For each constant one card asks for its standard symbol and one for its value (with unit where it has one). Values are exact where the SI makes them exact; otherwise they are the CODATA 2022 recommended values rounded to 5 significant figures and marked ≈. Values use a decimal point, as in CODATA's tables, and digits grouped in threes; the Swedish notes follow Swedish practice with a decimal comma. Compiled from the CODATA 2022 report (arXiv), the BIPM SI Brochure, Swedac's regulations on units (STAFS 2009:26) and Wikidata, and checked against NIST's CODATA tables. Sources, method and quality control: https://github.com/antwika/solid-memo/blob/main/packages/deck-library/authored/physical-constants.md"@en ,
                        "35 fundamentala fysikaliska konstanter i 70 kort: SI:s sju exakta definierande konstanter, konstanter som exakt härleds ur dem och uppmätta konstanter inom elektromagnetism, atomfysik och gravitation, bland dem Planckenheterna. För varje konstant frågar ett kort efter dess vedertagna beteckning och ett efter dess värde (med enhet där den har en). Värdena är exakta där SI gör dem exakta; i övriga fall är de CODATA:s rekommenderade värden från 2022, avrundade till 5 värdesiffror och markerade med ≈. Värdena skrivs med decimalpunkt, som i CODATA:s tabeller, och siffrorna grupperade tre och tre; de svenska anteckningarna följer svensk skrivsed med decimalkomma. Sammanställd ur CODATA:s rapport från 2022 (arXiv), BIPM:s SI-broschyr, Swedacs föreskrifter om måttenheter (STAFS 2009:26) och Wikidata, och kontrollerad mot NIST:s CODATA-tabeller. Källor, metod och kvalitetskontroll: https://github.com/antwika/solid-memo/blob/main/packages/deck-library/authored/physical-constants.md"@sv ;
    prov:wasDerivedFrom <https://arxiv.org/abs/2409.03787> ,
                        <https://www.bipm.org/documents/20126/41483022/SI-Brochure-9-EN.pdf> ,
                        <https://regelverk.swedac.se/foreskrifter/swedac/stafs-2009-26-konsol.pdf> ,
                        <https://www.wikidata.org/wiki/Property:P1645> ;
    prov:wasGeneratedBy <#compilation> ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    dcat:theme <http://publications.europa.eu/resource/authority/data-theme/EDUC> ,
               topic:physics ,
               topic:science ;
    dcat:keyword "physical constants"@en ,
                 "CODATA"@en ,
                 "SI defining constants"@en ,
                 "physics"@en ,
                 "Planck units"@en ,
                 "fysikaliska konstanter"@sv ,
                 "naturkonstanter"@sv ,
                 "definierande konstanter"@sv ,
                 "fysik"@sv ,
                 "Planckenheter"@sv ,
                 "CODATA"@sv ;
    dcterms:language <http://publications.europa.eu/resource/authority/language/ENG> ,
                     <http://publications.europa.eu/resource/authority/language/SWE> ;
    solid-memo:studyDirection solid-memo:frontToBack ;
    solid-memo:formatVersion 5 .

