<#caesium-frequency-symbol>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Hyperfine transition frequency of Cs-133: symbol"@en ,
                     "Cesiumfrekvensen: beteckning"@sv ;
    solid-memo:back "ΔνCs"@zxx ;
    solid-memo:backNote "Δν with subscript Cs."@en ,
                        "Δν med nedsänkt Cs."@sv .

<#caesium-frequency-value>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Hyperfine transition frequency of Cs-133: value"@en ,
                     "Cesiumfrekvensen: värde"@sv ;
    solid-memo:back "9 192 631 770 Hz"@zxx ;
    solid-memo:backNote "Exact: one of the seven defining constants of the SI (as revised in 2019); its value has been fixed since 1967."@en ,
                        "Exakt: en av SI:s sju definierande konstanter (enligt 2019 års revision); värdet har varit fastställt sedan 1967."@sv .

<#speed-of-light-symbol>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Speed of light in vacuum: symbol"@en ,
                     "Ljusets hastighet i vakuum: beteckning"@sv ;
    solid-memo:back "c"@zxx .

<#speed-of-light-value>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Speed of light in vacuum: value"@en ,
                     "Ljusets hastighet i vakuum: värde"@sv ;
    solid-memo:back "299 792 458 m s⁻¹"@zxx ;
    solid-memo:backNote "Exact: one of the seven defining constants of the SI (as revised in 2019); its value has been fixed since 1983."@en ,
                        "Exakt: en av SI:s sju definierande konstanter (enligt 2019 års revision); värdet har varit fastställt sedan 1983."@sv .

<#planck-constant-symbol>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Planck constant: symbol"@en ,
                     "Plancks konstant: beteckning"@sv ;
    solid-memo:back "h"@zxx .

<#planck-constant-value>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Planck constant: value"@en ,
                     "Plancks konstant: värde"@sv ;
    solid-memo:back "6.626 070 15 × 10⁻³⁴ J s"@zxx ;
    solid-memo:backNote "Exact: one of the seven defining constants of the SI (since 2019). CODATA 2022 writes the unit as J Hz⁻¹, the same as J s."@en ,
                        "Exakt: en av SI:s sju definierande konstanter (sedan 2019). CODATA 2022 skriver enheten som J Hz⁻¹, vilket är detsamma som J s."@sv .

<#elementary-charge-symbol>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Elementary charge: symbol"@en ,
                     "Elementarladdningen: beteckning"@sv ;
    solid-memo:back "e"@zxx .

<#elementary-charge-value>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Elementary charge: value"@en ,
                     "Elementarladdningen: värde"@sv ;
    solid-memo:back "1.602 176 634 × 10⁻¹⁹ C"@zxx ;
    solid-memo:backNote "Exact: one of the seven defining constants of the SI (since 2019)."@en ,
                        "Exakt: en av SI:s sju definierande konstanter (sedan 2019)."@sv .

<#boltzmann-constant-symbol>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Boltzmann constant: symbol"@en ,
                     "Boltzmanns konstant: beteckning"@sv ;
    solid-memo:back "k"@zxx ;
    solid-memo:backNote "Also written kB (k with subscript B)."@en ,
                        "Skrivs även kB (k med nedsänkt B)."@sv .

<#boltzmann-constant-value>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Boltzmann constant: value"@en ,
                     "Boltzmanns konstant: värde"@sv ;
    solid-memo:back "1.380 649 × 10⁻²³ J K⁻¹"@zxx ;
    solid-memo:backNote "Exact: one of the seven defining constants of the SI (since 2019)."@en ,
                        "Exakt: en av SI:s sju definierande konstanter (sedan 2019)."@sv .

<#avogadro-constant-symbol>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Avogadro constant: symbol"@en ,
                     "Avogadros konstant: beteckning"@sv ;
    solid-memo:back "NA"@zxx ;
    solid-memo:backNote "N with subscript A."@en ,
                        "N med nedsänkt A."@sv .

<#avogadro-constant-value>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Avogadro constant: value"@en ,
                     "Avogadros konstant: värde"@sv ;
    solid-memo:back "6.022 140 76 × 10²³ mol⁻¹"@zxx ;
    solid-memo:backNote "Exact: one of the seven defining constants of the SI (since 2019)."@en ,
                        "Exakt: en av SI:s sju definierande konstanter (sedan 2019)."@sv .

<#luminous-efficacy-symbol>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Luminous efficacy of monochromatic radiation of frequency 540 × 10¹² Hz: symbol"@en ,
                     "Ljusutbytet för monokromatisk strålning med frekvensen 540 × 10¹² Hz: beteckning"@sv ;
    solid-memo:back "Kcd"@zxx ;
    solid-memo:backNote "K with subscript cd."@en ,
                        "K med nedsänkt cd."@sv .

<#luminous-efficacy-value>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Luminous efficacy of monochromatic radiation of frequency 540 × 10¹² Hz: value"@en ,
                     "Ljusutbytet för monokromatisk strålning med frekvensen 540 × 10¹² Hz: värde"@sv ;
    solid-memo:back "683 lm W⁻¹"@zxx ;
    solid-memo:backNote "Exact: one of the seven defining constants of the SI (as revised in 2019); its value has been fixed since 1979."@en ,
                        "Exakt: en av SI:s sju definierande konstanter (enligt 2019 års revision); värdet har varit fastställt sedan 1979."@sv .

<#reduced-planck-constant-symbol>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Reduced Planck constant: symbol"@en ,
                     "Reducerade Plancks konstant (Diracs konstant): beteckning"@sv ;
    solid-memo:back "ħ"@zxx ;
    solid-memo:backNote "Read “h-bar”: ħ = h/2π."@en ,
                        "Utläses ”h-streck”: ħ = h/2π."@sv .

<#reduced-planck-constant-value>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Reduced Planck constant: value"@en ,
                     "Reducerade Plancks konstant (Diracs konstant): värde"@sv ;
    solid-memo:back "≈ 1.0546 × 10⁻³⁴ J s"@zxx ;
    solid-memo:backNote "Exact, as the Planck constant divided by 2π (since 2019), but its decimals never end; rounded to 5 significant figures."@en ,
                        "Exakt, som Plancks konstant delad med 2π (sedan 2019), men decimalerna tar aldrig slut; avrundat till 5 värdesiffror."@sv .

<#molar-gas-constant-symbol>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Molar gas constant: symbol"@en ,
                     "Allmänna gaskonstanten: beteckning"@sv ;
    solid-memo:back "R"@zxx .

<#molar-gas-constant-value>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Molar gas constant: value"@en ,
                     "Allmänna gaskonstanten: värde"@sv ;
    solid-memo:back "≈ 8.3145 J mol⁻¹ K⁻¹"@zxx ;
    solid-memo:backNote "Exact since 2019, as the product of the Avogadro and Boltzmann constants (8.314 462 618 153 24 J mol⁻¹ K⁻¹); rounded to 5 significant figures."@en ,
                        "Exakt sedan 2019, som produkten av Avogadros och Boltzmanns konstanter (8,314 462 618 153 24 J mol⁻¹ K⁻¹); avrundat till 5 värdesiffror."@sv .

<#faraday-constant-symbol>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Faraday constant: symbol"@en ,
                     "Faradays konstant: beteckning"@sv ;
    solid-memo:back "F"@zxx .

<#faraday-constant-value>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Faraday constant: value"@en ,
                     "Faradays konstant: värde"@sv ;
    solid-memo:back "≈ 96 485 C mol⁻¹"@zxx ;
    solid-memo:backNote "Exact since 2019, as the product of the Avogadro constant and the elementary charge (96 485.332 123 310 018 4 C mol⁻¹); rounded to 5 significant figures."@en ,
                        "Exakt sedan 2019, som produkten av Avogadros konstant och elementarladdningen (96 485,332 123 310 018 4 C mol⁻¹); avrundat till 5 värdesiffror."@sv .

<#stefan-boltzmann-constant-symbol>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Stefan-Boltzmann constant: symbol"@en ,
                     "Stefan–Boltzmanns konstant: beteckning"@sv ;
    solid-memo:back "σ"@zxx .

<#stefan-boltzmann-constant-value>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Stefan-Boltzmann constant: value"@en ,
                     "Stefan–Boltzmanns konstant: värde"@sv ;
    solid-memo:back "≈ 5.6704 × 10⁻⁸ W m⁻² K⁻⁴"@zxx ;
    solid-memo:backNote "Exact, as a combination of defining constants (since 2019), but its decimals never end; rounded to 5 significant figures."@en ,
                        "Exakt, som en kombination av definierande konstanter (sedan 2019), men decimalerna tar aldrig slut; avrundat till 5 värdesiffror."@sv .

<#wien-displacement-constant-symbol>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Wien wavelength displacement law constant: symbol"@en ,
                     "Wiens förskjutningskonstant: beteckning"@sv ;
    solid-memo:back "b"@zxx .

<#wien-displacement-constant-value>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Wien wavelength displacement law constant: value"@en ,
                     "Wiens förskjutningskonstant: värde"@sv ;
    solid-memo:back "≈ 2.8978 × 10⁻³ m K"@zxx ;
    solid-memo:backNote "Exact, as a combination of defining constants (since 2019), but its decimals never end; rounded to 5 significant figures. It gives the wavelength at which a black body radiates most strongly: λₘₐₓ = b/T."@en ,
                        "Exakt, som en kombination av definierande konstanter (sedan 2019), men decimalerna tar aldrig slut; avrundat till 5 värdesiffror. Den ger våglängden där en svartkroppsstrålare strålar som starkast: λₘₐₓ = b/T."@sv .

<#first-radiation-constant-symbol>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "First radiation constant: symbol"@en ,
                     "Första strålningskonstanten: beteckning"@sv ;
    solid-memo:back "c₁"@zxx .

<#first-radiation-constant-value>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "First radiation constant: value"@en ,
                     "Första strålningskonstanten: värde"@sv ;
    solid-memo:back "≈ 3.7418 × 10⁻¹⁶ W m²"@zxx ;
    solid-memo:backNote "Exact, as 2π times the Planck constant times the speed of light squared (since 2019), but its decimals never end; rounded to 5 significant figures."@en ,
                        "Exakt, som 2π gånger Plancks konstant gånger ljushastigheten i kvadrat (sedan 2019), men decimalerna tar aldrig slut; avrundat till 5 värdesiffror."@sv .

<#second-radiation-constant-symbol>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Second radiation constant: symbol"@en ,
                     "Andra strålningskonstanten: beteckning"@sv ;
    solid-memo:back "c₂"@zxx .

<#second-radiation-constant-value>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Second radiation constant: value"@en ,
                     "Andra strålningskonstanten: värde"@sv ;
    solid-memo:back "≈ 1.4388 × 10⁻² m K"@zxx ;
    solid-memo:backNote "Exact, as hc/k (since 2019), but its decimals never end; rounded to 5 significant figures."@en ,
