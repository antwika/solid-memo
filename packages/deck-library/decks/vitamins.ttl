<>
    a solid-memo:Deck ,
      dcat:Dataset ;
    dcterms:title "Vitamins"@en ,
                  "Vitaminer"@sv ;
    dcterms:creator <#anton-wiklund> ;
    dcterms:license <https://creativecommons.org/publicdomain/zero/1.0/> ;
    dcterms:description "The 13 vitamins in 35 cards of three kinds: a vitamin and the chemical name of the vitamin or its main form (e.g. “Vitamin B1: chemical name” → “thiamine”), with separate cards for vitamins D2, D3, K1 and K2; a classic deficiency disease or sign and the vitamin involved (e.g. scurvy → vitamin C); and whether each vitamin is fat-soluble or water-soluble. Text in English and Swedish; no dosage or health advice. Taken from the US National Institutes of Health's Office of Dietary Supplements fact sheets and Wikidata, checked against Livsmedelsverket (the Swedish Food Agency) and the Swedish Wikipedia. Sources, method and quality control: https://github.com/antwika/solid-memo/blob/main/packages/deck-library/authored/vitamins.md"@en ,
                        "De 13 vitaminerna i 35 kort av tre slag: ett vitamin och det kemiska namnet på vitaminet eller dess huvudform (t.ex. ”Vitamin B1: kemiskt namn” → ”tiamin”), med egna kort för vitamin D2, D3, K1 och K2; en klassisk bristsjukdom eller ett bristtecken och vilket vitamin det gäller (t.ex. skörbjugg → C-vitamin); samt om varje vitamin är fettlösligt eller vattenlösligt. Text på engelska och svenska; inga doser eller hälsoråd. Uppgifterna kommer från faktabladen från Office of Dietary Supplements vid USA:s National Institutes of Health och från Wikidata och är kontrollerade mot Livsmedelsverket och svenskspråkiga Wikipedia. Källor, metod och kvalitetskontroll: https://github.com/antwika/solid-memo/blob/main/packages/deck-library/authored/vitamins.md"@sv ;
    prov:wasDerivedFrom <https://ods.od.nih.gov/factsheets/list-VitaminsMinerals/> ,
                        <https://www.wikidata.org/wiki/Q34956> ;
    prov:wasGeneratedBy <#compilation> ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    dcat:theme <http://publications.europa.eu/resource/authority/data-theme/EDUC> ,
               topic:biology ,
               topic:chemistry ;
    dcat:keyword "vitamins" ,
                 "deficiency diseases" ,
                 "fat-soluble vitamins" ,
                 "water-soluble vitamins" ,
                 "nutrition" ,
                 "vitaminer" ,
                 "bristsjukdomar" ,
                 "fettlösliga vitaminer" ,
                 "vattenlösliga vitaminer" ,
                 "näringslära" ;
    dcterms:language <http://publications.europa.eu/resource/authority/language/ENG> ,
                     <http://publications.europa.eu/resource/authority/language/SWE> ;
    solid-memo:studyDirection solid-memo:frontToBack ;
    solid-memo:formatVersion 4 .

