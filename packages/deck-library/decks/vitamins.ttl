<#vitamin-a-name>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Vitamin A: chemical name"@en ,
                     "A-vitamin: kemiskt namn"@sv ;
    solid-memo:frontNote "its main form, an alcohol"@en ,
                         "dess huvudform, en alkohol"@sv ;
    solid-memo:back "retinol"@en ,
                    "retinol"@sv ;
    solid-memo:backNote "Vitamin A is a group of retinoids, mainly retinol and retinyl esters; beta-carotene and other provitamin A carotenoids are converted to it."@en ,
                        "A-vitamin är en grupp retinoider, främst retinol och retinylestrar; betakaroten och andra provitamin A-karotenoider omvandlas till det."@sv .

<#vitamin-b1-name>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Vitamin B1: chemical name"@en ,
                     "Vitamin B1: kemiskt namn"@sv ;
    solid-memo:back "thiamine"@en ,
                    "tiamin"@sv ;
    solid-memo:backNote "Also spelled thiamin; also called aneurin."@en ,
                        "Kallas även aneurin."@sv .

<#vitamin-b2-name>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Vitamin B2: chemical name"@en ,
                     "Vitamin B2: kemiskt namn"@sv ;
    solid-memo:back "riboflavin"@en ,
                    "riboflavin"@sv .

<#vitamin-b3-name>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Vitamin B3: chemical name"@en ,
                     "Vitamin B3: kemiskt namn"@sv ;
    solid-memo:frontNote "generic name"@en ,
                         "samlingsnamn"@sv ;
    solid-memo:back "niacin"@en ,
                    "niacin"@sv ;
    solid-memo:backNote "The generic name for nicotinic acid and nicotinamide."@en ,
                        "Samlingsnamn för nikotinsyra och nikotinamid."@sv .

<#vitamin-b5-name>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Vitamin B5: chemical name"@en ,
                     "Vitamin B5: kemiskt namn"@sv ;
    solid-memo:back "pantothenic acid"@en ,
                    "pantotensyra"@sv .

<#vitamin-b6-name>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Vitamin B6: chemical name"@en ,
                     "Vitamin B6: kemiskt namn"@sv ;
    solid-memo:frontNote "the alcohol among its forms"@en ,
                         "alkoholen bland dess former"@sv ;
    solid-memo:back "pyridoxine"@en ,
                    "pyridoxin"@sv ;
    solid-memo:backNote "Vitamin B6 comprises six compounds: pyridoxine, pyridoxal, pyridoxamine and their phosphate esters."@en ,
                        "Vitamin B6 omfattar sex föreningar: pyridoxin, pyridoxal, pyridoxamin och deras fosfatestrar."@sv .

<#vitamin-b7-name>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Vitamin B7: chemical name"@en ,
                     "Vitamin B7: kemiskt namn"@sv ;
    solid-memo:back "biotin"@en ,
                    "biotin"@sv ;
    solid-memo:backNote "Also called vitamin H."@en ,
                        "Kallas även vitamin H."@sv .

<#vitamin-b9-name>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Vitamin B9: chemical name"@en ,
                     "Vitamin B9: kemiskt namn"@sv ;
    solid-memo:frontNote "generic name"@en ,
                         "samlingsnamn"@sv ;
    solid-memo:back "folate"@en ,
                    "folat"@sv ;
    solid-memo:backNote "Folic acid is the synthetic form used in fortified foods and most supplements."@en ,
                        "Folsyra är den syntetiska formen; den finns i berikade livsmedel och i de flesta kosttillskott."@sv .

<#vitamin-b12-name>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Vitamin B12: chemical name"@en ,
                     "Vitamin B12: kemiskt namn"@sv ;
    solid-memo:frontNote "generic name"@en ,
                         "samlingsnamn"@sv ;
    solid-memo:back "cobalamin"@en ,
                    "kobalamin"@sv ;
    solid-memo:backNote "Named after the cobalt it contains."@en ,
                        "Namnet kommer av att vitaminet innehåller kobolt."@sv .

<#vitamin-c-name>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Vitamin C: chemical name"@en ,
                     "C-vitamin: kemiskt namn"@sv ;
    solid-memo:back "ascorbic acid"@en ,
                    "askorbinsyra"@sv ;
    solid-memo:backNote "The vitamin is L-ascorbic acid; as a food additive it is E300."@en ,
                        "Vitaminet är L-askorbinsyra; som livsmedelstillsats E300."@sv .

<#vitamin-d2-name>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Vitamin D2: chemical name"@en ,
                     "Vitamin D2: kemiskt namn"@sv ;
    solid-memo:back "ergocalciferol"@en ,
                    "ergokalciferol"@sv ;
    solid-memo:backNote "One of the two main forms of vitamin D (with D3); found in mushrooms."@en ,
                        "En av D-vitaminets två huvudformer (med D3); finns i svampar."@sv .

<#vitamin-d3-name>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Vitamin D3: chemical name"@en ,
                     "Vitamin D3: kemiskt namn"@sv ;
    solid-memo:back "cholecalciferol"@en ,
                    "kolekalciferol"@sv ;
    solid-memo:backNote "The form made in the skin by UVB light; also in animal-based foods."@en ,
                        "Bildas i huden när den utsätts för UVB-ljus; finns också i livsmedel från djur."@sv .

<#vitamin-e-name>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Vitamin E: chemical name"@en ,
                     "E-vitamin: kemiskt namn"@sv ;
    solid-memo:frontNote "the form that meets human requirements"@en ,
                         "den form som täcker människans behov"@sv ;
    solid-memo:back "alpha-tocopherol"@en ,
                    "alfa-tokoferol"@sv ;
    solid-memo:backNote "Vitamin E comprises eight compounds: four tocopherols and four tocotrienols (alpha, beta, gamma, delta)."@en ,
                        "E-vitamin omfattar åtta föreningar: fyra tokoferoler och fyra tokotrienoler (alfa, beta, gamma, delta)."@sv .

<#vitamin-k1-name>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Vitamin K1: chemical name"@en ,
                     "Vitamin K1: kemiskt namn"@sv ;
    solid-memo:back "phylloquinone"@en ,
                    "fyllokinon"@sv ;
    solid-memo:backNote "Found mainly in green leafy vegetables; the main dietary form of vitamin K."@en ,
                        "Finns främst i gröna bladgrönsaker; den viktigaste formen av K-vitamin i kosten."@sv .

<#vitamin-k2-name>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Vitamin K2: chemical name"@en ,
                     "Vitamin K2: kemiskt namn"@sv ;
    solid-memo:back "menaquinones"@en ,
                    "menakinoner"@sv ;
    solid-memo:backNote "Mostly made by bacteria; named MK-n (e.g. MK-4, MK-7) after the length of their side chain."@en ,
                        "Bildas främst av bakterier; betecknas MK-n (t.ex. MK-4, MK-7) efter sidokedjans längd."@sv .

<#scurvy>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Scurvy: deficiency of which vitamin?"@en ,
                     "Skörbjugg: brist på vilket vitamin?"@sv ;
    solid-memo:back "vitamin C"@en ,
                    "C-vitamin"@sv .

<#rickets>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Rickets: deficiency of which vitamin?"@en ,
                     "Rakit: brist på vilket vitamin?"@sv ;
    solid-memo:back "vitamin D"@en ,
                    "D-vitamin"@sv ;
    solid-memo:backNote "In children; in adults the same deficiency causes osteomalacia."@en ,
                        "Hos barn; hos vuxna ger samma brist osteomalaci."@sv .

<#osteomalacia>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Osteomalacia: deficiency of which vitamin?"@en ,
                     "Osteomalaci: brist på vilket vitamin?"@sv ;
    solid-memo:back "vitamin D"@en ,
                    "D-vitamin"@sv ;
    solid-memo:backNote "Softening of the bones in adults; in children the same deficiency causes rickets."@en ,
                        "Benuppmjukning hos vuxna; hos barn ger samma brist rakit."@sv .

<#beriberi>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Beriberi: deficiency of which vitamin?"@en ,
                     "Beriberi: brist på vilket vitamin?"@sv ;
    solid-memo:back "vitamin B1 (thiamine)"@en ,
                    "vitamin B1 (tiamin)"@sv ;
    solid-memo:backNote "Thiamine deficiency can also cause Wernicke–Korsakoff syndrome."@en ,
                        "Tiaminbrist kan också ge Wernicke–Korsakoffs syndrom."@sv .

<#pellagra>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Pellagra: deficiency of which vitamin?"@en ,
                     "Pellagra: brist på vilket vitamin?"@sv ;
    solid-memo:back "vitamin B3 (niacin)"@en ,
                    "vitamin B3 (niacin)"@sv .

<#night-blindness>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Night blindness: an early sign of a deficiency of which vitamin?"@en ,
                     "Nattblindhet: ett tidigt tecken på brist på vilket vitamin?"@sv ;
    solid-memo:back "vitamin A"@en ,
                    "A-vitamin"@sv ;
    solid-memo:backNote "It is the first sign of xerophthalmia, the most common sign of vitamin A deficiency."@en ,
                        "Det är det första tecknet på xeroftalmi, det vanligaste tecknet på A-vitaminbrist."@sv .

<#pernicious-anemia>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Pernicious anemia leads to a deficiency of which vitamin?"@en ,
                     "Perniciös anemi ger brist på vilket vitamin?"@sv ;
    solid-memo:back "vitamin B12"@en ,
                    "vitamin B12"@sv ;
    solid-memo:backNote "An autoimmune disease of the stomach lining that stops vitamin B12 from being absorbed."@en ,
                        "En autoimmun sjukdom i magslemhinnan som gör att vitamin B12 inte kan tas upp."@sv .

