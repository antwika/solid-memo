<>
    a solid-memo:Deck ,
      dcat:Dataset ;
    dcterms:title "International Morse code"@en ,
                  "Internationella morsealfabetet"@sv ;
    dcterms:creator <#anton-wiklund> ;
    dcterms:license <https://creativecommons.org/publicdomain/zero/1.0/> ;
    dcterms:description "The International Morse code of Recommendation ITU-R M.1677-1 (the 26 letters A–Z and É, the digits 0–9 and 13 of its 14 punctuation marks and signs; × is sent as X), plus the distress signal SOS from the International Regulations for Preventing Collisions at Sea: 51 cards in all. Front: the character; back: its code, written with · for a dot and − for a dash; studied in both directions. Å, Ä and Ö are not in the current ITU recommendation and are left out. The codes come from Wikidata and the US edition of the International Code of Signals (Pub. 102), checked against the ITU recommendation and Wikipedia. Sources, method and quality control: https://github.com/antwika/solid-memo/blob/main/packages/deck-library/authored/morse-code.md"@en ,
                        "Det internationella morsealfabetet enligt rekommendationen ITU-R M.1677-1 (de 26 bokstäverna A–Z och É, siffrorna 0–9 och 13 av dess 14 skiljetecken och symboler; × sänds som X) samt nödsignalen SOS från de internationella sjövägsreglerna, sammanlagt 51 kort. Framsida: tecknet; baksida: dess kod, skriven med · för en kort och − för en lång signal; kortleken övas åt båda hållen. Å, Ä och Ö ingår inte i den gällande ITU-rekommendationen och har utelämnats. Koderna är hämtade från Wikidata och den amerikanska utgåvan av International Code of Signals (Pub. 102) och kontrollerade mot ITU-rekommendationen och Wikipedia. Källor, metod och kvalitetskontroll: https://github.com/antwika/solid-memo/blob/main/packages/deck-library/authored/morse-code.md"@sv ;
    prov:wasDerivedFrom <https://www.wikidata.org/wiki/Property:P3295> ,
                        <https://archive.org/details/pub-102> ,
                        <https://www.ecfr.gov/current/title-33/chapter-I/subchapter-E/part-87/section-87.01> ;
    prov:wasGeneratedBy <#compilation> ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    dcat:theme <http://publications.europa.eu/resource/authority/data-theme/EDUC> ,
               topic:computing ,
               topic:languages ;
    dcat:keyword "Morse code"@en ,
                 "telegraphy"@en ,
                 "SOS"@en ,
                 "amateur radio"@en ,
                 "ITU"@en ,
                 "morsealfabetet"@sv ,
                 "telegrafi"@sv ,
                 "SOS"@sv ,
                 "amatörradio"@sv ,
                 "ITU"@sv ;
    dcterms:language <http://publications.europa.eu/resource/authority/language/ENG> ,
                     <http://publications.europa.eu/resource/authority/language/SWE> ;
    solid-memo:studyDirection solid-memo:bidirectional ;
    solid-memo:formatVersion 5 .

