<>
    a solid-memo:Deck ,
      dcat:Dataset ;
    dcterms:title "Derivatives"@en ,
                  "Derivator"@sv ;
    dcterms:creator <#anton-wiklund> ;
    dcterms:license <https://creativecommons.org/publicdomain/zero/1.0/> ;
    dcterms:description "42 cards on derivatives for calculus students: the definition, the differentiation rules (sum, product, quotient, chain and more) and the derivatives of powers, roots, exponential, logarithmic, trigonometric, inverse trigonometric, hyperbolic and inverse hyperbolic functions. The rule or function on the front in plain notation such as d/dx sin x, the derivative on the back; angles in radians. Every card is checked with the computer algebra system SymPy and against the NIST Digital Library of Mathematical Functions or Wikipedia (most cards both); rule names checked against Wikidata. Sources, method and quality control: https://github.com/antwika/solid-memo/blob/main/packages/deck-library/authored/derivatives.md"@en ,
                        "42 kort om derivator för den som läser matematisk analys: definitionen, deriveringsreglerna (summa-, produkt-, kvot- och kedjeregeln med flera) och derivatorna av potenser, rötter, exponential- och logaritmfunktioner, trigonometriska funktioner, arcusfunktioner, hyperboliska funktioner och deras inverser. Regeln eller funktionen på framsidan i enkel notation som d/dx sin x, derivatan på baksidan; vinklar i radianer. Varje kort är kontrollerat med datoralgebrasystemet SymPy och mot NIST Digital Library of Mathematical Functions eller Wikipedia (de flesta mot båda); regelnamnen är kontrollerade mot Wikidata. Källor, metod och kvalitetskontroll: https://github.com/antwika/solid-memo/blob/main/packages/deck-library/authored/derivatives.md"@sv ;
    prov:wasDerivedFrom <https://github.com/antwika/solid-memo/blob/main/packages/deck-library/authored/derivatives.json> ,
                        <https://www.wikidata.org/> ;
    prov:wasGeneratedBy <#compilation> ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    dcat:theme <http://publications.europa.eu/resource/authority/data-theme/EDUC> ,
               topic:mathematics ;
    dcat:keyword "calculus"@en ,
                 "derivatives"@en ,
                 "differentiation rules"@en ,
                 "mathematics"@en ,
                 "matematisk analys"@sv ,
                 "infinitesimalkalkyl"@sv ,
                 "derivator"@sv ,
                 "deriveringsregler"@sv ,
                 "matematik"@sv ;
    dcterms:language <http://publications.europa.eu/resource/authority/language/ENG> ,
                     <http://publications.europa.eu/resource/authority/language/SWE> ;
    solid-memo:studyDirection solid-memo:frontToBack ;
    solid-memo:formatVersion 5 .

