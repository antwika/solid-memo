<#definition>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Definition of f′(x)"@en ,
                     "Definitionen av f′(x)"@sv ;
    solid-memo:back "lim h→0 (f(x + h) − f(x))/h" ;
    solid-memo:backNote "The derivative is the limit of the difference quotient, where it exists."@en ,
                        "Derivatan är gränsvärdet av differenskvoten, där det existerar."@sv .

<#constant>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "d/dx c" ;
    solid-memo:frontNote "c is a constant"@en ,
                         "c är en konstant"@sv ;
    solid-memo:back "0" .

<#power-rule>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "d/dx xⁿ" ;
    solid-memo:frontNote "n is a constant"@en ,
                         "n är en konstant"@sv ;
    solid-memo:back "n·xⁿ⁻¹" ;
    solid-memo:backNote "Power rule, for every real n: for x ≠ 0 when n ≤ 0, and for x > 0 when n is not an integer."@en ,
                        "Gäller för alla reella n: för x ≠ 0 när n ≤ 0, och för x > 0 när n inte är ett heltal."@sv .

<#constant-multiple>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "(c·f)′" ;
    solid-memo:frontNote "c is a constant"@en ,
                         "c är en konstant"@sv ;
    solid-memo:back "c·f′" ;
    solid-memo:backNote "A constant factor can be moved outside the derivative."@en ,
                        "En konstant faktor följer med oförändrad vid derivering."@sv .

<#sum-rule>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "(f + g)′" ;
    solid-memo:back "f′ + g′" ;
    solid-memo:backNote "Sum rule: the derivative of a sum is the sum of the derivatives."@en ,
                        "Derivatan av en summa är summan av derivatorna."@sv .

<#difference-rule>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "(f − g)′" ;
    solid-memo:back "f′ − g′" ;
    solid-memo:backNote "The derivative of a difference is the difference of the derivatives."@en ,
                        "Derivatan av en differens är differensen av derivatorna."@sv .

<#product-rule>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "(f·g)′" ;
    solid-memo:back "f′·g + f·g′" ;
    solid-memo:backNote "Product rule."@en ,
                        "Produktregeln."@sv .

<#quotient-rule>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "(f/g)′" ;
    solid-memo:back "(f′·g − f·g′)/g²" ;
    solid-memo:backNote "Quotient rule, where g ≠ 0."@en ,
                        "Kvotregeln, där g ≠ 0."@sv .

<#chain-rule>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "d/dx f(g(x))" ;
    solid-memo:back "f′(g(x))·g′(x)" ;
    solid-memo:backNote "Chain rule: the outer derivative times the inner derivative."@en ,
                        "Kedjeregeln: yttre derivatan gånger inre derivatan."@sv .

<#reciprocal-rule>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "(1/g)′" ;
    solid-memo:back "−g′/g²" ;
    solid-memo:backNote "Reciprocal rule, where g ≠ 0."@en ,
                        "Derivatan av 1/g, där g ≠ 0."@sv .

<#inverse-function-rule>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "(f⁻¹)′(x)" ;
    solid-memo:back "1/f′(f⁻¹(x))" ;
    solid-memo:backNote "Inverse function rule, where f′(f⁻¹(x)) ≠ 0."@en ,
                        "Derivatan av en invers funktion, där f′(f⁻¹(x)) ≠ 0."@sv .

<#logarithmic-derivative>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "d/dx ln f(x)" ;
    solid-memo:back "f′(x)/f(x)" ;
    solid-memo:backNote "Logarithmic derivative, for f(x) > 0."@en ,
                        "Den logaritmiska derivatan, för f(x) > 0."@sv .

<#x>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "d/dx x" ;
    solid-memo:back "1" .

<#x-squared>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "d/dx x²" ;
    solid-memo:back "2x" .

<#x-cubed>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "d/dx x³" ;
    solid-memo:back "3x²" .

<#square-root>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "d/dx √x" ;
    solid-memo:back "1/(2√x)" ;
    solid-memo:backNote "For x > 0."@en ,
                        "För x > 0."@sv .

<#one-over-x>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "d/dx 1/x" ;
    solid-memo:back "−1/x²" .

<#one-over-x-squared>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "d/dx 1/x²" ;
    solid-memo:back "−2/x³" .

<#e-to-x>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "d/dx eˣ" ;
    solid-memo:back "eˣ" .

<#e-to-kx>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "d/dx eᵏˣ" ;
    solid-memo:frontNote "k is a constant"@en ,
                         "k är en konstant"@sv ;
    solid-memo:back "k·eᵏˣ" .

<#a-to-x>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "d/dx aˣ" ;
    solid-memo:frontNote "a is a constant, a > 0"@en ,
                         "a är en konstant, a > 0"@sv ;
    solid-memo:back "aˣ·ln a" .

<#ln-x>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "d/dx ln x" ;
    solid-memo:back "1/x" ;
    solid-memo:backNote "For x > 0."@en ,
                        "För x > 0."@sv .

<#ln-abs-x>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "d/dx ln|x|" ;
    solid-memo:back "1/x" ;
    solid-memo:backNote "For x ≠ 0."@en ,
                        "För x ≠ 0."@sv .

<#log-a-x>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "d/dx logₐ x" ;
    solid-memo:frontNote "a is a constant, a > 0, a ≠ 1"@en ,
                         "a är en konstant, a > 0, a ≠ 1"@sv ;
    solid-memo:back "1/(x·ln a)" ;
    solid-memo:backNote "For x > 0."@en ,
                        "För x > 0."@sv .

<#x-to-x>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "d/dx xˣ" ;
    solid-memo:back "xˣ·(ln x + 1)" ;
    solid-memo:backNote "For x > 0. Write xˣ = exp(x·ln x) and use the chain rule."@en ,
                        "För x > 0. Skriv xˣ = exp(x·ln x) och använd kedjeregeln."@sv .

<#sin>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "d/dx sin x" ;
    solid-memo:back "cos x" .

<#cos>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "d/dx cos x" ;
    solid-memo:back "−sin x" .

<#tan>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "d/dx tan x" ;
    solid-memo:back "1/cos² x" ;
    solid-memo:backNote "Equivalently 1 + tan² x or sec² x."@en ,
                        "Kan också skrivas 1 + tan² x eller sec² x."@sv .

<#cot>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "d/dx cot x" ;
    solid-memo:back "−1/sin² x" ;
    solid-memo:backNote "Equivalently −(1 + cot² x) or −csc² x."@en ,
                        "Kan också skrivas −(1 + cot² x) eller −csc² x."@sv .

<#sec>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "d/dx sec x" ;
    solid-memo:frontNote "sec x = 1/cos x"@en ,
                         "sec x = 1/cos x"@sv ;
    solid-memo:back "sec x · tan x" .

<#csc>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "d/dx csc x" ;
    solid-memo:frontNote "csc x = 1/sin x"@en ,
                         "csc x = 1/sin x"@sv ;
    solid-memo:back "−csc x · cot x" .

<#sin-kx>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "d/dx sin(kx)" ;
    solid-memo:frontNote "k is a constant"@en ,
                         "k är en konstant"@sv ;
    solid-memo:back "k·cos(kx)" .

<#cos-kx>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "d/dx cos(kx)" ;
    solid-memo:frontNote "k is a constant"@en ,
                         "k är en konstant"@sv ;
    solid-memo:back "−k·sin(kx)" .

<#arcsin>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "d/dx arcsin x" ;
    solid-memo:back "1/√(1 − x²)" ;
    solid-memo:backNote "For −1 < x < 1."@en ,
                        "För −1 < x < 1."@sv .

<#arccos>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "d/dx arccos x" ;
    solid-memo:back "−1/√(1 − x²)" ;
    solid-memo:backNote "For −1 < x < 1."@en ,
                        "För −1 < x < 1."@sv .

<#arctan>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "d/dx arctan x" ;
    solid-memo:back "1/(1 + x²)" .

<#sinh>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "d/dx sinh x" ;
    solid-memo:back "cosh x" .

<#cosh>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "d/dx cosh x" ;
    solid-memo:back "sinh x" .

<#tanh>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "d/dx tanh x" ;
    solid-memo:back "1/cosh² x" ;
    solid-memo:backNote "Equivalently 1 − tanh² x or sech² x."@en ,
                        "Kan också skrivas 1 − tanh² x eller sech² x."@sv .

<#arsinh>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "d/dx arsinh x" ;
    solid-memo:back "1/√(x² + 1)" ;
    solid-memo:backNote "arsinh, the inverse of sinh, is also written arcsinh or sinh⁻¹."@en ,
                        "arsinh, inversen till sinh, skrivs också arcsinh eller sinh⁻¹."@sv .

<#arcosh>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "d/dx arcosh x" ;
    solid-memo:back "1/√(x² − 1)" ;
    solid-memo:backNote "For x > 1. arcosh, the inverse of cosh, is also written arccosh or cosh⁻¹."@en ,
                        "För x > 1. arcosh, inversen till cosh, skrivs också arccosh eller cosh⁻¹."@sv .

<#artanh>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "d/dx artanh x" ;
    solid-memo:back "1/(1 − x²)" ;
    solid-memo:backNote "For −1 < x < 1. artanh, the inverse of tanh, is also written arctanh or tanh⁻¹."@en ,
                        "För −1 < x < 1. artanh, inversen till tanh, skrivs också arctanh eller tanh⁻¹."@sv .
