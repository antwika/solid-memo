<>
    a solid-memo:Deck ,
      dcat:Dataset ;
    dcterms:title "Presidents of the United States"@en ,
                  "USA:s presidenter"@sv ;
    dcterms:creator <#anton-wiklund> ;
    dcterms:license <https://creativecommons.org/publicdomain/zero/1.0/> ;
    dcterms:description "All 47 presidencies of the United States as of 4 October 2026, from George Washington (1st, 1789) to Donald Trump (47th, since 2025), numbered as the US government numbers them. Front: the number, e.g. \"16th president of the United States\"; back: the president's name in English and Swedish, with the years in office in a note. Grover Cleveland (22nd and 24th) and Donald Trump (45th and 47th) served non-consecutive terms and are counted twice, so the 47 presidencies were held by 45 people. Taken from Wikidata and checked against the Office of the Historian of the US House of Representatives, the White House, USA.gov and the Miller Center (University of Virginia). Sources, method and quality control: https://github.com/antwika/solid-memo/blob/main/packages/deck-library/authored/us-presidents.md"@en ,
                        "USA:s alla 47 presidentskap per den 4 oktober 2026, från George Washington (den 1:a, 1789) till Donald Trump (den 47:e, sedan 2025), numrerade enligt den officiella amerikanska räkningen. Framsida: numret, t.ex. ”USA:s 16:e president”; baksida: presidentens namn på engelska och svenska, med åren i ämbetet i en anteckning. Grover Cleveland (den 22:a och 24:e) och Donald Trump (den 45:e och 47:e) satt två perioder som inte följde direkt på varandra och räknas två gånger, så de 47 presidentskapen har innehafts av 45 personer. Uppgifterna är hämtade från Wikidata och kontrollerade mot Office of the Historian vid USA:s representanthus, Vita huset, USA.gov och Miller Center (University of Virginia). Källor, metod och kvalitetskontroll: https://github.com/antwika/solid-memo/blob/main/packages/deck-library/authored/us-presidents.md"@sv ;
    prov:wasDerivedFrom <https://www.wikidata.org/wiki/Q11696> ;
    prov:wasGeneratedBy <#compilation> ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    dcat:theme <http://publications.europa.eu/resource/authority/data-theme/EDUC> ,
               topic:history ;
    dcat:keyword "US presidents" ,
                 "President of the United States" ,
                 "American history" ,
                 "White House" ,
                 "amerikanska presidenter" ,
                 "USA:s president" ,
                 "amerikansk historia" ,
                 "Vita huset" ;
    dcterms:language <http://publications.europa.eu/resource/authority/language/ENG> ,
                     <http://publications.europa.eu/resource/authority/language/SWE> ;
    solid-memo:studyDirection solid-memo:frontToBack ;
    solid-memo:formatVersion 4 .

