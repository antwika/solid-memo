<#right-triangle-sine>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "sin θ in a right triangle where θ is an acute angle, a the leg opposite θ, b the leg adjacent to θ and c the hypotenuse"@en ,
                     "sin θ i en rätvinklig triangel där θ är en spetsig vinkel, a motstående katet till θ, b närliggande katet till θ och c hypotenusan"@sv ;
    solid-memo:back "a/c"@zxx .

<#right-triangle-cosine>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "cos θ in a right triangle where θ is an acute angle, a the leg opposite θ, b the leg adjacent to θ and c the hypotenuse"@en ,
                     "cos θ i en rätvinklig triangel där θ är en spetsig vinkel, a motstående katet till θ, b närliggande katet till θ och c hypotenusan"@sv ;
    solid-memo:back "b/c"@zxx .

<#right-triangle-tangent>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "tan θ in a right triangle where θ is an acute angle, a the leg opposite θ, b the leg adjacent to θ and c the hypotenuse"@en ,
                     "tan θ i en rätvinklig triangel där θ är en spetsig vinkel, a motstående katet till θ, b närliggande katet till θ och c hypotenusan"@sv ;
    solid-memo:back "a/b"@zxx .

<#pythagorean-identity>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Pythagorean identity for sin x and cos x"@en ,
                     "Trigonometriska ettan för sin x och cos x"@sv ;
    solid-memo:back "sin²x + cos²x = 1"@zxx .

<#tan-in-sin-cos>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "tan x in terms of sin x and cos x"@en ,
                     "tan x uttryckt i sin x och cos x"@sv ;
    solid-memo:back "sin x/cos x"@zxx ;
    solid-memo:backNote "Defined where cos x ≠ 0."@en ,
                        "Definierad där cos x ≠ 0."@sv .

<#sin-double-angle>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "sin 2x in terms of sin x and cos x"@en ,
                     "sin 2x uttryckt i sin x och cos x"@sv ;
    solid-memo:back "2 sin x cos x"@zxx .

<#cos-double-angle>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "cos 2x in terms of both cos x and sin x, as a difference of squares"@en ,
                     "cos 2x uttryckt i både cos x och sin x, som en skillnad mellan kvadrater"@sv ;
    solid-memo:back "cos²x − sin²x"@zxx ;
    solid-memo:backNote "By the Pythagorean identity also 2 cos²x − 1 or 1 − 2 sin²x."@en ,
                        "Enligt trigonometriska ettan även 2 cos²x − 1 eller 1 − 2 sin²x."@sv .

<#cos-double-angle-cos>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "cos 2x in terms of cos x only"@en ,
                     "cos 2x uttryckt i enbart cos x"@sv ;
    solid-memo:back "2 cos²x − 1"@zxx .

<#cos-double-angle-sin>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "cos 2x in terms of sin x only"@en ,
                     "cos 2x uttryckt i enbart sin x"@sv ;
    solid-memo:back "1 − 2 sin²x"@zxx .

<#tan-double-angle>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "tan 2x in terms of tan x"@en ,
                     "tan 2x uttryckt i tan x"@sv ;
    solid-memo:back "2 tan x/(1 − tan²x)"@zxx ;
    solid-memo:backNote "Where tan x and tan 2x are defined."@en ,
                        "Där tan x och tan 2x är definierade."@sv .

<#sin-sum>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "sin(x + y) in terms of sin and cos of x and y"@en ,
                     "sin(x + y) uttryckt i sin och cos för x och y"@sv ;
    solid-memo:back "sin x cos y + cos x sin y"@zxx .

<#sin-difference>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "sin(x − y) in terms of sin and cos of x and y"@en ,
                     "sin(x − y) uttryckt i sin och cos för x och y"@sv ;
    solid-memo:back "sin x cos y − cos x sin y"@zxx .

<#cos-sum>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "cos(x + y) in terms of sin and cos of x and y"@en ,
                     "cos(x + y) uttryckt i sin och cos för x och y"@sv ;
    solid-memo:back "cos x cos y − sin x sin y"@zxx .

<#cos-difference>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "cos(x − y) in terms of sin and cos of x and y"@en ,
                     "cos(x − y) uttryckt i sin och cos för x och y"@sv ;
    solid-memo:back "cos x cos y + sin x sin y"@zxx .

<#tan-sum>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "tan(x + y) in terms of tan x and tan y"@en ,
                     "tan(x + y) uttryckt i tan x och tan y"@sv ;
    solid-memo:back "(tan x + tan y)/(1 − tan x tan y)"@zxx ;
    solid-memo:backNote "Where tan x, tan y and tan(x + y) are defined."@en ,
                        "Där tan x, tan y och tan(x + y) är definierade."@sv .

<#sin-negative-angle>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "sin(−x) in terms of sin x"@en ,
                     "sin(−x) uttryckt i sin x"@sv ;
    solid-memo:back "−sin x"@zxx ;
    solid-memo:backNote "Sine is an odd function."@en ,
                        "Sinus är en udda funktion."@sv .

<#cos-negative-angle>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "cos(−x) in terms of cos x"@en ,
                     "cos(−x) uttryckt i cos x"@sv ;
    solid-memo:back "cos x"@zxx ;
    solid-memo:backNote "Cosine is an even function."@en ,
                        "Cosinus är en jämn funktion."@sv .

<#law-of-sines>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Law of sines for a triangle with sides a, b, c and the opposite angles A, B, C, written with the sides over the sines"@en ,
                     "Sinussatsen för en triangel med sidorna a, b, c och de motstående vinklarna A, B, C, skriven med sidorna i täljaren"@sv ;
    solid-memo:back "a/sin A = b/sin B = c/sin C"@zxx ;
    solid-memo:backNote "Each ratio equals 2R, R the radius of the circumscribed circle. Also written sin A/a = sin B/b = sin C/c."@en ,
                        "Varje kvot är lika med 2R, där R är den omskrivna cirkelns radie. Skrivs även sin A/a = sin B/b = sin C/c."@sv .

<#law-of-cosines>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Law of cosines for a triangle with sides a, b, c and the angle C opposite c"@en ,
                     "Cosinussatsen för en triangel med sidorna a, b, c och vinkeln C mitt emot sidan c"@sv ;
    solid-memo:back "c² = a² + b² − 2ab·cos C"@zxx ;
    solid-memo:backNote "With C = 90° it becomes the Pythagorean theorem."@en ,
                        "Med C = 90° övergår den i Pythagoras sats."@sv .

<#degree-in-radians>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "1° in radians"@en ,
                     "1° i radianer"@sv ;
    solid-memo:back "π/180 rad"@zxx ;
    solid-memo:backNote "≈ 0.0175 rad."@en ,
                        "≈ 0,0175 rad."@sv .

<#radian-in-degrees>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "1 rad in degrees"@en ,
                     "1 rad i grader"@sv ;
    solid-memo:back "(180/π)°"@zxx ;
    solid-memo:backNote "≈ 57.3°."@en ,
                        "≈ 57,3°."@sv .

<#degrees-180-in-radians>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "180° in radians"@en ,
                     "180° i radianer"@sv ;
    solid-memo:back "π rad"@zxx .

<#degrees-360-in-radians>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "360° (a full turn) in radians"@en ,
                     "360° (ett helt varv) i radianer"@sv ;
    solid-memo:back "2π rad"@zxx .

