<>
    a solid-memo:Deck ,
      dcat:Dataset ;
    dcterms:title "Classic novels"@en ,
                  "Klassiska romaner"@sv ;
    dcterms:creator <#anton-wiklund> ;
    dcterms:license <https://creativecommons.org/publicdomain/zero/1.0/> ;
    dcterms:description "82 famous novels first published before 1950: the novels in Wikidata (works whose form or genre is novel) that the most Wikipedia language editions and other Wikimedia sites cover. Front: the novel's title in English and Swedish; back: its author. Compiled from Wikidata and LIBRIS, the National Library of Sweden's catalogue, and checked against Wikipedia. A few works whose authorship is traditional or uncertain, such as three of the four classic Chinese novels, are left out. Sources, method and quality control: https://github.com/antwika/solid-memo/blob/main/packages/deck-library/authored/classic-novels.md"@en ,
                        "82 kända romaner som först gavs ut före 1950: de romaner i Wikidata (verk vars form eller genre är roman) som flest språkversioner av Wikipedia och andra Wikimediawebbplatser behandlar. Framsida: romanens titel på engelska och svenska; baksida: författaren. Sammanställd från Wikidata och Kungliga bibliotekets katalog LIBRIS och kontrollerad mot Wikipedia. Några verk vars författarskap är traditionellt tillskrivet eller osäkert, som tre av de fyra klassiska kinesiska romanerna, är inte med. Källor, metod och kvalitetskontroll: https://github.com/antwika/solid-memo/blob/main/packages/deck-library/authored/classic-novels.md"@sv ;
    prov:wasDerivedFrom <https://www.wikidata.org/> ,
                        <https://libris.kb.se/> ,
                        <https://zh.wikisource.org/wiki/紅樓夢（程甲本）> ;
    prov:wasGeneratedBy <#compilation> ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    dcat:theme <http://publications.europa.eu/resource/authority/data-theme/EDUC> ,
               topic:literature ;
    dcat:keyword "novels"@en ,
                 "literature"@en ,
                 "authors"@en ,
                 "classics"@en ,
                 "romaner"@sv ,
                 "litteratur"@sv ,
                 "författare"@sv ,
                 "klassiker"@sv ;
    dcterms:language <http://publications.europa.eu/resource/authority/language/ENG> ,
                     <http://publications.europa.eu/resource/authority/language/SWE> ;
    solid-memo:studyDirection solid-memo:frontToBack ;
    solid-memo:formatVersion 5 .

<#anton-wiklund>
    a foaf:Agent ;
    foaf:name "Anton Wiklund" ;
    foaf:mbox <mailto:antonwiklund91@gmail.com> .

<https://creativecommons.org/licenses/by-sa/4.0/>
    a dcterms:LicenseDocument .

<https://creativecommons.org/publicdomain/zero/1.0/>
    a dcterms:LicenseDocument .

# How this deck was made (W3C PROV-O): researched card by card from the sources below,
# each card checked against at least two of them. The full record is the provenance report.
<#compilation>
    a prov:Activity ;
    prov:endedAtTime "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    prov:used <https://www.wikidata.org/> ,
              <https://libris.kb.se/> ,
              <https://sv.wikipedia.org/> ,
              <https://en.wikipedia.org/> ,
              <https://zh.wikisource.org/wiki/紅樓夢（程甲本）> ;
    prov:wasAssociatedWith <#anton-wiklund> ,
                           <https://github.com/antwika/solid-memo/blob/main/packages/deck-library/scripts/authored_decks.py> ;
    rdfs:seeAlso <https://github.com/antwika/solid-memo/blob/main/packages/deck-library/authored/classic-novels.md> ;
    rdfs:comment "Compiled from the dossier authored/classic-novels.json, which records every source, the method, the quality-control rounds and the evidence for each card; built with python3 packages/deck-library/scripts/authored_decks.py build classic-novels." .

<https://github.com/antwika/solid-memo/blob/main/packages/deck-library/scripts/authored_decks.py>
    a prov:SoftwareAgent ;
    dcterms:title "authored_decks.py" .

<https://www.wikidata.org/>
    dcterms:title "Wikidata" ;
    dcterms:creator "Wikidata contributors" ;
    dcterms:license <https://creativecommons.org/publicdomain/zero/1.0/> .

<https://libris.kb.se/>
    dcterms:title "LIBRIS — the Swedish union catalogue (records of Swedish editions)" ;
    dcterms:creator "Kungliga biblioteket (National Library of Sweden)" ;
    dcterms:license <https://creativecommons.org/publicdomain/zero/1.0/> .

<https://sv.wikipedia.org/>
    dcterms:title "Svenskspråkiga Wikipedia" ;
    dcterms:creator "Wikipedia contributors" ;
    dcterms:license <https://creativecommons.org/licenses/by-sa/4.0/> .

<https://en.wikipedia.org/>
    dcterms:title "English Wikipedia" ;
    dcterms:creator "Wikipedia contributors" ;
    dcterms:license <https://creativecommons.org/licenses/by-sa/4.0/> .

<https://zh.wikisource.org/wiki/紅樓夢（程甲本）>
    dcterms:title "Prefaces to the first printed edition of Hongloumeng (Dream of the Red Chamber), 1791" ;
    dcterms:creator "Cheng Weiyuan and Gao E (transcription: Chinese Wikisource contributors)" .

