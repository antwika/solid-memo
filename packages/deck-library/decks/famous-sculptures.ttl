<>
    a solid-memo:Deck ,
      dcat:Dataset ;
    dcterms:title "Famous sculptures"@en ,
                  "Kända skulpturer"@sv ;
    dcterms:creator <#anton-wiklund> ;
    dcterms:license <https://creativecommons.org/publicdomain/zero/1.0/> ;
    dcterms:description "51 of the world's most famous sculptures, ranked by their number of Wikipedia and other Wikimedia sitelinks in Wikidata, from the Statue of Liberty and Michelangelo's David to Rodin's The Thinker and Louise Bourgeois's Maman (works of unknown, shared or disputed authorship left out). Front: the sculpture's title in English or Swedish, with the place or material, in brackets or in a note, where the title alone could mean another work; back: the sculptor, in the English or Swedish form of the name, with a note on collaborators or lost originals where it helps. Taken from Wikidata and checked against the English and Swedish Wikipedia, the holding museum or responsible authority where its website could be read and, for ancient works, Pliny and Pausanias. Sources, method and quality control: https://github.com/antwika/solid-memo/blob/main/packages/deck-library/authored/famous-sculptures.md"@en ,
                        "51 av världens mest kända skulpturer, rangordnade efter hur många länkar till Wikipedia och andra Wikimediaprojekt de har i Wikidata, från Frihetsgudinnan och Michelangelos David till Rodins Tänkaren och Louise Bourgeois Maman (verk med okänd, delad eller omstridd upphovsman ingår inte). Framsida: skulpturens titel på engelska eller svenska, med plats eller material, inom parentes eller i en anteckning, där titeln ensam kan syfta på ett annat verk; baksida: skulptören, med namnet i engelsk eller svensk form och en anteckning om medarbetare eller förlorade original där den hjälper. Uppgifterna är hämtade från Wikidata och kontrollerade mot engelska och svenska Wikipedia, museet eller den ansvariga myndigheten där webbplatsen gick att läsa och, för antika verk, Plinius och Pausanias. Källor, metod och kvalitetskontroll: https://github.com/antwika/solid-memo/blob/main/packages/deck-library/authored/famous-sculptures.md"@sv ;
    prov:wasDerivedFrom <https://www.wikidata.org/wiki/Q860861> ;
    prov:wasGeneratedBy <#compilation> ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    dcat:theme <http://publications.europa.eu/resource/authority/data-theme/EDUC> ,
               topic:art ;
    dcat:keyword "sculpture"@en ,
                 "sculptors"@en ,
                 "art history"@en ,
                 "statues"@en ,
                 "monuments"@en ,
                 "skulptur"@sv ,
                 "skulptörer"@sv ,
                 "bildhuggare"@sv ,
                 "konsthistoria"@sv ,
                 "statyer"@sv ,
                 "monument"@sv ;
    dcterms:language <http://publications.europa.eu/resource/authority/language/ENG> ,
                     <http://publications.europa.eu/resource/authority/language/SWE> ;
    solid-memo:studyDirection solid-memo:frontToBack ;
    solid-memo:formatVersion 5 .

