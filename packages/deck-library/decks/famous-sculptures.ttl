<#statue-of-liberty>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Statue of Liberty"@en ,
                     "Frihetsgudinnan"@sv ;
    solid-memo:back "Frédéric Auguste Bartholdi"@en ,
                    "Auguste Bartholdi"@sv ;
    solid-memo:backNote "Gustave Eiffel built its internal metal framework and Richard Morris Hunt designed the pedestal."@en ,
                        "Gustave Eiffel byggde dess inre metallstomme och Richard Morris Hunt ritade sockeln."@sv .

<#colossus-of-rhodes>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Colossus of Rhodes"@en ,
                     "Kolossen på Rhodos"@sv ;
    solid-memo:back "Chares of Lindos"@en ,
                    "Chares från Lindos"@sv ;
    solid-memo:backNote "Lost: it fell in an earthquake in the 220s BC (most often dated 226 BC). The attribution comes from ancient writers such as Pliny the Elder."@en ,
                        "Förlorad: den föll vid en jordbävning på 220-talet f.Kr. (oftast daterad till 226 f.Kr.). Tillskrivningen kommer från antika författare som Plinius den äldre."@sv .

<#statue-of-zeus-at-olympia>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Statue of Zeus at Olympia"@en ,
                     "Zeusstatyn i Olympia"@sv ;
    solid-memo:back "Phidias"@en ,
                    "Fidias"@sv ;
    solid-memo:backNote "Lost: destroyed in late antiquity, known only from descriptions and from images on coins and in other art."@en ,
                        "Förlorad: förstörd under senantiken, känd bara från beskrivningar och avbildningar på mynt och i annan konst."@sv .

