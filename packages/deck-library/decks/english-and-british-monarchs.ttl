<>
    a solid-memo:Deck ,
      dcat:Dataset ;
    dcterms:title "English and British monarchs"@en ,
                  "Englands och Storbritanniens monarker"@sv ;
    dcterms:creator <#anton-wiklund> ;
    dcterms:license <https://creativecommons.org/publicdomain/zero/1.0/> ;
    dcterms:description "The 42 monarchs of England from William I (1066), of Great Britain from 1707 and of the United Kingdom from 1801, to Charles III. Front: the monarch's regnal name in English and Swedish; back: the years of the reign, counted from accession rather than coronation, with both periods for the two kings who reigned twice (a single year means the whole reign fell within that year); a note gives the royal house. Disputed claimants (Empress Matilda, Lady Jane Grey) are not counted, William III and Mary II have a card each, and there was no monarch during the Interregnum of 1649–1660. Based on Wikidata and the 1911 Encyclopædia Britannica (public domain), and checked against the Royal Household's website (royal.uk) and Wikipedia. Sources, method and quality control: https://github.com/antwika/solid-memo/blob/main/packages/deck-library/authored/english-and-british-monarchs.md"@en ,
                        "De 42 monarkerna i England från Vilhelm I (1066), i Storbritannien från 1707 och i Förenade kungariket från 1801, fram till Charles III. Framsida: monarkens regentnamn på engelska och svenska; baksida: regeringsåren, räknade från trontillträdet och inte från kröningen, med båda perioderna för de två kungar som regerade två gånger (ett enda årtal betyder att hela regeringstiden föll inom det året); en anteckning anger kungahuset. Omstridda tronpretendenter (kejsarinnan Matilda, Jane Grey) räknas inte, Vilhelm III och Maria II har ett kort var, och under interregnumet 1649–1660 fanns ingen monark. Uppgifterna bygger på Wikidata och 1911 års upplaga av Encyclopædia Britannica (fri från upphovsrätt) och är kontrollerade mot det brittiska kungahusets webbplats (royal.uk) och Wikipedia. Källor, metod och kvalitetskontroll: https://github.com/antwika/solid-memo/blob/main/packages/deck-library/authored/english-and-british-monarchs.md"@sv ;
    prov:wasDerivedFrom <https://www.wikidata.org/wiki/Q18810062> ,
                        <https://en.wikisource.org/wiki/1911_Encyclop%C3%A6dia_Britannica> ;
    prov:wasGeneratedBy <#compilation> ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    dcat:theme <http://publications.europa.eu/resource/authority/data-theme/EDUC> ,
               topic:history ;
    dcat:keyword "English monarchs"@en ,
                 "British monarchs"@en ,
                 "kings and queens of England"@en ,
                 "royal houses"@en ,
                 "British history"@en ,
                 "engelska monarker"@sv ,
                 "brittiska monarker"@sv ,
                 "Englands kungar och drottningar"@sv ,
                 "kungahus"@sv ,
                 "brittisk historia"@sv ;
    dcterms:language <http://publications.europa.eu/resource/authority/language/ENG> ,
                     <http://publications.europa.eu/resource/authority/language/SWE> ;
    solid-memo:studyDirection solid-memo:bidirectional ;
    solid-memo:formatVersion 5 .

