<>
    a solid-memo:Deck ,
      dcat:Dataset ;
    dcterms:title "Basic German"@en ,
                  "Grundläggande tyska"@sv ;
    dcterms:creator <#anton-wiklund> ;
    dcterms:license <https://creativecommons.org/publicdomain/zero/1.0/> ;
    dcterms:description "125 basic German words and phrases for beginners: the numbers 0–20, the tens and 100, the days of the week, the months, eight colours, family members, greetings and polite phrases, and everyday nouns, adjectives and verbs. The front shows the German word in current spelling; nouns, days and months are given with their definite article (der Tisch, die Tür, das Buch). The back gives its English and Swedish meaning, or the digits for a number, with the plural of most nouns in a note. Words, genders and meanings from Wikidata's lexemes and a public-domain US Government course and phrase book (the Foreign Service Institute's German Basic Course and the War Department's German Phrase Book), checked against German and English Wiktionary, Folkets lexikon and the official German spelling rules. Sources, method and quality control: https://github.com/antwika/solid-memo/blob/main/packages/deck-library/authored/german-basics.md"@en ,
                        "125 grundläggande tyska ord och fraser för nybörjare: talen 0–20, tiotalen och 100, veckodagarna, månaderna, åtta färger, familjemedlemmar, hälsningar och artighetsfraser samt vardagliga substantiv, adjektiv och verb. Framsidan visar det tyska ordet i nutida stavning; substantiv, veckodagar och månader står med bestämd artikel (der Tisch, die Tür, das Buch). Baksidan ger betydelsen på engelska och svenska, eller siffrorna för ett tal, och de flesta substantiv har pluralformen i en anteckning. Ord, genus och betydelser från Wikidatas lexem och en amerikansk statlig kurs och parlör fria från upphovsrätt (Foreign Service Institutes German Basic Course och krigsdepartementets German Phrase Book), kontrollerade mot tyska och engelska Wiktionary, Folkets lexikon och de officiella tyska stavningsreglerna. Källor, metod och kvalitetskontroll: https://github.com/antwika/solid-memo/blob/main/packages/deck-library/authored/german-basics.md"@sv ;
    prov:wasDerivedFrom <https://www.wikidata.org/> ,
                        <https://archive.org/details/Fsi-GermanBasicCourse-StudentText> ,
                        <https://archive.org/details/GermanPhraseBook> ;
    prov:wasGeneratedBy <#compilation> ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    dcat:theme <http://publications.europa.eu/resource/authority/data-theme/EDUC> ,
               topic:languages ,
               topic:german ;
    dcat:keyword "German" ,
                 "vocabulary" ,
                 "beginners" ,
                 "phrases" ,
                 "tyska" ,
                 "ordförråd" ,
                 "nybörjare" ,
                 "fraser" ;
    dcterms:language <http://publications.europa.eu/resource/authority/language/ENG> ,
                     <http://publications.europa.eu/resource/authority/language/SWE> ,
                     <http://publications.europa.eu/resource/authority/language/DEU> ;
    solid-memo:studyDirection solid-memo:frontToBack ;
    solid-memo:formatVersion 4 .

