<>
    a solid-memo:Deck ,
      dcat:Dataset ;
    dcterms:title "The Solar System"@en ,
                  "Solsystemet"@sv ;
    dcterms:creator <#anton-wiklund> ;
    dcterms:license <https://creativecommons.org/publicdomain/zero/1.0/> ;
    dcterms:description "52 cards on stable facts about the Solar System: the eight planets in order from the Sun, the five dwarf planets the IAU recognises and where they orbit, the largest moon of each planet that has moons, which planet (or, for Charon, dwarf planet) 16 well-known moons orbit, and undisputed superlatives such as the largest, hottest and densest planet. Front: a question or description, e.g. \"4th planet from the Sun\"; back: the planet, moon or place in English and Swedish, with a note where it helps. Facts from NASA Science and Wikidata, checked against JPL's Solar System Dynamics tables, the IAU and the Swedish Wikipedia. Sources, method and quality control: https://github.com/antwika/solid-memo/blob/main/packages/deck-library/authored/solar-system.md"@en ,
                        "52 kort med beständiga fakta om solsystemet: de åtta planeterna i ordning från solen, de fem dvärgplaneter som IAU erkänner och var de kretsar, den största månen hos varje planet som har månar, vilken planet (för Charon dvärgplanet) 16 välkända månar kretsar kring och obestridda fakta om vilken planet som är störst, hetast, tätast och så vidare. Framsida: en fråga eller beskrivning, t.ex. ”Fjärde planeten från solen”; baksida: planeten, månen eller platsen på engelska och svenska, med en anteckning där den hjälper. Uppgifterna kommer från NASA Science och Wikidata och är kontrollerade mot JPL:s tabeller (Solar System Dynamics), IAU och den svenskspråkiga Wikipedia. Källor, metod och kvalitetskontroll: https://github.com/antwika/solid-memo/blob/main/packages/deck-library/authored/solar-system.md"@sv ;
    prov:wasDerivedFrom <https://science.nasa.gov/solar-system/> ,
                        <https://www.wikidata.org/wiki/Q544> ;
    prov:wasGeneratedBy <#compilation> ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    dcat:theme <http://publications.europa.eu/resource/authority/data-theme/EDUC> ,
               topic:astronomy ;
    dcat:keyword "Solar System" ,
                 "planets" ,
                 "dwarf planets" ,
                 "moons" ,
                 "astronomy" ,
                 "solsystemet" ,
                 "planeter" ,
                 "dvärgplaneter" ,
                 "månar" ,
                 "astronomi" ;
    dcterms:language <http://publications.europa.eu/resource/authority/language/ENG> ,
                     <http://publications.europa.eu/resource/authority/language/SWE> ;
    solid-memo:studyDirection solid-memo:frontToBack ;
    solid-memo:formatVersion 4 .

