<#dwarf-planet-ceres>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Where does the dwarf planet Ceres orbit?"@en ,
                     "Var kretsar dvärgplaneten Ceres?"@sv ;
    solid-memo:back "In the asteroid belt, between Mars and Jupiter"@en ,
                    "I asteroidbältet, mellan Mars och Jupiter"@sv .

<#dwarf-planet-pluto>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Where does the dwarf planet Pluto orbit?"@en ,
                     "Var kretsar dvärgplaneten Pluto?"@sv ;
    solid-memo:back "In the Kuiper Belt, beyond Neptune"@en ,
                    "I Kuiperbältet, bortom Neptunus"@sv ;
    solid-memo:backNote "Its elongated orbit sometimes brings it closer to the Sun than Neptune, most recently in 1979–1999."@en ,
                        "Den långsträckta banan för den ibland närmare solen än Neptunus, senast 1979–1999."@sv .

