<#select-all>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Select every column of every row in the table customers"@en ,
                     "Hämta alla kolumner för alla rader i tabellen customers"@sv ;
    solid-memo:back "SELECT * FROM customers;"@zxx .

<#select-columns>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Select the columns name and city, in that order, of every row in customers"@en ,
                     "Hämta kolumnerna name och city, i den ordningen, för alla rader i customers"@sv ;
    solid-memo:back "SELECT name, city FROM customers;"@zxx .

<#select-distinct>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Select the column city of customers with duplicate values removed"@en ,
                     "Hämta kolumnen city i customers med dubbletter borttagna"@sv ;
    solid-memo:back "SELECT DISTINCT city FROM customers;"@zxx ;
    solid-memo:backNote "Rows where city is NULL give one NULL row in the result."@en ,
                        "Rader där city är NULL ger en enda NULL-rad i resultatet."@sv .

<#column-alias>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Select the column name of customers, renamed customer_name in the result"@en ,
                     "Hämta kolumnen name i customers, med namnet customer_name i resultatet"@sv ;
    solid-memo:back "SELECT name AS customer_name FROM customers;"@zxx ;
    solid-memo:backNote "AS may be left out in SQLite and PostgreSQL; this deck always writes it."@en ,
                        "AS kan utelämnas i SQLite och PostgreSQL; den här kortleken skriver alltid ut det."@sv .

<#table-alias>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Select the column name of customers, giving the table the alias c and naming the column through it"@en ,
                     "Hämta kolumnen name i customers, med aliaset c för tabellen och kolumnen angiven via aliaset"@sv ;
    solid-memo:back "SELECT c.name FROM customers AS c;"@zxx ;
    solid-memo:backNote "AS may be left out here too: FROM customers c."@en ,
                        "AS kan utelämnas även här: FROM customers c."@sv .

<#where-equals>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Select every column of the rows in customers where city is Lund"@en ,
                     "Hämta alla kolumner för raderna i customers där city är Lund"@sv ;
    solid-memo:back "SELECT * FROM customers WHERE city = 'Lund';"@zxx .

<#where-not-equal>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Select every column of the rows in customers where city is not Lund"@en ,
                     "Hämta alla kolumner för raderna i customers där city inte är Lund"@sv ;
    solid-memo:back "SELECT * FROM customers WHERE city <> 'Lund';"@zxx ;
    solid-memo:backNote "!= also works in SQLite and PostgreSQL. Rows where city is NULL are not returned."@en ,
                        "!= fungerar också i SQLite och PostgreSQL. Rader där city är NULL kommer inte med."@sv .

<#where-and>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Select every column of the rows in products where category is books and price is below 100"@en ,
                     "Hämta alla kolumner för raderna i products där category är books och price är under 100"@sv ;
    solid-memo:back "SELECT * FROM products WHERE category = 'books' AND price < 100;"@zxx .

<#where-or>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Select every column of the rows in customers where city is Lund or country is Norway"@en ,
                     "Hämta alla kolumner för raderna i customers där city är Lund eller country är Norway"@sv ;
    solid-memo:back "SELECT * FROM customers WHERE city = 'Lund' OR country = 'Norway';"@zxx .

<#in-list>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Select every column of the rows in customers where country is one of Sweden, Norway and Denmark, using a list of values"@en ,
                     "Hämta alla kolumner för raderna i customers där country är något av Sweden, Norway och Denmark, med en värdelista"@sv ;
    solid-memo:back "SELECT * FROM customers WHERE country IN ('Sweden', 'Norway', 'Denmark');"@zxx ;
    solid-memo:backNote "The same as three conditions joined with OR."@en ,
                        "Samma sak som tre villkor förenade med OR."@sv .

<#between>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Select every column of the rows in products where price is from 100 to 200, both included, using one range test"@en ,
                     "Hämta alla kolumner för raderna i products där price är från 100 till 200, båda inräknade, med ett enda intervallvillkor"@sv ;
    solid-memo:back "SELECT * FROM products WHERE price BETWEEN 100 AND 200;"@zxx ;
    solid-memo:backNote "BETWEEN includes both ends: price >= 100 AND price <= 200."@en ,
                        "BETWEEN tar med båda gränserna: price >= 100 AND price <= 200."@sv .

<#like-prefix>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Select every column of the rows in customers where name begins with the letter A, using LIKE"@en ,
                     "Hämta alla kolumner för raderna i customers där name börjar med bokstaven A, med LIKE"@sv ;
    solid-memo:back "SELECT * FROM customers WHERE name LIKE 'A%';"@zxx ;
    solid-memo:backNote "% stands for any run of characters. In SQLite this also matches a lower-case a, because SQLite's LIKE ignores the case of ASCII letters; PostgreSQL's LIKE is case-sensitive, and PostgreSQL has ILIKE for case-insensitive matching."@en ,
                        "% står för en godtycklig följd av tecken. I SQLite matchar detta också ett litet a, eftersom LIKE i SQLite bortser från skillnaden mellan stora och små ASCII-bokstäver; LIKE i PostgreSQL skiljer på dem, och PostgreSQL har ILIKE för matchning utan hänsyn till skiftläge."@sv .

<#like-contains>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Select every column of the rows in customers where email contains example"@en ,
                     "Hämta alla kolumner för raderna i customers där email innehåller example"@sv ;
    solid-memo:back "SELECT * FROM customers WHERE email LIKE '%example%';"@zxx .

<#is-null>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Select every column of the rows in customers where email is NULL"@en ,
                     "Hämta alla kolumner för raderna i customers där email är NULL"@sv ;
    solid-memo:back "SELECT * FROM customers WHERE email IS NULL;"@zxx ;
    solid-memo:backNote "email = NULL matches no row: a comparison with NULL is unknown, never true."@en ,
                        "email = NULL träffar ingen rad: en jämförelse med NULL blir okänd, aldrig sann."@sv .

<#is-not-null>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Select every column of the rows in customers where email is not NULL"@en ,
                     "Hämta alla kolumner för raderna i customers där email inte är NULL"@sv ;
    solid-memo:back "SELECT * FROM customers WHERE email IS NOT NULL;"@zxx .

<#order-by>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Select every column of every row in customers, sorted by name in ascending order"@en ,
                     "Hämta alla kolumner för alla rader i customers, sorterade stigande efter name"@sv ;
    solid-memo:back "SELECT * FROM customers ORDER BY name;"@zxx ;
    solid-memo:backNote "Ascending is the default; ASC may be written out."@en ,
                        "Stigande ordning är standard; ASC kan skrivas ut."@sv .

<#order-by-desc>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Select every column of every row in products, sorted by price in descending order"@en ,
                     "Hämta alla kolumner för alla rader i products, sorterade fallande efter price"@sv ;
    solid-memo:back "SELECT * FROM products ORDER BY price DESC;"@zxx .

<#order-by-two>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Select every column of every row in customers, sorted in ascending order by country and then by name"@en ,
                     "Hämta alla kolumner för alla rader i customers, sorterade stigande först efter country och sedan efter name"@sv ;
    solid-memo:back "SELECT * FROM customers ORDER BY country, name;"@zxx .

<#limit>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Select every column of the 3 rows in products with the highest price"@en ,
                     "Hämta alla kolumner för de 3 rader i products som har högst price"@sv ;
    solid-memo:back "SELECT * FROM products ORDER BY price DESC LIMIT 3;"@zxx ;
    solid-memo:backNote "FETCH FIRST 3 ROWS ONLY in place of LIMIT 3 also works in PostgreSQL, but not in SQLite."@en ,
                        "FETCH FIRST 3 ROWS ONLY i stället för LIMIT 3 fungerar också i PostgreSQL, men inte i SQLite."@sv .

<#limit-offset>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Select every column of the rows in products sorted by name in ascending order, skipping the first 3 rows and returning the next 3"@en ,
                     "Hämta alla kolumner för raderna i products sorterade stigande efter name, men hoppa över de 3 första raderna och returnera de 3 följande"@sv ;
    solid-memo:back "SELECT * FROM products ORDER BY name LIMIT 3 OFFSET 3;"@zxx ;
    solid-memo:backNote "OFFSET 3 ROWS FETCH NEXT 3 ROWS ONLY in place of LIMIT 3 OFFSET 3 also works in PostgreSQL, but not in SQLite."@en ,
                        "OFFSET 3 ROWS FETCH NEXT 3 ROWS ONLY i stället för LIMIT 3 OFFSET 3 fungerar också i PostgreSQL, men inte i SQLite."@sv .

<#count-rows>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Count the rows in customers"@en ,
                     "Räkna raderna i customers"@sv ;
    solid-memo:back "SELECT COUNT(*) FROM customers;"@zxx .

<#count-column>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Count the values in the column email of customers that are not NULL, without a WHERE clause"@en ,
                     "Räkna de värden i kolumnen email i customers som inte är NULL, utan WHERE-villkor"@sv ;
    solid-memo:back "SELECT COUNT(email) FROM customers;"@zxx ;
    solid-memo:backNote "COUNT(column) skips NULLs; COUNT(*) counts every row."@en ,
                        "COUNT(kolumn) hoppar över NULL; COUNT(*) räknar alla rader."@sv .

<#count-distinct>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Count the different values in the column city of customers"@en ,
                     "Räkna de olika värdena i kolumnen city i customers"@sv ;
    solid-memo:back "SELECT COUNT(DISTINCT city) FROM customers;"@zxx ;
    solid-memo:backNote "NULL is not counted."@en ,
                        "NULL räknas inte."@sv .

<#sum>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Add up the column total over every row in orders"@en ,
                     "Summera kolumnen total över alla rader i orders"@sv ;
    solid-memo:back "SELECT SUM(total) FROM orders;"@zxx .

<#avg>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Compute the average of the column price over every row in products"@en ,
                     "Beräkna medelvärdet av kolumnen price över alla rader i products"@sv ;
    solid-memo:back "SELECT AVG(price) FROM products;"@zxx .

<#max>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Find the highest value in the column price of products using an aggregate function"@en ,
                     "Ta fram det högsta värdet i kolumnen price i products med en mängdfunktion"@sv ;
    solid-memo:back "SELECT MAX(price) FROM products;"@zxx ;
    solid-memo:backNote "MIN(price) gives the lowest."@en ,
                        "MIN(price) ger det lägsta."@sv .

<#group-by-count>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Select each value of city in customers with the number of rows that have it"@en ,
                     "Hämta varje värde i city i customers med antalet rader som har det värdet"@sv ;
    solid-memo:back "SELECT city, COUNT(*) FROM customers GROUP BY city;"@zxx .

<#group-by-sum>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Select each value of customer_id in orders with the sum of total for that value"@en ,
                     "Hämta varje värde i customer_id i orders med summan av total för det värdet"@sv ;
    solid-memo:back "SELECT customer_id, SUM(total) FROM orders GROUP BY customer_id;"@zxx .

<#having>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Select each value of city in customers with its number of rows, keeping only the cities that occur more than once"@en ,
                     "Hämta varje värde i city i customers med dess antal rader, men behåll bara de städer som förekommer mer än en gång"@sv ;
    solid-memo:back "SELECT city, COUNT(*) FROM customers GROUP BY city HAVING COUNT(*) > 1;"@zxx ;
    solid-memo:backNote "HAVING filters groups; an aggregate such as COUNT(*) is not allowed in WHERE."@en ,
                        "HAVING filtrerar grupper; en mängdfunktion som COUNT(*) är inte tillåten i WHERE."@sv .

<#where-group-by>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Select each value of category in products that has rows with price above 100, with the number of those rows"@en ,
                     "Hämta varje värde i category i products som har rader där price är över 100, med antalet sådana rader"@sv ;
    solid-memo:back "SELECT category, COUNT(*) FROM products WHERE price > 100 GROUP BY category;"@zxx ;
    solid-memo:backNote "WHERE filters rows before they are grouped, so a category with no such row does not appear."@en ,
                        "WHERE filtrerar rader innan de grupperas, så en kategori utan sådana rader kommer inte med."@sv .

<#inner-join>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Select orders.id and customers.name for every order that has a matching customer, joining orders to customers on orders.customer_id = customers.id"@en ,
                     "Hämta orders.id och customers.name för varje order som har en matchande kund, genom att koppla orders till customers med orders.customer_id = customers.id"@sv ;
    solid-memo:back "SELECT orders.id, customers.name FROM orders INNER JOIN customers ON orders.customer_id = customers.id;"@zxx ;
    solid-memo:backNote "INNER may be left out: JOIN alone is an inner join."@en ,
                        "INNER kan utelämnas: JOIN ensamt ger en inre koppling."@sv .

<#left-join>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Select customers.name and orders.id for every customer, including customers with no order, joining customers to orders on customers.id = orders.customer_id"@en ,
                     "Hämta customers.name och orders.id för varje kund, även kunder utan order, genom att koppla customers till orders med customers.id = orders.customer_id"@sv ;
    solid-memo:back "SELECT customers.name, orders.id FROM customers LEFT JOIN orders ON customers.id = orders.customer_id;"@zxx ;
    solid-memo:backNote "Customers with no order get NULL as orders.id. LEFT OUTER JOIN means the same."@en ,
                        "Kunder utan order får NULL som orders.id. LEFT OUTER JOIN betyder samma sak."@sv .

<#subquery-in>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Select every column of the rows in customers whose id is among the customer_id values in orders, using a subquery"@en ,
                     "Hämta alla kolumner för raderna i customers vars id finns bland värdena i customer_id i orders, med en underfråga"@sv ;
    solid-memo:back "SELECT * FROM customers WHERE id IN (SELECT customer_id FROM orders);"@zxx ;
    solid-memo:backNote "WHERE EXISTS (SELECT 1 FROM orders WHERE orders.customer_id = customers.id) gives the same rows."@en ,
                        "WHERE EXISTS (SELECT 1 FROM orders WHERE orders.customer_id = customers.id) ger samma rader."@sv .

<#subquery-scalar>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Select every column of the rows in products whose price is above the average price of all products, using a subquery"@en ,
                     "Hämta alla kolumner för raderna i products där price är högre än medelvärdet av price för alla rader, med en underfråga"@sv ;
    solid-memo:back "SELECT * FROM products WHERE price > (SELECT AVG(price) FROM products);"@zxx .

<#insert>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Add a row to customers with id 8 and name Gustav, naming only those two columns"@en ,
                     "Lägg till en rad i customers med id 8 och name Gustav, där bara de två kolumnerna anges"@sv ;
    solid-memo:back "INSERT INTO customers (id, name) VALUES (8, 'Gustav');"@zxx ;
    solid-memo:backNote "Columns not named get their default value, here NULL."@en ,
                        "Kolumner som inte anges får sitt standardvärde, här NULL."@sv .

<#insert-many>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Add two rows to customers in one statement, id 8 with name Gustav and id 9 with name Hanna, naming only the columns id and name"@en ,
                     "Lägg till två rader i customers med en enda sats, id 8 med name Gustav och id 9 med name Hanna, där bara kolumnerna id och name anges"@sv ;
    solid-memo:back "INSERT INTO customers (id, name) VALUES (8, 'Gustav'), (9, 'Hanna');"@zxx .

<#update>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Set city to Lund in the row of customers whose id is 2"@en ,
                     "Sätt city till Lund i den rad i customers vars id är 2"@sv ;
    solid-memo:back "UPDATE customers SET city = 'Lund' WHERE id = 2;"@zxx ;
    solid-memo:backNote "Without WHERE, UPDATE changes every row."@en ,
                        "Utan WHERE ändrar UPDATE alla rader."@sv .

<#update-expression>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Multiply price by 1.1 in every row of products"@en ,
                     "Multiplicera price med 1,1 i alla rader i products"@sv ;
    solid-memo:back "UPDATE products SET price = price * 1.1;"@zxx ;
    solid-memo:backNote "In SQLite the result can be inexact: in the deck's example table, where price is NUMERIC(10, 2), 200 becomes 220.00000000000003."@en ,
                        "I SQLite kan resultatet bli inexakt: i kortlekens exempeltabell, där price är NUMERIC(10, 2), ändras 200 till 220,00000000000003."@sv .

<#delete>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Delete the row of customers whose id is 5"@en ,
                     "Ta bort den rad i customers vars id är 5"@sv ;
    solid-memo:back "DELETE FROM customers WHERE id = 5;"@zxx .

<#delete-all>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Delete every row of orders but keep the table"@en ,
                     "Ta bort alla rader i orders men behåll tabellen"@sv ;
    solid-memo:back "DELETE FROM orders;"@zxx ;
    solid-memo:backNote "PostgreSQL also has TRUNCATE orders; SQLite has no TRUNCATE."@en ,
                        "PostgreSQL har också TRUNCATE orders; SQLite saknar TRUNCATE."@sv .

<#create-table>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Create a table customers with an INTEGER column id as its primary key and a TEXT column name that must not be NULL"@en ,
                     "Skapa en tabell customers med en INTEGER-kolumn id som primärnyckel och en TEXT-kolumn name som inte får vara NULL"@sv ;
    solid-memo:back "CREATE TABLE customers (id INTEGER PRIMARY KEY, name TEXT NOT NULL);"@zxx ;
    solid-memo:backNote "VARCHAR(100) in place of TEXT is accepted by both too."@en ,
                        "VARCHAR(100) i stället för TEXT godtas också av båda."@sv .

<#create-table-fk>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Create a table orders with an INTEGER column id as its primary key and an INTEGER column customer_id that references id in customers"@en ,
                     "Skapa en tabell orders med en INTEGER-kolumn id som primärnyckel och en INTEGER-kolumn customer_id som refererar till id i customers"@sv ;
    solid-memo:back "CREATE TABLE orders (id INTEGER PRIMARY KEY, customer_id INTEGER REFERENCES customers (id));"@zxx ;
    solid-memo:backNote "SQLite enforces the reference only after PRAGMA foreign_keys = ON;"@en ,
                        "SQLite kontrollerar referensen först efter PRAGMA foreign_keys = ON;"@sv .

<#alter-add-column>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Add a TEXT column phone to the table customers"@en ,
                     "Lägg till en TEXT-kolumn phone i tabellen customers"@sv ;
    solid-memo:back "ALTER TABLE customers ADD COLUMN phone TEXT;"@zxx ;
    solid-memo:backNote "The word COLUMN may be left out."@en ,
                        "Ordet COLUMN kan utelämnas."@sv .

<#alter-rename-column>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Rename the column name of the table customers to full_name"@en ,
                     "Byt namn på kolumnen name i tabellen customers till full_name"@sv ;
    solid-memo:back "ALTER TABLE customers RENAME COLUMN name TO full_name;"@zxx .

<#alter-drop-column>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Remove the column email from the table customers"@en ,
                     "Ta bort kolumnen email ur tabellen customers"@sv ;
    solid-memo:back "ALTER TABLE customers DROP COLUMN email;"@zxx .

<#drop-table>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Remove the table orders together with all its rows"@en ,
                     "Ta bort tabellen orders med alla dess rader"@sv ;
    solid-memo:back "DROP TABLE orders;"@zxx ;
    solid-memo:backNote "DROP TABLE IF EXISTS orders; gives no error if the table is missing."@en ,
                        "DROP TABLE IF EXISTS orders; ger inget fel om tabellen saknas."@sv .

<#create-index>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Create an index named idx_customers_city on the column city of customers"@en ,
                     "Skapa ett index med namnet idx_customers_city på kolumnen city i customers"@sv ;
    solid-memo:back "CREATE INDEX idx_customers_city ON customers (city);"@zxx ;
    solid-memo:backNote "CREATE UNIQUE INDEX also forbids duplicate values."@en ,
                        "CREATE UNIQUE INDEX förbjuder dessutom dubbletter."@sv .

<#drop-index>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Remove the index idx_customers_city"@en ,
                     "Ta bort indexet idx_customers_city"@sv ;
    solid-memo:back "DROP INDEX idx_customers_city;"@zxx .
