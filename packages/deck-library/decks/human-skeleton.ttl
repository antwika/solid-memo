                     "halskotor"@sv ;
    solid-memo:back "Vertebrae cervicales"@la ;
    solid-memo:backNote "The seven vertebrae of the neck."@en ,
                        "Halsens sju kotor."@sv .

<#thoracic-vertebrae>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
