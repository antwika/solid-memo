                     "skalle"@sv ;
    solid-memo:back "Cranium"@la ;
    solid-memo:backNote "The bones of the head as a whole."@en ,
                        "Huvudets ben som helhet."@sv .

<#frontal-bone>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
