# How this deck was made (W3C PROV-O): researched card by card from the sources below,
# each card checked against at least two of them. The full record is the provenance report.
<#compilation>
    a prov:Activity ;
    prov:endedAtTime "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    prov:used <https://www.wikidata.org/wiki/Q41176> ,
              <https://en.wikipedia.org/wiki/Architecture> ,
              <https://sv.wikipedia.org/wiki/Arkitektur> ,
              <https://www.nps.gov/places/white-house.htm> ,
              <https://www.kungligaslotten.se/english/royal-palaces-and-sites/drottningholm-palace/history.html> ,
              <https://www.teatroallascala.org/en/the-theater/history.html> ,
              <https://www.guggenheim-bilbao.eus/en/the-building> ,
              <https://fallingwater.org/history/the-kaufmanns-fallingwater/designing-fallingwater/> ,
              <https://pt.wikipedia.org/wiki/Mirante_do_Vale> ,
              <https://www.vatican.va/content/vatican/it/ra/cappella-sistina.html> ;
    prov:wasAssociatedWith <#anton-wiklund> ,
                           <https://github.com/antwika/solid-memo/blob/main/packages/deck-library/scripts/authored_decks.py> ;
    rdfs:seeAlso <https://github.com/antwika/solid-memo/blob/main/packages/deck-library/authored/famous-buildings.md> ;
    rdfs:comment "Compiled from the dossier authored/famous-buildings.json, which records every source, the method, the quality-control rounds and the evidence for each card; built with python3 packages/deck-library/scripts/authored_decks.py build famous-buildings." .

<https://github.com/antwika/solid-memo/blob/main/packages/deck-library/scripts/authored_decks.py>
    a prov:SoftwareAgent ;
    dcterms:title "authored_decks.py" .

<https://www.wikidata.org/wiki/Q41176>
    dcterms:title "Wikidata: buildings (Q41176 and its subclasses) with an architect (P84), their sitelinks, architects and English and Swedish labels" ;
