<>
    a solid-memo:Deck ,
      dcat:Dataset ;
    dcterms:title "Famous buildings"@en ,
                  "Kända byggnader"@sv ;
    dcterms:creator <#anton-wiklund> ;
    dcterms:license <https://creativecommons.org/publicdomain/zero/1.0/> ;
    dcterms:description "50 famous buildings and their architects: 39 of the world's best-known, ranked by their number of Wikipedia and other Wikimedia sitelinks in Wikidata, from Hagia Sophia and the White House to Fallingwater, and 11 Nordic buildings ranked the same way, from Drottningholm Palace to Stockholm City Hall (buildings of unknown, collective or disputed authorship left out). Front: the building, in English or Swedish, with its city where that helps; back: its architect or pair of architects, with a note on those who completed it. Taken from Wikidata and checked against the English and Swedish Wikipedia and official sites. Sources, method and quality control: https://github.com/antwika/solid-memo/blob/main/packages/deck-library/authored/famous-buildings.md"@en ,
                        "50 kända byggnader och deras arkitekter: 39 av världens mest kända, rangordnade efter hur många länkar till Wikipedia och andra Wikimediaprojekt de har i Wikidata, från Hagia Sofia och Vita huset till Fallingwater, och 11 nordiska byggnader rangordnade på samma sätt, från Drottningholms slott till Stockholms stadshus (byggnader med okänd, kollektiv eller omstridd upphovsman ingår inte). Framsida: byggnaden, på engelska eller svenska, med staden där det hjälper; baksida: arkitekten eller arkitektparet, med en anteckning om dem som fullbordade bygget. Uppgifterna är hämtade från Wikidata och kontrollerade mot engelska och svenska Wikipedia och officiella webbplatser. Källor, metod och kvalitetskontroll: https://github.com/antwika/solid-memo/blob/main/packages/deck-library/authored/famous-buildings.md"@sv ;
    prov:wasDerivedFrom <https://www.wikidata.org/wiki/Q41176> ;
    prov:wasGeneratedBy <#compilation> ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    dcat:theme <http://publications.europa.eu/resource/authority/data-theme/EDUC> ,
               topic:art ,
               topic:history ;
    dcat:keyword "architecture"@en ,
                 "architects"@en ,
                 "buildings"@en ,
                 "art history"@en ,
                 "landmarks"@en ,
                 "arkitektur"@sv ,
                 "arkitekter"@sv ,
                 "byggnader"@sv ,
                 "konsthistoria"@sv ,
                 "sevärdheter"@sv ;
    dcterms:language <http://publications.europa.eu/resource/authority/language/ENG> ,
                     <http://publications.europa.eu/resource/authority/language/SWE> ;
    solid-memo:studyDirection solid-memo:frontToBack ;
    solid-memo:formatVersion 5 .

