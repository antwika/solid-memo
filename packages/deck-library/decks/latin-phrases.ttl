    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "in vino veritas"@la ;
    solid-memo:back "in wine there is truth"@en ,
                    "i vinet finns sanningen"@sv .

