<>
    a solid-memo:Deck ,
      dcat:Dataset ;
    dcterms:title "Latin phrases in English and Swedish"@en ,
                  "Latinska uttryck i svenskan och engelskan"@sv ;
    dcterms:creator <#anton-wiklund> ;
    dcterms:license <https://creativecommons.org/publicdomain/zero/1.0/> ;
    dcterms:description "77 Latin phrases still used in both English and Swedish, from ad hoc and carpe diem to status quo and vice versa. The Latin phrase on the front, its meaning in English and Swedish on the back, with the literal sense or origin as a note where it helps. Every phrase has an entry in Dictionary.com and in a Swedish reference work (Svenska Akademiens ordlista, Svensk ordbok or Nationalencyklopedin) and is recorded in Wikidata; the meanings are written for this deck, using the conventional translation where a phrase has one, and checked against those dictionaries and Wiktionary. Sources, method and quality control: https://github.com/antwika/solid-memo/blob/main/packages/deck-library/authored/latin-phrases.md"@en ,
                        "77 latinska uttryck som fortfarande används både på svenska och engelska, från ad hoc och carpe diem till status quo och vice versa. Det latinska uttrycket på framsidan, betydelsen på svenska och engelska på baksidan, med den ordagranna betydelsen eller ursprunget som anteckning där det hjälper. Varje uttryck finns i Dictionary.com och i ett svenskt uppslagsverk (Svenska Akademiens ordlista, Svensk ordbok eller Nationalencyklopedin) och är registrerat i Wikidata; betydelserna är skrivna för den här kortleken, med den vedertagna översättningen där uttrycket har en, och kontrollerade mot de ordböckerna och Wiktionary. Källor, metod och kvalitetskontroll: https://github.com/antwika/solid-memo/blob/main/packages/deck-library/authored/latin-phrases.md"@sv ;
    prov:wasDerivedFrom <https://www.wikidata.org/> ;
    prov:wasGeneratedBy <#compilation> ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    dcat:theme <http://publications.europa.eu/resource/authority/data-theme/EDUC> ,
               topic:languages ,
               topic:latin ;
    dcat:keyword "Latin" ,
                 "Latin phrases" ,
                 "idioms" ,
                 "loanwords" ,
                 "vocabulary" ,
                 "latin" ,
                 "latinska uttryck" ,
                 "bevingade ord" ,
                 "lånord" ,
                 "ordförråd" ;
    dcterms:language <http://publications.europa.eu/resource/authority/language/ENG> ,
                     <http://publications.europa.eu/resource/authority/language/SWE> ,
                     <http://publications.europa.eu/resource/authority/language/LAT> ;
    solid-memo:studyDirection solid-memo:frontToBack ;
    solid-memo:formatVersion 4 .

