<>
    a solid-memo:Deck ,
      dcat:Dataset ;
    dcterms:title "Roman numerals"@en ,
                  "Romerska siffror"@sv ;
    dcterms:creator <#anton-wiklund> ;
    dcterms:license <https://creativecommons.org/publicdomain/zero/1.0/> ;
    dcterms:description "40 Roman numerals in the standard modern notation: the seven symbols I, V, X, L, C, D and M, the six subtractive pairs IV, IX, XL, XC, CD and CM, and 27 further numbers from 2 to 3999, among them years such as MCMXCIX (1999) and MMXXVI (2026). Front: the Roman numeral; back: its value in Arabic numerals; studied in both directions. Notes name older forms such as IIII on clock faces. Every card was computed and checked by two independent converters and against English Wikipedia's table of the standard form, and against Wikidata, Wiktionary and Swedish Wikipedia where they cover the numeral. Sources, method and quality control: https://github.com/antwika/solid-memo/blob/main/packages/deck-library/authored/roman-numerals.md"@en ,
                        "40 romerska tal i den moderna standardformen: de sju tecknen I, V, X, L, C, D och M, de sex subtraktiva paren IV, IX, XL, XC, CD och CM samt 27 andra tal från 2 till 3999, bland dem årtal som MCMXCIX (1999) och MMXXVI (2026). Framsida: det romerska talet; baksida: dess värde med arabiska siffror; kortleken övas åt båda hållen. Anteckningar nämner äldre skrivsätt som IIII på urtavlor. Varje kort är beräknat och kontrollerat med två oberoende omvandlare och mot engelskspråkiga Wikipedias tabell över standardformen, samt mot Wikidata, Wiktionary och svenskspråkiga Wikipedia där de tar upp talet. Källor, metod och kvalitetskontroll: https://github.com/antwika/solid-memo/blob/main/packages/deck-library/authored/roman-numerals.md"@sv ;
    prov:wasDerivedFrom <https://github.com/antwika/solid-memo/blob/main/packages/deck-library/authored/roman-numerals.json> ,
                        <https://www.wikidata.org/wiki/Q38918> ;
    prov:wasGeneratedBy <#compilation> ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    dcat:theme <http://publications.europa.eu/resource/authority/data-theme/EDUC> ,
               topic:mathematics ,
               topic:history ;
    dcat:keyword "Roman numerals"@en ,
                 "numeral system"@en ,
                 "numbers"@en ,
                 "years"@en ,
                 "ancient Rome"@en ,
                 "romerska siffror"@sv ,
                 "talsystem"@sv ,
                 "tal"@sv ,
                 "årtal"@sv ,
                 "antikens Rom"@sv ;
    dcterms:language <http://publications.europa.eu/resource/authority/language/ENG> ,
                     <http://publications.europa.eu/resource/authority/language/SWE> ;
    solid-memo:studyDirection solid-memo:bidirectional ;
    solid-memo:formatVersion 5 .

