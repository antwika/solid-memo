    dcterms:title "National parks of Sweden"@en ,
                  "Sveriges nationalparker"@sv ;
    dcterms:creator <#anton-wiklund> ;
    dcterms:license <https://creativecommons.org/publicdomain/zero/1.0/> ;
    dcterms:description "All 31 national parks of Sweden as of 4 October 2026, from the nine created in 1909 to Nämdöskärgården (2025). Front: the park's name in English, or its official Swedish name; back: the county (län) it lies in, with the year it was established in a note. Tiveden lies in two counties and Färnebofjärden in four. The list and the Swedish names are those of the National Parks Ordinance (1987:938); the counties and years come from Naturvårdsverket's register of protected areas and Wikidata, checked against Sveriges nationalparker. Sources, method and quality control: https://github.com/antwika/solid-memo/blob/main/packages/deck-library/authored/swedish-national-parks.md"@en ,
                        "Sveriges alla 31 nationalparker per den 4 oktober 2026, från de nio som bildades 1909 till Nämdöskärgården (2025). Framsida: parkens namn på engelska eller dess officiella svenska namn; baksida: länet den ligger i, med året den bildades i en anteckning. Tiveden ligger i två län och Färnebofjärden i fyra. Förteckningen och de svenska namnen är hämtade ur nationalparksförordningen (1987:938); länen och åren kommer från Naturvårdsverkets naturvårdsregister och Wikidata och har kontrollerats mot Sveriges nationalparker. Källor, metod och kvalitetskontroll: https://github.com/antwika/solid-memo/blob/main/packages/deck-library/authored/swedish-national-parks.md"@sv ;
    prov:wasDerivedFrom <https://www.riksdagen.se/sv/dokument-och-lagar/dokument/svensk-forfattningssamling/nationalparksforordning-1987938_sfs-1987-938/> ,
                        <https://geodata.naturvardsverket.se/naturvardsregistret/rest/v3> ,
                        <https://www.wikidata.org/wiki/Q108051174> ;
    prov:wasGeneratedBy <#compilation> ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    dcat:theme <http://publications.europa.eu/resource/authority/data-theme/EDUC> ,
               topic:geography ,
               topic:biology ;
    dcat:keyword "national parks"@en ,
                 "Sweden"@en ,
                 "counties of Sweden"@en ,
                 "nature conservation"@en ,
                 "protected areas"@en ,
                 "nationalparker"@sv ,
                 "Sverige"@sv ,
                 "Sveriges län"@sv ,
                 "naturvård"@sv ,
