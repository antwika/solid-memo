<>
    a solid-memo:Deck ,
      dcat:Dataset ;
    dcterms:title "Eurovision Song Contest winners"@en ,
                  "Vinnare i Eurovision Song Contest"@sv ;
    dcterms:creator <#anton-wiklund> ;
    dcterms:license <https://creativecommons.org/licenses/by-sa/4.0/> ;
    dcterms:description "The winners of every Eurovision Song Contest from the first, in 1956, to the 70th, in May 2026: 70 cards (no contest was held in 2020). Front: the contest, e.g. “Eurovision Song Contest 1974”; back: the winning country and song, e.g. Sweden – “Waterloo”, with the performer in a note. Song titles are given as performed, untranslated. The 1969 contest ended in a four-way tie, so its card names all four winners. Taken from Wikidata and the English Wikipedia and checked against the EBU’s eurovision.com and the Swedish Wikipedia. Sources, method and quality control: https://github.com/antwika/solid-memo/blob/main/packages/deck-library/authored/eurovision-winners.md"@en ,
                        "Vinnarna i varje Eurovision Song Contest från den första 1956 till den 70:e i maj 2026: 70 kort (år 2020 hölls ingen tävling). Framsida: tävlingen, t.ex. ”Eurovision Song Contest 1974”; baksida: vinnarlandet och låten, t.ex. Sverige – ”Waterloo”, med artisten i en anteckning. Låttitlarna står som de framfördes, oöversatta. Tävlingen 1969 slutade med att fyra bidrag delade segern, så det kortet nämner alla fyra. Uppgifterna är hämtade från Wikidata och engelskspråkiga Wikipedia och kontrollerade mot EBU:s eurovision.com och svenskspråkiga Wikipedia. Källor, metod och kvalitetskontroll: https://github.com/antwika/solid-memo/blob/main/packages/deck-library/authored/eurovision-winners.md"@sv ;
    prov:wasDerivedFrom <https://www.wikidata.org/wiki/Q276> ,
                        <https://en.wikipedia.org/wiki/List_of_Eurovision_Song_Contest_winners> ;
    prov:wasGeneratedBy <#compilation> ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    dcat:theme <http://publications.europa.eu/resource/authority/data-theme/EDUC> ,
               topic:music ;
    dcat:keyword "Eurovision Song Contest"@en ,
                 "Eurovision"@en ,
                 "song contest"@en ,
                 "pop music"@en ,
                 "winning songs"@en ,
                 "Eurovision Song Contest"@sv ,
                 "Eurovision"@sv ,
                 "sångtävling"@sv ,
                 "popmusik"@sv ,
                 "vinnarlåtar"@sv ;
    dcterms:language <http://publications.europa.eu/resource/authority/language/ENG> ,
                     <http://publications.europa.eu/resource/authority/language/SWE> ;
    solid-memo:studyDirection solid-memo:frontToBack ;
    solid-memo:formatVersion 5 .

<#anton-wiklund>
    a foaf:Agent ;
    foaf:name "Anton Wiklund" ;
    foaf:mbox <mailto:antonwiklund91@gmail.com> .

<https://creativecommons.org/licenses/by-sa/4.0/>
    a dcterms:LicenseDocument .

<https://creativecommons.org/publicdomain/zero/1.0/>
    a dcterms:LicenseDocument .

# How this deck was made (W3C PROV-O): researched card by card from the sources below,
# each card checked against at least two of them. The full record is the provenance report.
<#compilation>
    a prov:Activity ;
    prov:endedAtTime "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    prov:used <https://www.wikidata.org/wiki/Q276> ,
              <https://en.wikipedia.org/wiki/List_of_Eurovision_Song_Contest_winners> ,
              <https://www.eurovision.com/eurovision-song-contest/history/> ,
              <https://sv.wikipedia.org/wiki/Lista_%C3%B6ver_vinnare_i_Eurovision_Song_Contest> ,
              <https://www.bta.bg/en/news/1127547-bulgaria-s-dara-wins-eurovision-2026> ;
    prov:wasAssociatedWith <#anton-wiklund> ,
                           <https://github.com/antwika/solid-memo/blob/main/packages/deck-library/scripts/authored_decks.py> ;
    rdfs:seeAlso <https://github.com/antwika/solid-memo/blob/main/packages/deck-library/authored/eurovision-winners.md> ;
    rdfs:comment "Compiled from the dossier authored/eurovision-winners.json, which records every source, the method, the quality-control rounds and the evidence for each card; built with python3 packages/deck-library/scripts/authored_decks.py build eurovision-winners." .

<https://github.com/antwika/solid-memo/blob/main/packages/deck-library/scripts/authored_decks.py>
    a prov:SoftwareAgent ;
    dcterms:title "authored_decks.py" .

<https://www.wikidata.org/wiki/Q276>
    dcterms:title "Wikidata: the editions of the Eurovision Song Contest (series Q276), their winners (P1346) and the winning entries' participation (P1344 with ranking P1352 and country P17), victory (P2522), performers (P175) and English and Swedish labels" ;
    dcterms:creator "Wikidata contributors" ;
    dcterms:license <https://creativecommons.org/publicdomain/zero/1.0/> .

<https://en.wikipedia.org/wiki/List_of_Eurovision_Song_Contest_winners>
