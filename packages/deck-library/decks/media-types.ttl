# How this deck was made (W3C PROV-O): researched card by card from the sources below,
# each card checked against at least two of them. The full record is the provenance report.
<#compilation>
    a prov:Activity ;
    prov:endedAtTime "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    prov:used <https://www.iana.org/assignments/media-types/media-types.xhtml> ,
              <https://www.iana.org/assignments/media-types/> ,
              <https://www.wikidata.org/> ,
              <https://www.rfc-editor.org/> ,
              <https://developer.mozilla.org/en-US/docs/Web/HTTP/Guides/MIME_types/Common_types> ,
              <https://svenska.se/> ;
    prov:wasAssociatedWith <#anton-wiklund> ,
                           <https://github.com/antwika/solid-memo/blob/main/packages/deck-library/scripts/authored_decks.py> ;
    rdfs:seeAlso <https://github.com/antwika/solid-memo/blob/main/packages/deck-library/authored/media-types.md> ;
    rdfs:comment "Compiled from the dossier authored/media-types.json, which records every source, the method, the quality-control rounds and the evidence for each card; built with python3 packages/deck-library/scripts/authored_decks.py build media-types." .

<https://github.com/antwika/solid-memo/blob/main/packages/deck-library/scripts/authored_decks.py>
    a prov:SoftwareAgent ;
    dcterms:title "authored_decks.py" .

<https://www.iana.org/assignments/media-types/media-types.xhtml>
    dcterms:title "Media Types (IANA protocol registry; media-types.xml and the per-type CSV tables, last updated 2026-09-24)" ;
    dcterms:creator "Internet Assigned Numbers Authority (IANA), operated by Public Technical Identifiers, an affiliate of ICANN" ;
    dcterms:license <https://creativecommons.org/publicdomain/zero/1.0/> .

<https://www.iana.org/assignments/media-types/>
    dcterms:title "IANA Media Types registry: the registration templates of the types on the cards (one page per type, e.g. https://www.iana.org/assignments/media-types/image/png)" ;
    dcterms:creator "Internet Assigned Numbers Authority (IANA); the templates were written by each type's registrant (often as part of an RFC)" .

<https://www.wikidata.org/>
    dcterms:title "Wikidata: file formats with their MIME type (P1163) and file extension (P1195)" ;
    dcterms:creator "Wikidata contributors" ;
    dcterms:license <https://creativecommons.org/publicdomain/zero/1.0/> .

<https://www.rfc-editor.org/>
    dcterms:title "The RFCs that register or define the media types on the cards: RFC 2046, 3003, 3302, 4180, 4337, 5334, 5545, 6350, 6713, 6922, 7303, 7763, 7903, 7946, 8081, 8118, 8259, 9239, 9512, 9559, 9639 and 9649 (plain-text versions from the RFC Editor)" ;
    dcterms:creator "IETF, the Independent Submission stream (RFC 7903) and the authors of each RFC; published by the RFC Editor" .

<https://developer.mozilla.org/en-US/docs/Web/HTTP/Guides/MIME_types/Common_types>
    dcterms:title "Common media types (MDN Web Docs)" ;
    dcterms:creator "Mozilla and individual contributors" ;
    dcterms:license <https://creativecommons.org/licenses/by-sa/2.5/> .

<https://svenska.se/>
    dcterms:title "Svenska Akademiens ordböcker: Svenska Akademiens ordlista (SAOL) and Svensk ordbok (SO)" ;
    dcterms:creator "Svenska Akademien" .

