<>
    a solid-memo:Deck ,
      dcat:Dataset ;
    dcterms:title "Prime Ministers of Sweden"@en ,
                  "Sveriges statsministrar"@sv ;
    dcterms:creator <#anton-wiklund> ;
    dcterms:license <https://creativecommons.org/publicdomain/zero/1.0/> ;
    dcterms:description "All 35 prime ministers of Sweden, from Louis De Geer, the first in 1876, to Ulf Kristersson, who was still in office on 4 October 2026 (Östen Undén's five days as acting prime minister in 1946 are not counted). Front: the prime minister's name; back: the years of each term, several terms separated by commas (\"1969–1976, 1982–1986\"). A note gives the party where the sources agree on it, and sometimes a short fact. Taken from Wikidata and checked against the Government Offices' list of prime ministers (regeringen.se) and the Riksdag. Sources, method and quality control: https://github.com/antwika/solid-memo/blob/main/packages/deck-library/authored/swedish-prime-ministers.md"@en ,
                        "Sveriges alla 35 statsministrar, från Louis De Geer, den förste 1876, till Ulf Kristersson, som den 4 oktober 2026 fortfarande var statsminister (Östen Undéns fem dagar som tillförordnad statsminister 1946 räknas inte). Framsida: statsministerns namn; baksida: åren för varje period, flera perioder åtskilda med kommatecken (”1969–1976, 1982–1986”). En anteckning anger partiet där källorna är eniga om det, och ibland en kort upplysning. Uppgifterna kommer från Wikidata och är kontrollerade mot Regeringskansliets lista över statsministrar (regeringen.se) och riksdagen. Källor, metod och kvalitetskontroll: https://github.com/antwika/solid-memo/blob/main/packages/deck-library/authored/swedish-prime-ministers.md"@sv ;
    prov:wasDerivedFrom <https://www.wikidata.org/wiki/Q687075> ;
    prov:wasGeneratedBy <#compilation> ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    dcat:theme <http://publications.europa.eu/resource/authority/data-theme/EDUC> ,
               topic:history ;
    dcat:keyword "prime ministers"@en ,
                 "Sweden"@en ,
                 "Swedish politics"@en ,
                 "political history"@en ,
                 "statsministrar"@sv ,
                 "Sverige"@sv ,
                 "svensk politik"@sv ,
                 "politisk historia"@sv ;
    dcterms:language <http://publications.europa.eu/resource/authority/language/ENG> ,
                     <http://publications.europa.eu/resource/authority/language/SWE> ;
    solid-memo:studyDirection solid-memo:frontToBack ;
    solid-memo:formatVersion 5 .

