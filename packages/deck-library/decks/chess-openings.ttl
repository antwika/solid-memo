<>
    a solid-memo:Deck ,
      dcat:Dataset ;
    dcterms:title "Chess openings"@en ,
                  "Schacköppningar"@sv ;
    dcterms:creator <#anton-wiklund> ;
    dcterms:license <https://creativecommons.org/publicdomain/zero/1.0/> ;
    dcterms:description "37 well-known chess openings and the moves that define them. Front: the opening's name, e.g. \"Ruy Lopez (Spanish Opening)\" or \"Sicilian Defence\"; back: its defining moves in standard algebraic notation with English piece letters (K, Q, R, B, N), e.g. \"1.e4 e5 2.Nf3 Nc6 3.Bb5\", with the ECO code in a note. Every move sequence was replayed with python-chess. Moves and codes from the lichess-org/chess-openings data set and Wikidata, checked against the Encyclopaedia of Chess Openings codes as listed by Wikipedia and against 365Chess. Sources, method and quality control: https://github.com/antwika/solid-memo/blob/main/packages/deck-library/authored/chess-openings.md"@en ,
                        "37 välkända schacköppningar och de drag som definierar dem. Framsida: öppningens namn, t.ex. ”Spanskt parti” eller ”Sicilianskt parti”; baksida: de definierande dragen i algebraisk notation med engelska pjäsbokstäver (K, Q, R, B, N i stället för svenska K, D, T, L, S), t.ex. ”1.e4 e5 2.Nf3 Nc6 3.Bb5”, med ECO-koden i en anteckning. Varje dragföljd har spelats upp med python-chess. Drag och koder kommer från datamängden lichess-org/chess-openings och Wikidata och är kontrollerade mot koderna i Encyclopaedia of Chess Openings så som Wikipedia återger dem och mot 365Chess. Källor, metod och kvalitetskontroll: https://github.com/antwika/solid-memo/blob/main/packages/deck-library/authored/chess-openings.md"@sv ;
    prov:wasDerivedFrom <https://github.com/lichess-org/chess-openings> ,
                        <https://www.wikidata.org/wiki/Property:P9838> ,
                        <https://github.com/antwika/solid-memo/blob/main/packages/deck-library/authored/chess-openings.json> ;
    prov:wasGeneratedBy <#compilation> ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    dcat:theme <http://publications.europa.eu/resource/authority/data-theme/EDUC> ,
               topic:sports ;
    dcat:keyword "chess"@en ,
                 "chess openings"@en ,
                 "ECO codes"@en ,
                 "algebraic notation"@en ,
                 "gambits"@en ,
                 "schack"@sv ,
                 "schacköppningar"@sv ,
                 "ECO-koder"@sv ,
                 "algebraisk notation"@sv ,
                 "gambiter"@sv ;
    dcterms:language <http://publications.europa.eu/resource/authority/language/ENG> ,
                     <http://publications.europa.eu/resource/authority/language/SWE> ;
    solid-memo:studyDirection solid-memo:frontToBack ;
    solid-memo:formatVersion 5 .

