# How this deck was made (W3C PROV-O): researched card by card from the sources below,
# each card checked against at least two of them. The full record is the provenance report.
<#compilation>
    a prov:Activity ;
    prov:endedAtTime "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    prov:used <https://github.com/lichess-org/chess-openings> ,
              <https://www.wikidata.org/wiki/Property:P9838> ,
              <https://github.com/antwika/solid-memo/blob/main/packages/deck-library/authored/chess-openings.json> ,
              <https://en.wikipedia.org/wiki/List_of_ECO_codes> ,
              <https://sv.wikipedia.org/wiki/Lista_%C3%B6ver_schack%C3%B6ppningar> ,
              <https://www.365chess.com/eco.php> ;
    prov:wasAssociatedWith <#anton-wiklund> ,
                           <https://github.com/antwika/solid-memo/blob/main/packages/deck-library/scripts/authored_decks.py> ;
    rdfs:seeAlso <https://github.com/antwika/solid-memo/blob/main/packages/deck-library/authored/chess-openings.md> ;
    rdfs:comment "Compiled from the dossier authored/chess-openings.json, which records every source, the method, the quality-control rounds and the evidence for each card; built with python3 packages/deck-library/scripts/authored_decks.py build chess-openings." .

<https://github.com/antwika/solid-memo/blob/main/packages/deck-library/scripts/authored_decks.py>
    a prov:SoftwareAgent ;
    dcterms:title "authored_decks.py" .

<https://github.com/lichess-org/chess-openings>
