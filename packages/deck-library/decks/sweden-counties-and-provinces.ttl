<>
    a solid-memo:Deck ,
      dcat:Dataset ;
    dcterms:title "Sweden's counties and provinces"@en ,
                  "Sveriges län och landskap"@sv ;
    dcterms:creator <#anton-wiklund> ;
    dcterms:license <https://creativecommons.org/publicdomain/zero/1.0/> ;
    dcterms:description "Sweden's 21 counties and 25 provinces in 46 cards, in English and Swedish. A county card shows the county's name and asks for its seat (residensstad); a province card shows the province's name and asks for the land (landsdel) it traditionally belongs to: Götaland, Svealand or Norrland. Compiled from Wikidata and checked against the county administrative boards' websites, Nationalencyklopedin and Wikipedia. Sources, method and quality control: https://github.com/antwika/solid-memo/blob/main/packages/deck-library/authored/sweden-counties-and-provinces.md"@en ,
                        "Sveriges 21 län och 25 landskap på 46 kort, på engelska och svenska. Ett länskort visar länets namn och frågar efter residensstaden; ett landskapskort visar landskapets namn och frågar efter landsdelen det traditionellt hör till: Götaland, Svealand eller Norrland. Sammanställd från Wikidata och kontrollerad mot länsstyrelsernas webbplatser, Nationalencyklopedin och Wikipedia. Källor, metod och kvalitetskontroll: https://github.com/antwika/solid-memo/blob/main/packages/deck-library/authored/sweden-counties-and-provinces.md"@sv ;
    prov:wasDerivedFrom <https://www.wikidata.org/> ;
    prov:wasGeneratedBy <#compilation> ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    dcat:theme <http://publications.europa.eu/resource/authority/data-theme/EDUC> ,
               topic:geography ;
    dcat:keyword "Sweden"@en ,
                 "counties"@en ,
                 "provinces"@en ,
                 "county seats"@en ,
                 "geography"@en ,
                 "lands of Sweden"@en ,
                 "Sverige"@sv ,
                 "län"@sv ,
                 "landskap"@sv ,
                 "residensstäder"@sv ,
                 "landsdelar"@sv ,
                 "geografi"@sv ;
    dcterms:language <http://publications.europa.eu/resource/authority/language/ENG> ,
                     <http://publications.europa.eu/resource/authority/language/SWE> ;
    solid-memo:studyDirection solid-memo:frontToBack ;
    solid-memo:formatVersion 5 .

