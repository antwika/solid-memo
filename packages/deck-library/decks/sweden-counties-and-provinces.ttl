# How this deck was made (W3C PROV-O): researched card by card from the sources below,
# each card checked against at least two of them. The full record is the provenance report.
<#compilation>
    a prov:Activity ;
    prov:endedAtTime "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    prov:used <https://www.wikidata.org/> ,
              <https://www.lansstyrelsen.se/> ,
              <https://sv.wikipedia.org/wiki/Sveriges_l%C3%A4n> ,
              <https://sv.wikipedia.org/wiki/Landskap_i_Sverige> ,
              <https://en.wikipedia.org/wiki/Provinces_of_Sweden> ,
              <https://sv.wikipedia.org/wiki/Svealand> ,
              <https://sv.wikipedia.org/wiki/Residensstad> ,
              <https://www.ne.se/> ;
    prov:wasAssociatedWith <#anton-wiklund> ,
                           <https://github.com/antwika/solid-memo/blob/main/packages/deck-library/scripts/authored_decks.py> ;
    rdfs:seeAlso <https://github.com/antwika/solid-memo/blob/main/packages/deck-library/authored/sweden-counties-and-provinces.md> ;
    rdfs:comment "Compiled from the dossier authored/sweden-counties-and-provinces.json, which records every source, the method, the quality-control rounds and the evidence for each card; built with python3 packages/deck-library/scripts/authored_decks.py build sweden-counties-and-provinces." .

<https://github.com/antwika/solid-memo/blob/main/packages/deck-library/scripts/authored_decks.py>
