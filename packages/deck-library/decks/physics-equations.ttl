<>
    a solid-memo:Deck ,
      dcat:Dataset ;
    dcterms:title "Physics equations"@en ,
                  "Fysikformler"@sv ;
    dcterms:creator <#anton-wiklund> ;
    dcterms:license <https://creativecommons.org/publicdomain/zero/1.0/> ;
    dcterms:description "42 fundamental equations of school and first-year university physics: motion and forces, energy, work and power, gravitation, oscillations, fluids, heat and gases, waves and optics, electricity and magnetism, and photons and relativity. Front: the law or quantity, naming every symbol, e.g. \"Ohm's law: voltage U across a resistance R carrying a current I\"; back: the equation, e.g. \"U = RI\". Voltage is U throughout, as in Swedish schools. Each equation is checked for dimensional consistency with SymPy and against OpenStax University Physics, and where they state it, against Wikidata and Swedish Wikipedia. Sources, method and quality control: https://github.com/antwika/solid-memo/blob/main/packages/deck-library/authored/physics-equations.md"@en ,
                        "42 grundläggande formler ur gymnasiets fysik och första årets högskolefysik: rörelse och krafter, energi, arbete och effekt, gravitation, svängningar, vätskor, värme och gaser, vågor och optik, elektricitet och magnetism samt fotoner och relativitet. Framsida: lagen eller storheten med alla beteckningar namngivna, t.ex. ”Ohms lag: spänningen U över resistansen R när strömmen är I”; baksida: formeln, t.ex. ”U = RI”. Spänning betecknas genomgående U, som i svensk skola. Varje formel är kontrollerad för dimensionell konsistens med SymPy och mot OpenStax University Physics, och där de anger den även mot Wikidata och svenska Wikipedia. Källor, metod och kvalitetskontroll: https://github.com/antwika/solid-memo/blob/main/packages/deck-library/authored/physics-equations.md"@sv ;
    prov:wasDerivedFrom <https://github.com/antwika/solid-memo/blob/main/packages/deck-library/authored/physics-equations.json> ,
                        <https://www.wikidata.org/> ;
    prov:wasGeneratedBy <#compilation> ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    dcat:theme <http://publications.europa.eu/resource/authority/data-theme/EDUC> ,
               topic:physics ;
    dcat:keyword "physics"@en ,
                 "equations"@en ,
                 "formulas"@en ,
                 "mechanics"@en ,
                 "electricity"@en ,
                 "SI units"@en ,
                 "fysik"@sv ,
                 "formler"@sv ,
                 "ekvationer"@sv ,
                 "mekanik"@sv ,
                 "elektricitet"@sv ,
                 "SI-enheter"@sv ;
    dcterms:language <http://publications.europa.eu/resource/authority/language/ENG> ,
                     <http://publications.europa.eu/resource/authority/language/SWE> ;
    solid-memo:studyDirection solid-memo:frontToBack ;
    solid-memo:formatVersion 5 .

