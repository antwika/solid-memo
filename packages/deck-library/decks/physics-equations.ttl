<#average-speed>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Average speed v when a distance s is covered in time t"@en ,
                     "Medelfarten v när sträckan s tillryggaläggs på tiden t"@sv ;
    solid-memo:back "v = s/t"@zxx .

<#average-acceleration>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Average acceleration a when the velocity changes by Δv in time Δt"@en ,
                     "Medelaccelerationen a när hastigheten ändras med Δv på tiden Δt"@sv ;
    solid-memo:back "a = Δv/Δt"@zxx .

<#velocity-constant-acceleration>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Velocity v after time t, starting at velocity v₀ with constant acceleration a"@en ,
                     "Hastigheten v efter tiden t med starthastigheten v₀ och den konstanta accelerationen a"@sv ;
    solid-memo:back "v = v₀ + at"@zxx .

<#displacement-constant-acceleration>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Displacement s after time t, starting at velocity v₀ with constant acceleration a"@en ,
                     "Förflyttningen s efter tiden t med starthastigheten v₀ och den konstanta accelerationen a"@sv ;
    solid-memo:back "s = v₀t + at²/2"@zxx ;
    solid-memo:backNote "Also written s = v₀t + ½at²."@en ,
                        "Skrivs även s = v₀t + ½at²."@sv .

<#velocity-displacement>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Velocity v after a displacement s, starting at velocity v₀ with constant acceleration a (time not involved)"@en ,
                     "Hastigheten v efter förflyttningen s med starthastigheten v₀ och den konstanta accelerationen a (tiden ingår inte)"@sv ;
    solid-memo:back "v² = v₀² + 2as"@zxx ;
    solid-memo:backNote "Also written v² − v₀² = 2as."@en ,
                        "Skrivs även v² − v₀² = 2as."@sv .

<#newtons-second-law>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Newton's second law: net force F on a body of mass m with acceleration a"@en ,
                     "Newtons andra lag: den resulterande kraften F på en kropp med massan m och accelerationen a"@sv ;
    solid-memo:back "F = ma"@zxx .

<#weight>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Weight F of a body of mass m where the gravitational acceleration is g"@en ,
                     "Tyngdkraften F på en kropp med massan m där tyngdaccelerationen är g"@sv ;
    solid-memo:back "F = mg"@zxx .

<#momentum>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Momentum p of a body of mass m moving at velocity v"@en ,
                     "Rörelsemängden p hos en kropp med massan m och hastigheten v"@sv ;
    solid-memo:back "p = mv"@zxx .

<#kinetic-energy>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Kinetic energy Eₖ of a body of mass m moving at speed v"@en ,
                     "Rörelseenergin Eₖ hos en kropp med massan m och farten v"@sv ;
    solid-memo:back "Eₖ = mv²/2"@zxx ;
    solid-memo:backNote "Also written ½mv². Holds at speeds far below the speed of light."@en ,
                        "Skrivs även ½mv². Gäller vid farter långt under ljusets hastighet."@sv .

<#potential-energy>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Gravitational potential energy Eₚ of a mass m at height h, where the gravitational acceleration is g"@en ,
                     "Lägesenergin Eₚ hos en massa m på höjden h där tyngdaccelerationen är g"@sv ;
    solid-memo:back "Eₚ = mgh"@zxx ;
    solid-memo:backNote "Holds near the Earth's surface, where g is constant; h is measured from a chosen zero level."@en ,
                        "Gäller nära jordytan, där g är konstant; h räknas från en vald nollnivå."@sv .

<#work>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Work W done by a constant force F over a distance s in the direction of the force"@en ,
                     "Arbetet W som en konstant kraft F uträttar längs sträckan s i kraftens riktning"@sv ;
    solid-memo:back "W = Fs"@zxx ;
    solid-memo:backNote "At an angle θ between force and displacement: W = Fs cos θ."@en ,
                        "Med vinkeln θ mellan kraft och förflyttning: W = Fs cos θ."@sv .

<#power>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Average power P when work W is done in time t"@en ,
                     "Medeleffekten P när arbetet W uträttas på tiden t"@sv ;
    solid-memo:back "P = W/t"@zxx .

<#hookes-law>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Hooke's law: force F from a spring with spring constant k stretched or compressed by x"@en ,
                     "Hookes lag: kraften F från en fjäder med fjäderkonstanten k som sträckts ut eller tryckts ihop med sträckan x"@sv ;
    solid-memo:back "F = kx"@zxx ;
    solid-memo:backNote "The size of the force. It acts against the deformation, so as a vector F = −kx."@en ,
                        "Kraftens storlek. Den verkar mot deformationen, så som vektor är F = −kx."@sv .

<#gravitation>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Newton's law of gravitation: force F between masses m₁ and m₂ at distance r (gravitational constant G)"@en ,
                     "Newtons gravitationslag: kraften F mellan massorna m₁ och m₂ på avståndet r (gravitationskonstanten G)"@sv ;
    solid-memo:back "F = Gm₁m₂/r²"@zxx .

<#centripetal-force>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Centripetal force F on a body of mass m moving at speed v in a circle of radius r"@en ,
                     "Centripetalkraften F på en kropp med massan m som rör sig med farten v i en cirkel med radien r"@sv ;
    solid-memo:back "F = mv²/r"@zxx .

<#pendulum-period>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Period T of a simple pendulum of length L swinging through small angles (gravitational acceleration g)"@en ,
                     "Periodtiden T för en matematisk pendel med längden L vid små utslag (tyngdaccelerationen g)"@sv ;
    solid-memo:back "T = 2π√(L/g)"@zxx .

<#spring-period>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Period T of a mass m oscillating on a spring with spring constant k"@en ,
                     "Periodtiden T för en massa m som svänger i en fjäder med fjäderkonstanten k"@sv ;
    solid-memo:back "T = 2π√(m/k)"@zxx .

<#pressure>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Pressure p when a force F acts perpendicular to an area A"@en ,
                     "Trycket p när kraften F verkar vinkelrätt mot arean A"@sv ;
    solid-memo:back "p = F/A"@zxx .

<#density>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Density ρ of a body of mass m and volume V"@en ,
                     "Densiteten ρ hos en kropp med massan m och volymen V"@sv ;
    solid-memo:back "ρ = m/V"@zxx .

<#hydrostatic-pressure>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Pressure p at depth h in a liquid of density ρ, not counting the air pressure above (gravitational acceleration g)"@en ,
                     "Trycket p på djupet h i en vätska med densiteten ρ, utan lufttrycket ovanför (tyngdaccelerationen g)"@sv ;
    solid-memo:back "p = ρgh"@zxx ;
    solid-memo:backNote "With the air pressure p₀ at the surface, the total pressure is p₀ + ρgh."@en ,
                        "Med lufttrycket p₀ vid ytan är det totala trycket p₀ + ρgh."@sv .

<#archimedes-principle>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Archimedes' principle: buoyant force F on a body that displaces a volume V of a fluid of density ρ (gravitational acceleration g)"@en ,
                     "Arkimedes princip: lyftkraften F på en kropp som tränger undan volymen V av en vätska eller gas med densiteten ρ (tyngdaccelerationen g)"@sv ;
    solid-memo:back "F = ρVg"@zxx ;
    solid-memo:backNote "The buoyant force equals the weight of the displaced fluid."@en ,
                        "Lyftkraften är lika stor som tyngden av den undanträngda vätskan eller gasen."@sv .

<#ideal-gas-law>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Ideal gas law: pressure p, volume V, amount of substance n and absolute temperature T (molar gas constant R)"@en ,
                     "Allmänna gaslagen: trycket p, volymen V, substansmängden n och den absoluta temperaturen T (allmänna gaskonstanten R)"@sv ;
    solid-memo:back "pV = nRT"@zxx ;
    solid-memo:backNote "T in kelvin."@en ,
                        "T i kelvin."@sv .

<#heat-and-temperature>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Heat Q needed to change the temperature of a mass m of a substance with specific heat capacity c by ΔT"@en ,
                     "Värmemängden Q som behövs för att ändra temperaturen med ΔT hos massan m av ett ämne med den specifika värmekapaciteten c"@sv ;
    solid-memo:back "Q = mcΔT"@zxx ;
    solid-memo:backNote "Without a change of phase."@en ,
                        "Utan fasövergång."@sv .

<#stefan-boltzmann-law>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Stefan–Boltzmann law: power P radiated by a black body of surface area A at absolute temperature T (Stefan–Boltzmann constant σ)"@en ,
                     "Stefan–Boltzmanns lag: effekten P som en svartkropp med arean A strålar ut vid den absoluta temperaturen T (Stefan–Boltzmanns konstant σ)"@sv ;
    solid-memo:back "P = σAT⁴"@zxx .

<#frequency-and-period>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Frequency f of an oscillation with period T"@en ,
                     "Frekvensen f hos en svängning med periodtiden T"@sv ;
    solid-memo:back "f = 1/T"@zxx .

<#wave-speed>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Speed v of a wave with frequency f and wavelength λ"@en ,
                     "Hastigheten v hos en våg med frekvensen f och våglängden λ"@sv ;
    solid-memo:back "v = fλ"@zxx ;
    solid-memo:backNote "Also written v = λf."@en ,
                        "Skrivs även v = λf."@sv .

<#snells-law>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Snell's law: angle of incidence θ₁ in a medium of refractive index n₁, angle of refraction θ₂ in a medium of refractive index n₂"@en ,
                     "Snells lag (brytningslagen): infallsvinkeln θ₁ i ett medium med brytningsindex n₁, brytningsvinkeln θ₂ i ett medium med brytningsindex n₂"@sv ;
    solid-memo:back "n₁ sin θ₁ = n₂ sin θ₂"@zxx ;
    solid-memo:backNote "Both angles are measured from the normal."@en ,
                        "Båda vinklarna mäts mot normalen."@sv .

<#refractive-index>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Refractive index n of a medium in which light travels at speed v (speed of light in vacuum c)"@en ,
                     "Brytningsindex n för ett medium där ljuset har hastigheten v (ljusets hastighet i vakuum c)"@sv ;
    solid-memo:back "n = c/v"@zxx .

<#ohms-law>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Ohm's law: voltage U across a resistance R carrying a current I"@en ,
                     "Ohms lag: spänningen U över resistansen R när strömmen är I"@sv ;
    solid-memo:back "U = RI"@zxx ;
    solid-memo:backNote "Many English texts write voltage as V: V = IR."@en ,
                        "Engelska texter skriver ofta spänningen som V: V = IR."@sv .

<#electric-power>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Electric power P in a component with voltage U across it and current I through it"@en ,
                     "Den elektriska effekten P i en komponent med spänningen U över sig och strömmen I genom sig"@sv ;
    solid-memo:back "P = UI"@zxx .

<#electric-current>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Electric current I when a charge Q passes through a cross-section of a conductor in time t"@en ,
                     "Den elektriska strömmen I när laddningen Q passerar genom ett tvärsnitt av en ledare på tiden t"@sv ;
    solid-memo:back "I = Q/t"@zxx ;
    solid-memo:backNote "The average current; for a steady current it is the current itself."@en ,
                        "Medelströmmen; för en konstant ström är det själva strömmen."@sv .

<#coulombs-law>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Coulomb's law: force F between point charges Q₁ and Q₂ at distance r (Coulomb constant k)"@en ,
                     "Coulombs lag: kraften F mellan punktladdningarna Q₁ och Q₂ på avståndet r (Coulombs konstant k)"@sv ;
    solid-memo:back "F = kQ₁Q₂/r²"@zxx ;
    solid-memo:backNote "k = 1/(4πε₀) ≈ 8.99 · 10⁹ N·m²/C²."@en ,
                        "k = 1/(4πε₀) ≈ 8,99 · 10⁹ N·m²/C²."@sv .

<#electric-field-strength>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Electric field strength E at a point where a charge Q experiences a force F"@en ,
                     "Den elektriska fältstyrkan E i en punkt där laddningen Q påverkas av kraften F"@sv ;
    solid-memo:back "E = F/Q"@zxx .

<#resistors-in-series>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Total resistance R of two resistors with resistances R₁ and R₂ connected in series"@en ,
                     "Den totala resistansen R för två seriekopplade resistorer med resistanserna R₁ och R₂"@sv ;
    solid-memo:back "R = R₁ + R₂"@zxx .

<#resistors-in-parallel>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Total resistance R of two resistors with resistances R₁ and R₂ connected in parallel"@en ,
                     "Den totala resistansen R för två parallellkopplade resistorer med resistanserna R₁ och R₂"@sv ;
    solid-memo:back "1/R = 1/R₁ + 1/R₂"@zxx ;
    solid-memo:backNote "Also written R = R₁R₂/(R₁ + R₂)."@en ,
                        "Skrivs även R = R₁R₂/(R₁ + R₂)."@sv .

<#resistance-and-resistivity>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Resistance R of a conductor of length L and cross-sectional area A made of a material of resistivity ρ"@en ,
                     "Resistansen R hos en ledare med längden L och tvärsnittsarean A av ett material med resistiviteten ρ"@sv ;
    solid-memo:back "R = ρL/A"@zxx .

<#capacitance>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Capacitance C of a capacitor that holds a charge Q at a voltage U"@en ,
                     "Kapacitansen C hos en kondensator som har laddningen Q vid spänningen U"@sv ;
    solid-memo:back "C = Q/U"@zxx .

<#force-on-current-carrying-conductor>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Magnetic force F on a straight conductor of length L carrying a current I perpendicular to a magnetic field of flux density B"@en ,
                     "Den magnetiska kraften F på en rak ledare med längden L där strömmen I går vinkelrätt mot ett magnetfält med flödestätheten B"@sv ;
    solid-memo:back "F = BIL"@zxx ;
    solid-memo:backNote "At an angle θ between conductor and field: F = BIL sin θ."@en ,
                        "Med vinkeln θ mellan ledare och fält: F = BIL sin θ."@sv .

<#force-on-moving-charge>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Magnetic force F on a charge Q moving at speed v perpendicular to a magnetic field of flux density B"@en ,
                     "Den magnetiska kraften F på laddningen Q som rör sig med farten v vinkelrätt mot ett magnetfält med flödestätheten B"@sv ;
    solid-memo:back "F = QvB"@zxx ;
    solid-memo:backNote "At an angle θ between velocity and field: F = QvB sin θ."@en ,
                        "Med vinkeln θ mellan hastighet och fält: F = QvB sin θ."@sv .

<#photon-energy>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Energy E of a photon of frequency f (Planck constant h)"@en ,
                     "Energin E hos en foton med frekvensen f (Plancks konstant h)"@sv ;
    solid-memo:back "E = hf"@zxx .

<#mass-energy-equivalence>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Mass–energy equivalence: rest energy E of a mass m (speed of light in vacuum c)"@en ,
                     "Massans och energins ekvivalens: viloenergin E hos massan m (ljusets hastighet i vakuum c)"@sv ;
    solid-memo:back "E = mc²"@zxx .

<#de-broglie-wavelength>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "de Broglie wavelength λ of a particle with momentum p (Planck constant h)"@en ,
                     "de Broglie-våglängden λ för en partikel med rörelsemängden p (Plancks konstant h)"@sv ;
    solid-memo:back "λ = h/p"@zxx .
