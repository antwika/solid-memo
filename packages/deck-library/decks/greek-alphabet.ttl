<>
    a solid-memo:Deck ,
      dcat:Dataset ;
    dcterms:title "Greek alphabet"@en ,
                  "Grekiska alfabetet"@sv ;
    dcterms:creator <#anton-wiklund> ;
    dcterms:license <https://creativecommons.org/publicdomain/zero/1.0/> ;
    dcterms:description "The 24 letters of the Greek alphabet in 24 cards, studied in both directions. The front shows a letter in upper and lower case (Α α), the back its name in English and Swedish (alpha, alfa). Names and characters from Wikidata, checked against the Unicode Character Database, Svenska Akademiens ordlista, the SALDO lexicon and Nationalencyklopedin. Sources, method and quality control: https://github.com/antwika/solid-memo/blob/main/packages/deck-library/authored/greek-alphabet.md"@en ,
                        "Det grekiska alfabetets 24 bokstäver på 24 kort, som övas åt båda hållen. Framsidan visar en bokstav som versal och gemen (Α α), baksidan dess namn på engelska och svenska (alpha, alfa). Namnen och tecknen kommer från Wikidata och har kontrollerats mot Unicodes teckendatabas, Svenska Akademiens ordlista, lexikonet SALDO och Nationalencyklopedin. Källor, metod och kvalitetskontroll: https://github.com/antwika/solid-memo/blob/main/packages/deck-library/authored/greek-alphabet.md"@sv ;
    prov:wasDerivedFrom <https://www.wikidata.org/> ;
    prov:wasGeneratedBy <#compilation> ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    dcat:theme <http://publications.europa.eu/resource/authority/data-theme/EDUC> ,
               topic:languages ,
               topic:greek ,
               topic:mathematics ;
    dcat:keyword "Greek alphabet" ,
                 "Greek letters" ,
                 "letter names" ,
                 "mathematical symbols" ,
                 "grekiska alfabetet" ,
                 "grekiska bokstäver" ,
                 "bokstavsnamn" ,
                 "matematiska symboler" ;
    dcterms:language <http://publications.europa.eu/resource/authority/language/ENG> ,
                     <http://publications.europa.eu/resource/authority/language/SWE> ;
    solid-memo:studyDirection solid-memo:bidirectional ;
    solid-memo:formatVersion 4 .

