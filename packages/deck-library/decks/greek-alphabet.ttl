<https://creativecommons.org/publicdomain/zero/1.0/>
    a dcterms:LicenseDocument .

# How this deck was made (W3C PROV-O): researched card by card from the sources below,
# each card checked against at least two of them. The full record is the provenance report.
<#compilation>
    a prov:Activity ;
    prov:endedAtTime "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    prov:used <https://www.wikidata.org/> ,
              <https://www.unicode.org/Public/UCD/latest/ucd/UnicodeData.txt> ,
              <https://svenska.se/saol/> ,
              <https://svenska.se/so/> ,
              <https://sprakbanken.se/en/resources/saldo> ,
              <https://sv.wikipedia.org/w/index.php?title=Grekiska_alfabetet&oldid=59450821> ,
              <https://www.ne.se/uppslagsverk/> ;
    prov:wasAssociatedWith <#anton-wiklund> ,
                           <https://github.com/antwika/solid-memo/blob/main/packages/deck-library/scripts/authored_decks.py> ;
    rdfs:seeAlso <https://github.com/antwika/solid-memo/blob/main/packages/deck-library/authored/greek-alphabet.md> ;
    rdfs:comment "Compiled from the dossier authored/greek-alphabet.json, which records every source, the method, the quality-control rounds and the evidence for each card; built with python3 packages/deck-library/scripts/authored_decks.py build greek-alphabet." .

<https://github.com/antwika/solid-memo/blob/main/packages/deck-library/scripts/authored_decks.py>
    a prov:SoftwareAgent ;
    dcterms:title "authored_decks.py" .

<https://www.wikidata.org/>
