<>
    a solid-memo:Deck ,
      dcat:Dataset ;
    dcterms:title "Basic Italian"@en ,
                  "Grundläggande italienska"@sv ;
    dcterms:creator <#anton-wiklund> ;
    dcterms:license <https://creativecommons.org/publicdomain/zero/1.0/> ;
    dcterms:description "120 Italian words and phrases for beginners: numbers 0–20, the tens and 100, the days of the week, the months, eight colours, ten family members, ten greetings and polite phrases, yes and no, 20 everyday nouns, six adjectives and 16 verbs. The front shows the Italian word, nouns with their definite article (il libro, lo zio, la casa; l' with the gender added: l'acqua (f.)); the back gives the English and Swedish meaning, or the digits for a number. Notes give genders, plurals and feminine forms. From Wikidata's lexemes and the US Foreign Service Institute's Italian Programmed Course (public domain), checked against Italian, English and Swedish Wiktionary and Folkets lexikon. Sources, method and quality control: https://github.com/antwika/solid-memo/blob/main/packages/deck-library/authored/italian-basics.md"@en ,
                        "120 italienska ord och fraser för nybörjare: talen 0–20, tiotalen och 100, veckodagarna, månaderna, åtta färger, tio familjemedlemmar, tio hälsningar och artighetsfraser, ja och nej, 20 vardagliga substantiv, sex adjektiv och 16 verb. Framsidan visar det italienska ordet, substantiv med bestämd artikel (il libro, lo zio, la casa; l' med genus angivet: l'acqua (f.)); baksidan ger betydelsen på engelska och svenska, eller siffrorna för ett tal. Anteckningar anger genus, plural och femininformer. Från Wikidatas lexem och amerikanska Foreign Service Institutes Italian Programmed Course (fri från upphovsrätt), kontrollerat mot italienska, engelska och svenska Wiktionary och Folkets lexikon. Källor, metod och kvalitetskontroll: https://github.com/antwika/solid-memo/blob/main/packages/deck-library/authored/italian-basics.md"@sv ;
    prov:wasDerivedFrom <https://www.wikidata.org/> ,
                        <https://archive.org/details/Fsi-ItalianProgrammedCourse-Text> ;
    prov:wasGeneratedBy <#compilation> ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    dcat:theme <http://publications.europa.eu/resource/authority/data-theme/EDUC> ,
               topic:languages ,
               topic:italian ;
    dcat:keyword "Italian"@en ,
                 "vocabulary"@en ,
                 "beginners"@en ,
                 "phrases"@en ,
                 "italienska"@sv ,
                 "ordförråd"@sv ,
                 "nybörjare"@sv ,
                 "fraser"@sv ;
    dcterms:language <http://publications.europa.eu/resource/authority/language/ENG> ,
                     <http://publications.europa.eu/resource/authority/language/SWE> ,
                     <http://publications.europa.eu/resource/authority/language/ITA> ;
    solid-memo:studyDirection solid-memo:frontToBack ;
    solid-memo:formatVersion 5 .

