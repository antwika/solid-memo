<>
    a solid-memo:Deck ,
      dcat:Dataset ;
    dcterms:title "Basic Finnish"@en ,
                  "Grundläggande finska"@sv ;
    dcterms:creator <#anton-wiklund> ;
    dcterms:license <https://creativecommons.org/publicdomain/zero/1.0/> ;
    dcterms:description "120 basic Finnish words and phrases for beginners: the numbers 0–20, the tens and 100, the days of the week, the months, eight colours, family members, greetings and polite phrases, everyday nouns, six adjectives and 16 verbs in their dictionary form (the first infinitive). The front shows the Finnish word; the back gives its English and Swedish meaning, or the digits for a number. Words come from Wikidata's lexemes and items and the US Foreign Service Institute's Conversational Finnish (public domain); meanings from Wikidata or the authors, checked against Kotus's Nykysuomen sanalista (single words), English and Swedish Wiktionary, and Folkets lexikon (the English and Swedish). Sources, method and quality control: https://github.com/antwika/solid-memo/blob/main/packages/deck-library/authored/finnish-basics.md"@en ,
                        "120 grundläggande finska ord och fraser för nybörjare: talen 0–20, tiotalen och 100, veckodagarna, månaderna, åtta färger, familjemedlemmar, hälsningar och artighetsfraser, vardagliga substantiv, sex adjektiv och 16 verb i grundform (första infinitiven). Framsidan visar det finska ordet; baksidan ger betydelsen på engelska och svenska, eller siffrorna för ett tal. Orden kommer från Wikidatas lexem och objekt och amerikanska Foreign Service Institutes Conversational Finnish (fri från upphovsrätt); betydelserna från Wikidata eller författarna, kontrollerade mot Institutet för de inhemska språkens (Kotus) Nykysuomen sanalista (enstaka ord), engelska och svenska Wiktionary samt Folkets lexikon (engelskan och svenskan). Källor, metod och kvalitetskontroll: https://github.com/antwika/solid-memo/blob/main/packages/deck-library/authored/finnish-basics.md"@sv ;
    prov:wasDerivedFrom <https://www.wikidata.org/> ,
                        <https://archive.org/details/Fsi-ConversationalFinnish-StudentText> ;
    prov:wasGeneratedBy <#compilation> ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    dcat:theme <http://publications.europa.eu/resource/authority/data-theme/EDUC> ,
               topic:languages ,
               topic:finnish ;
    dcat:keyword "Finnish"@en ,
                 "vocabulary"@en ,
                 "beginners"@en ,
                 "phrases"@en ,
                 "finska"@sv ,
                 "ordförråd"@sv ,
                 "nybörjare"@sv ,
                 "fraser"@sv ;
    dcterms:language <http://publications.europa.eu/resource/authority/language/ENG> ,
                     <http://publications.europa.eu/resource/authority/language/SWE> ,
                     <http://publications.europa.eu/resource/authority/language/FIN> ;
    solid-memo:studyDirection solid-memo:frontToBack ;
    solid-memo:formatVersion 5 .

