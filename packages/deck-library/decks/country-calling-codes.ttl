<>
    a solid-memo:Deck ,
      dcat:Dataset ;
    dcterms:title "Country calling codes"@en ,
                  "Internationella landsnummer"@sv ;
    dcterms:creator <#anton-wiklund> ;
    dcterms:license <https://creativecommons.org/publicdomain/zero/1.0/> ;
    dcterms:description "The international telephone country calling code of each of the 193 UN member states: 193 cards with the country on the front, in English and Swedish, and its code on the back, such as Sweden → +46, studied from country to code. Codes shared by several countries are explained on the card: +1 for the 13 UN members in the North American Numbering Plan, with the Caribbean states' area codes, and +7 for Russia and Kazakhstan. Compiled from Wikidata and checked against the ITU's list of assigned E.164 country codes and its amendments up to 1 October 2026. Sources, method and quality control: https://github.com/antwika/solid-memo/blob/main/packages/deck-library/authored/country-calling-codes.md"@en ,
                        "Det internationella landsnumret för telefonsamtal till vart och ett av FN:s 193 medlemsländer: 193 kort med landet på framsidan, på engelska och svenska, och dess landsnummer på baksidan, till exempel Sverige → +46, att öva från land till nummer. Landsnummer som flera länder delar förklaras på kortet: +1 för de 13 FN-länderna i den nordamerikanska nummerplanen, med de karibiska staternas riktnummer, och +7 för Ryssland och Kazakstan. Sammanställd från Wikidata och kontrollerad mot ITU:s förteckning över tilldelade landsnummer enligt E.164 och dess tillägg till och med den 1 oktober 2026. Källor, metod och kvalitetskontroll: https://github.com/antwika/solid-memo/blob/main/packages/deck-library/authored/country-calling-codes.md"@sv ;
    prov:wasDerivedFrom <https://www.wikidata.org/> ;
    prov:wasGeneratedBy <#compilation> ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    dcat:theme <http://publications.europa.eu/resource/authority/data-theme/EDUC> ,
               topic:geography ,
               topic:computing ;
    dcat:keyword "country calling codes"@en ,
                 "telephone numbers"@en ,
                 "E.164"@en ,
                 "ITU"@en ,
                 "countries"@en ,
                 "landsnummer"@sv ,
                 "telefonnummer"@sv ,
                 "E.164"@sv ,
                 "ITU"@sv ,
                 "länder"@sv ;
    dcterms:language <http://publications.europa.eu/resource/authority/language/ENG> ,
                     <http://publications.europa.eu/resource/authority/language/SWE> ;
    solid-memo:studyDirection solid-memo:frontToBack ;
    solid-memo:formatVersion 5 .

<#anton-wiklund>
    a foaf:Agent ;
    foaf:name "Anton Wiklund" ;
    foaf:mbox <mailto:antonwiklund91@gmail.com> .

<https://creativecommons.org/publicdomain/zero/1.0/>
    a dcterms:LicenseDocument .

# How this deck was made (W3C PROV-O): researched card by card from the sources below,
# each card checked against at least two of them. The full record is the provenance report.
<#compilation>
    a prov:Activity ;
    prov:endedAtTime "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    prov:used <https://www.wikidata.org/> ,
              <https://www.itu.int/dms_pub/itu-t/opb/sp/T-SP-E.164D-2016-PDF-E.pdf> ,
              <https://www.itu.int/itu-t/bulletin> ,
              <https://reports.nanpa.com/public/npa_report.csv> ,
              <https://www.un.org/en/about-us/member-states> ;
    prov:wasAssociatedWith <#anton-wiklund> ,
                           <https://github.com/antwika/solid-memo/blob/main/packages/deck-library/scripts/authored_decks.py> ;
    rdfs:seeAlso <https://github.com/antwika/solid-memo/blob/main/packages/deck-library/authored/country-calling-codes.md> ;
    rdfs:comment "Compiled from the dossier authored/country-calling-codes.json, which records every source, the method, the quality-control rounds and the evidence for each card; built with python3 packages/deck-library/scripts/authored_decks.py build country-calling-codes." .

<https://github.com/antwika/solid-memo/blob/main/packages/deck-library/scripts/authored_decks.py>
    a prov:SoftwareAgent ;
    dcterms:title "authored_decks.py" .

<https://www.wikidata.org/>
    dcterms:title "Wikidata" ;
    dcterms:creator "Wikidata contributors" ;
    dcterms:license <https://creativecommons.org/publicdomain/zero/1.0/> .

<https://www.itu.int/dms_pub/itu-t/opb/sp/T-SP-E.164D-2016-PDF-E.pdf>
    dcterms:title "List of Recommendation ITU-T E.164 assigned country codes (position on 15 December 2016), Annex to ITU Operational Bulletin No. 1114" ;
    dcterms:creator "International Telecommunication Union (ITU), Telecommunication Standardization Bureau" .

<https://www.itu.int/itu-t/bulletin>
    dcterms:title "ITU Operational Bulletin, Nos. 1115–1349 (1 January 2017 to 1 October 2026): the amendments No. 1–49 to the list of E.164 assigned country codes and the notes from TSB on the international numbering plan" ;
    dcterms:creator "International Telecommunication Union (ITU), Telecommunication Standardization Bureau" .

<https://reports.nanpa.com/public/npa_report.csv>
    dcterms:title "NPA database (npa_report.csv, file date 10/04/2026)" ;
    dcterms:creator "North American Numbering Plan Administrator (NANPA), acting as a contractor to the US Federal Communications Commission" .

<https://www.un.org/en/about-us/member-states>
    dcterms:title "Member States" ;
    dcterms:creator "United Nations" .

