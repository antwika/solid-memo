<#gustav-i>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Gustav I"@en ,
                     "Gustav I"@sv ;
    solid-memo:back "1523–1560" ;
    solid-memo:backNote "Gustav Vasa. House of Vasa. Led the rising that drove out the Danes (1521–1523); elected king in 1523."@en ,
                        "Gustav Vasa. Vasaätten. Ledde upproret som drev ut danskarna (1521–1523); vald till kung 1523."@sv .

<#erik-xiv>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Erik XIV"@en ,
                     "Erik XIV"@sv ;
    solid-memo:back "1560–1568" ;
    solid-memo:backNote "House of Vasa. Overthrown in 1568 by his half-brothers John (who became John III) and Charles; the Riksdag formally deposed him in January 1569."@en ,
                        "Vasaätten. Störtades 1568 av halvbröderna Johan (sedan Johan III) och Karl; riksdagen avsatte honom formellt i januari 1569."@sv .

<#johan-iii>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "John III"@en ,
                     "Johan III"@sv ;
    solid-memo:back "1568–1592" ;
    solid-memo:backNote "House of Vasa. Took power from Erik XIV in 1568; some lists count from Erik's formal deposition in 1569."@en ,
                        "Vasaätten. Tog makten från Erik XIV 1568; vissa förteckningar räknar från Eriks formella avsättning 1569."@sv .

<#sigismund>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Sigismund"@en ,
                     "Sigismund"@sv ;
    solid-memo:back "1592–1599" ;
    solid-memo:backNote "House of Vasa. Also King of Poland as Sigismund III Vasa; deposed by the Riksdag in 1599."@en ,
                        "Vasaätten. Även kung av Polen som Sigismund III; avsatt av riksdagen 1599."@sv .

<#karl-ix>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Charles IX"@en ,
                     "Karl IX"@sv ;
    solid-memo:back "1604–1611" ;
    solid-memo:backNote "House of Vasa. Proclaimed regent by the Riksdag in 1595, ruled after Sigismund's deposition in 1599 and took the title of king in 1604."@en ,
                        "Vasaätten. Utsågs till riksföreståndare av riksdagen 1595, styrde riket efter Sigismunds avsättning 1599 och tog kungatiteln 1604."@sv .

<#gustav-ii-adolf>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Gustav II Adolf"@en ,
                     "Gustav II Adolf"@sv ;
    solid-memo:back "1611–1632" ;
    solid-memo:backNote "Gustavus Adolphus. House of Vasa. Fell in battle at Lützen in 1632."@en ,
                        "Vasaätten. Föll i strid vid Lützen 1632."@sv .

<#kristina>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Christina"@en ,
                     "Kristina"@sv ;
    solid-memo:back "1632–1654" ;
    solid-memo:backNote "House of Vasa. Queen regnant; succeeded her father at five and abdicated in 1654."@en ,
                        "Vasaätten. Regerande drottning; efterträdde sin far som femåring och abdikerade 1654."@sv .

<#karl-x-gustav>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Charles X Gustav"@en ,
                     "Karl X Gustav"@sv ;
    solid-memo:back "1654–1660" ;
    solid-memo:backNote "House of Palatinate-Zweibrücken. Cousin and successor of Christina."@en ,
                        "Pfalziska ätten. Kristinas kusin och efterträdare."@sv .

<#karl-xi>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Charles XI"@en ,
                     "Karl XI"@sv ;
    solid-memo:back "1660–1697" ;
    solid-memo:backNote "House of Palatinate-Zweibrücken. Became king at four; regents ruled until he came of age in 1672."@en ,
                        "Pfalziska ätten. Blev kung som fyraåring; förmyndare styrde riket tills han blev myndig 1672."@sv .

<#karl-xii>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Charles XII"@en ,
                     "Karl XII"@sv ;
    solid-memo:back "1697–1718" ;
    solid-memo:backNote "House of Palatinate-Zweibrücken. Killed in 1718 while besieging the fortress of Fredriksten in Norway."@en ,
                        "Pfalziska ätten. Stupade 1718 under belägringen av fästningen Fredriksten i Norge."@sv .

<#ulrika-eleonora>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Ulrika Eleonora"@en ,
                     "Ulrika Eleonora"@sv ;
    solid-memo:back "1718–1720" ;
    solid-memo:backNote "House of Palatinate-Zweibrücken. Queen regnant; succeeded her brother Charles XII in 1718 and abdicated in favour of her husband, Frederick I, in 1720. The Royal Court's list gives 1719–1720."@en ,
                        "Pfalziska ätten. Regerande drottning; efterträdde brodern Karl XII 1718 och abdikerade 1720 till förmån för maken Fredrik I. Kungahusets regentlängd anger 1719–1720."@sv .

<#fredrik-i>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Frederick I"@en ,
                     "Fredrik I"@sv ;
    solid-memo:back "1720–1751" ;
    solid-memo:backNote "House of Hesse. Husband of Ulrika Eleonora, who abdicated in his favour."@en ,
                        "Hessiska ätten. Make till Ulrika Eleonora, som abdikerade till hans förmån."@sv .

<#adolf-fredrik>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Adolf Frederick"@en ,
                     "Adolf Fredrik"@sv ;
    solid-memo:back "1751–1771" ;
    solid-memo:backNote "House of Holstein-Gottorp, its first king of Sweden."@en ,
                        "Holstein-Gottorpska ätten; ättens förste kung i Sverige."@sv .

<#gustav-iii>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Gustav III"@en ,
                     "Gustav III"@sv ;
    solid-memo:back "1771–1792" ;
    solid-memo:backNote "House of Holstein-Gottorp. Assassinated in 1792: shot during a masquerade at the Stockholm opera house."@en ,
                        "Holstein-Gottorpska ätten. Mördad 1792, skjuten under en maskerad i Gustavianska operahuset i Stockholm."@sv .

<#gustav-iv-adolf>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Gustav IV Adolf"@en ,
                     "Gustav IV Adolf"@sv ;
    solid-memo:back "1792–1809" ;
    solid-memo:backNote "House of Holstein-Gottorp. Deposed in the coup of 1809, during the Finnish War, which cost Sweden Finland."@en ,
                        "Holstein-Gottorpska ätten. Avsatt genom statskuppen 1809, under finska kriget, som kostade Sverige Finland."@sv .

<#karl-xiii>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Charles XIII"@en ,
                     "Karl XIII"@sv ;
    solid-memo:back "1809–1818" ;
    solid-memo:backNote "House of Holstein-Gottorp. Uncle of Gustav IV Adolf; with no heir of his own, he adopted Bernadotte as crown prince in 1810, after the first chosen heir had died."@en ,
                        "Holstein-Gottorpska ätten. Farbror till Gustav IV Adolf; han saknade egna arvingar och adopterade 1810 Bernadotte som tronföljare, sedan den först valda tronföljaren hade dött."@sv .

<#karl-xiv-johan>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Charles XIV John"@en ,
                     "Karl XIV Johan"@sv ;
    solid-memo:back "1818–1844" ;
    solid-memo:backNote "House of Bernadotte, its founder; formerly Jean-Baptiste Bernadotte, a French marshal."@en ,
                        "Ätten Bernadotte; ättens grundare, tidigare fransk marskalk under namnet Jean Baptiste Bernadotte."@sv .

<#oscar-i>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Oscar I"@en ,
                     "Oscar I"@sv ;
    solid-memo:back "1844–1859" ;
    solid-memo:backNote "House of Bernadotte. Son of Charles XIV John."@en ,
                        "Ätten Bernadotte. Son till Karl XIV Johan. Skrivs även Oskar I."@sv .

<#karl-xv>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Charles XV"@en ,
                     "Karl XV"@sv ;
    solid-memo:back "1859–1872" ;
    solid-memo:backNote "House of Bernadotte. Son of Oscar I."@en ,
                        "Ätten Bernadotte. Son till Oscar I."@sv .

<#oscar-ii>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Oscar II"@en ,
                     "Oscar II"@sv ;
    solid-memo:back "1872–1907" ;
    solid-memo:backNote "House of Bernadotte. Brother of Charles XV; the union with Norway was dissolved in his reign (1905)."@en ,
                        "Ätten Bernadotte. Bror till Karl XV; unionen med Norge upplöstes under hans regering (1905). Skrivs även Oskar II."@sv .

<#gustaf-v>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Gustaf V"@en ,
                     "Gustaf V"@sv ;
    solid-memo:back "1907–1950" ;
    solid-memo:backNote "House of Bernadotte. Son of Oscar II."@en ,
                        "Ätten Bernadotte. Son till Oscar II."@sv .

<#gustaf-vi-adolf>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Gustaf VI Adolf"@en ,
                     "Gustaf VI Adolf"@sv ;
    solid-memo:back "1950–1973" ;
    solid-memo:backNote "House of Bernadotte. Son of Gustaf V."@en ,
                        "Ätten Bernadotte. Son till Gustaf V."@sv .

<#carl-xvi-gustaf>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Carl XVI Gustaf"@en ,
                     "Carl XVI Gustaf"@sv ;
    solid-memo:back "1973–" ;
    solid-memo:backNote "House of Bernadotte. Grandson of Gustaf VI Adolf; the reigning king (as of 2026)."@en ,
                        "Ätten Bernadotte. Sonson till Gustaf VI Adolf; regerande kung (2026)."@sv .

