<>
    a solid-memo:Deck ,
      dcat:Dataset ;
    dcterms:title "World Heritage Sites in the Nordic countries"@en ,
                  "Världsarv i Norden"@sv ;
    dcterms:creator <#anton-wiklund> ;
    dcterms:license <https://creativecommons.org/publicdomain/zero/1.0/> ;
    dcterms:description "All 44 UNESCO World Heritage Sites in the five Nordic countries – Sweden, Norway, Denmark (including Greenland; the Faroe Islands have none), Finland and Iceland – as inscribed on the World Heritage List on 4 October 2026, including the sites inscribed in 2025 and 2026. Front: the site, by UNESCO's English name or a short form of it and by its established Swedish name; back: the Nordic country or countries it lies in, with a note giving the year of inscription and, for sites that extend beyond the Nordic countries, the other countries. Taken from Wikidata (the English names of twelve sites are UNESCO's official names, which Wikidata does not use) and checked against UNESCO's World Heritage List, the Swedish National Heritage Board (Riksantikvarieämbetet) and the Swedish Wikipedia. Sources, method and quality control: https://github.com/antwika/solid-memo/blob/main/packages/deck-library/authored/nordic-world-heritage-sites.md"@en ,
                        "Alla 44 av Unescos världsarv i de fem nordiska länderna – Sverige, Norge, Danmark (med Grönland; Färöarna har inga), Finland och Island – så som de står på världsarvslistan den 4 oktober 2026, inklusive de världsarv som togs upp 2025 och 2026. Framsida: världsarvet, med Unescos engelska namn eller en kortform av det och med det vedertagna svenska namnet; baksida: det eller de nordiska länder där det ligger, med en anteckning om året då det blev världsarv och, för världsarv som sträcker sig utanför Norden, vilka de andra länderna är. Uppgifterna är hämtade från Wikidata (tolv världsarvs engelska namn är Unescos officiella namn, som Wikidata inte använder) och kontrollerade mot Unescos världsarvslista, Riksantikvarieämbetet och svenskspråkiga Wikipedia. Källor, metod och kvalitetskontroll: https://github.com/antwika/solid-memo/blob/main/packages/deck-library/authored/nordic-world-heritage-sites.md"@sv ;
    prov:wasDerivedFrom <https://www.wikidata.org/wiki/Q9259> ,
                        <https://www.nps.gov/orgs/1207/interior-department-celebrates-selection-of-pennsylvania-s-historic-moravian-bethlehem-district-to-unesco-world-heritage-list.htm> ;
    prov:wasGeneratedBy <#compilation> ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    dcat:theme <http://publications.europa.eu/resource/authority/data-theme/EDUC> ,
               topic:geography ,
               topic:history ;
    dcat:keyword "World Heritage" ,
                 "UNESCO" ,
                 "Nordic countries" ,
                 "Scandinavia" ,
                 "cultural heritage" ,
                 "världsarv" ,
                 "Unesco" ,
                 "Norden" ,
                 "Skandinavien" ,
                 "kulturarv" ;
    dcterms:language <http://publications.europa.eu/resource/authority/language/ENG> ,
                     <http://publications.europa.eu/resource/authority/language/SWE> ;
    solid-memo:studyDirection solid-memo:frontToBack ;
    solid-memo:formatVersion 4 ;
    dcat:version "1" ;
    dcterms:issued "2026-10-04T05:21:10Z"^^xsd:dateTime ;
    adms:versionNotes "First release: 44 cards, each checked against at least two sources; sources, method and quality control in authored/nordic-world-heritage-sites.md." ;
    dcterms:publisher <https://solid-memo.com/decks/index.ttl#solid-memo> ;
    dcat:inSeries <https://solid-memo.com/decks/index.ttl#nordic-world-heritage-sites> ;
    dcat:isVersionOf <https://solid-memo.com/decks/index.ttl#nordic-world-heritage-sites> ;
    dcat:distribution <#turtle> .

