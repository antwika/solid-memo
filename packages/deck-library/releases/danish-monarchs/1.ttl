    dcterms:title "Monarchs of Denmark"@en ,
                  "Danmarks regenter"@sv ;
    dcterms:creator <#anton-wiklund> ;
    dcterms:license <https://creativecommons.org/publicdomain/zero/1.0/> ;
    dcterms:description "The 22 monarchs of Denmark from Christian I, the first king of the House of Oldenburg (1448), to Frederik X, king since 14 January 2024, as of 4 October 2026. Front: the monarch's regnal name in English and Swedish; back: the years of the reign, counted from accession to death, deposition or abdication, with the royal house (Oldenburg or Glücksburg) and a short fact in a note. Taken from Wikidata (one note from the public-domain 1911 Encyclopædia Britannica) and checked against the Danish Royal House's list of monarchs (kongehuset.dk), Lex – Danmarks Nationalleksikon, Nationalencyklopedin and the Swedish Wikipedia. Sources, method and quality control: https://github.com/antwika/solid-memo/blob/main/packages/deck-library/authored/danish-monarchs.md"@en ,
                        "Danmarks 22 regenter från Kristian I, den förste kungen av huset Oldenburg (1448), till Frederik X, kung sedan den 14 januari 2024, per den 4 oktober 2026. Framsida: regentens namn på engelska och svenska; baksida: regeringsåren, räknade från trontillträdet till regentens död, avsättning eller abdikation, med kungahuset (Oldenburg eller Glücksburg) och en kort upplysning i en anteckning. Uppgifterna är hämtade från Wikidata (en anteckning från Encyclopædia Britannica 1911, som är fri från upphovsrätt) och kontrollerade mot det danska kungahusets regentlängd (kongehuset.dk), Lex – Danmarks Nationalleksikon, Nationalencyklopedin och svenskspråkiga Wikipedia. Källor, metod och kvalitetskontroll: https://github.com/antwika/solid-memo/blob/main/packages/deck-library/authored/danish-monarchs.md"@sv ;
    prov:wasDerivedFrom <https://www.wikidata.org/wiki/Q18341329> ,
                        <https://en.wikisource.org/wiki/1911_Encyclop%C3%A6dia_Britannica/Christian_IV.> ;
    prov:wasGeneratedBy <#compilation> ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
