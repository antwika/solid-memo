<>
    a solid-memo:Deck ,
      dcat:Dataset ;
    dcterms:title "Country-code top-level domains"@en ,
                  "Nationella toppdomäner"@sv ;
    dcterms:creator <#anton-wiklund> ;
    dcterms:license <https://creativecommons.org/publicdomain/zero/1.0/> ;
    dcterms:description "The country-code top-level domain (ccTLD) of each of the 193 UN member states: 193 cards with the country on the front, in English and Swedish, and its two-letter Internet domain on the back, such as Sweden → .se, studied in both directions. Each card gives the domain IANA has delegated to the country's registry, formed from its ISO 3166-1 code except for the United Kingdom (.uk, not .gb); internationalised domains in other scripts and the domains of territories that are not UN members are left out. Compiled from Wikidata and checked against IANA's Root Zone Database and the DNS root zone file. Sources, method and quality control: https://github.com/antwika/solid-memo/blob/main/packages/deck-library/authored/country-code-top-level-domains.md"@en ,
                        "Den nationella toppdomänen (ccTLD) för vart och ett av FN:s 193 medlemsländer: 193 kort med landet på framsidan, på engelska och svenska, och dess tvåbokstaviga internetdomän på baksidan, till exempel Sverige → .se, att öva i båda riktningarna. Varje kort ger den domän som IANA har delegerat till landets domänregister, bildad av landets ISO 3166-1-kod utom för Storbritannien (.uk, inte .gb); internationaliserade domäner i andra skriftsystem och domäner för territorier som inte är medlemmar i FN ingår inte. Sammanställd från Wikidata och kontrollerad mot IANA:s rotzonsdatabas (Root Zone Database) och DNS-rotzonfilen. Källor, metod och kvalitetskontroll: https://github.com/antwika/solid-memo/blob/main/packages/deck-library/authored/country-code-top-level-domains.md"@sv ;
    prov:wasDerivedFrom <https://www.wikidata.org/> ;
    prov:wasGeneratedBy <#compilation> ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    dcat:theme <http://publications.europa.eu/resource/authority/data-theme/EDUC> ,
               topic:computing ,
               topic:geography ;
    dcat:keyword "top-level domains" ,
                 "ccTLD" ,
                 "Internet domains" ,
                 "DNS" ,
                 "countries" ,
                 "toppdomäner" ,
                 "nationella toppdomäner" ,
                 "domännamn" ,
                 "internet" ,
                 "länder" ;
    dcterms:language <http://publications.europa.eu/resource/authority/language/ENG> ,
                     <http://publications.europa.eu/resource/authority/language/SWE> ;
    solid-memo:studyDirection solid-memo:bidirectional ;
    solid-memo:formatVersion 4 ;
    dcat:version "1" ;
    dcterms:issued "2026-10-04T05:20:50Z"^^xsd:dateTime ;
    adms:versionNotes "First release: 193 cards, each checked against at least two sources; sources, method and quality control in authored/country-code-top-level-domains.md." ;
    dcterms:publisher <https://solid-memo.com/decks/index.ttl#solid-memo> ;
    dcat:inSeries <https://solid-memo.com/decks/index.ttl#country-code-top-level-domains> ;
    dcat:isVersionOf <https://solid-memo.com/decks/index.ttl#country-code-top-level-domains> ;
    dcat:distribution <#turtle> .

