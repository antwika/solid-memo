# How this deck was made (W3C PROV-O): researched card by card from the sources below,
# each card checked against at least two of them. The full record is the provenance report.
<#compilation>
    a prov:Activity ;
    prov:endedAtTime "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    prov:used <https://www.wikidata.org/wiki/Q35657> ,
              <https://www.census.gov/schools/statefacts/> ,
              <https://www.ne.se/uppslagsverk/> ;
    prov:wasAssociatedWith <#anton-wiklund> ,
                           <https://github.com/antwika/solid-memo/blob/main/packages/deck-library/scripts/authored_decks.py> ;
    rdfs:seeAlso <https://github.com/antwika/solid-memo/blob/main/packages/deck-library/authored/us-states-and-capitals.md> ;
    rdfs:comment "Compiled from the dossier authored/us-states-and-capitals.json, which records every source, the method, the quality-control rounds and the evidence for each card; built with python3 packages/deck-library/scripts/authored_decks.py build us-states-and-capitals." .

<https://github.com/antwika/solid-memo/blob/main/packages/deck-library/scripts/authored_decks.py>
    a prov:SoftwareAgent ;
    dcterms:title "authored_decks.py" .

<https://www.wikidata.org/wiki/Q35657>
    dcterms:title "Wikidata: the states of the United States (instances of Q35657), their capitals (P36) and the English, Swedish and multilingual labels and aliases of the states and the capitals" ;
    dcterms:creator "Wikidata contributors" ;
    dcterms:license <https://creativecommons.org/publicdomain/zero/1.0/> .

<https://www.census.gov/schools/statefacts/>
    dcterms:title "U.S. Census Bureau, State Facts for Students (Statistics in Schools), the page of each state" ;
    dcterms:creator "U.S. Census Bureau" .

<https://www.ne.se/uppslagsverk/>
    dcterms:title "Nationalencyklopedin (NE), the articles on the 50 states" ;
    dcterms:creator "NE Nationalencyklopedin AB" .

