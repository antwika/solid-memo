<>
    a solid-memo:Deck ,
      dcat:Dataset ;
    dcterms:title "Spelling alphabets: international and Swedish"@en ,
                  "Bokstaveringsalfabet: internationellt och svenskt"@sv ;
    dcterms:creator <#anton-wiklund> ;
    dcterms:license <https://creativecommons.org/publicdomain/zero/1.0/> ;
    dcterms:description "Two spelling alphabets, 55 cards: all 26 letters of the international radiotelephony spelling alphabet, known as the NATO alphabet, in the ICAO spellings (Alfa, Bravo … Juliett … Zulu), and all 29 letters of the Swedish spelling alphabet (Adam, Bertil, Cesar … Åke, Ärlig, Östen) as the Swedish Transport Agency's regulations TSFS 2019:36 lay it down. Front: a letter and its alphabet; back: the code word, with notes on spellings that are easy to get wrong or that other bodies write differently. Taken from TSFS 2019:36 and the FAA's Aeronautical Information Manual, checked against the rules of the air SERA.14020 (the UK CAA's copy), the Swedish Armed Forces and Wikipedia. Sources, method and quality control: https://github.com/antwika/solid-memo/blob/main/packages/deck-library/authored/spelling-alphabets.md"@en ,
                        "Två bokstaveringsalfabet, 55 kort: alla 26 bokstäver i det internationella bokstaveringsalfabetet för radiotelefoni, som också Nato använder, med ICAO:s stavning (Alfa, Bravo … Juliett … Zulu), och alla 29 bokstäver i det svenska bokstaveringsalfabetet (Adam, Bertil, Cesar … Åke, Ärlig, Östen) så som Transportstyrelsens föreskrifter TSFS 2019:36 anger det. Framsida: en bokstav och dess alfabet; baksida: bokstaveringsordet, med en kommentar om stavningar som är lätta att ta fel på eller som andra myndigheter skriver annorlunda. Uppgifterna är hämtade från TSFS 2019:36 och amerikanska FAA:s Aeronautical Information Manual och kontrollerade mot luftfartsreglerna SERA.14020 (brittiska CAA:s utgåva), Försvarsmakten och Wikipedia. Källor, metod och kvalitetskontroll: https://github.com/antwika/solid-memo/blob/main/packages/deck-library/authored/spelling-alphabets.md"@sv ;
    prov:wasDerivedFrom <https://www.transportstyrelsen.se/TSFS/TSFS%202019_36k.pdf> ,
                        <https://www.faa.gov/air_traffic/publications/atpubs/aim_html/chap4_section_2.html> ;
    prov:wasGeneratedBy <#compilation> ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    dcat:theme <http://publications.europa.eu/resource/authority/data-theme/EDUC> ,
               topic:languages ,
               topic:swedish ;
    dcat:keyword "spelling alphabet"@en ,
                 "NATO alphabet"@en ,
                 "ICAO"@en ,
                 "radiotelephony"@en ,
                 "Swedish spelling alphabet"@en ,
                 "bokstavering"@sv ,
                 "bokstaveringsalfabet"@sv ,
                 "ICAO"@sv ,
                 "Nato"@sv ,
                 "radiotelefoni"@sv ,
                 "svenska bokstaveringsalfabetet"@sv ;
    dcterms:language <http://publications.europa.eu/resource/authority/language/ENG> ,
                     <http://publications.europa.eu/resource/authority/language/SWE> ;
    solid-memo:studyDirection solid-memo:frontToBack ;
    solid-memo:formatVersion 5 ;
    dcat:version "1" ;
    dcterms:issued "2026-10-04T20:13:27Z"^^xsd:dateTime ;
    adms:versionNotes "First release: 55 cards, each checked against at least two sources; sources, method and quality control in authored/spelling-alphabets.md." ;
    dcterms:publisher <https://solid-memo.com/decks/index.ttl#solid-memo> ;
    dcat:inSeries <https://solid-memo.com/decks/index.ttl#spelling-alphabets> ;
    dcat:isVersionOf <https://solid-memo.com/decks/index.ttl#spelling-alphabets> ;
