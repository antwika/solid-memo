<#html>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "The root element of an HTML document"@en ,
                     "Rotelementet i ett HTML-dokument"@sv ;
    solid-memo:back "<html>"@zxx .

<#head>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "The container for the document's metadata"@en ,
                     "Behållaren för dokumentets metadata"@sv ;
    solid-memo:back "<head>"@zxx .

<#title>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "The document's title or name, used for example in bookmarks and the browser history"@en ,
                     "Dokumentets titel eller namn, som används till exempel i bokmärken och webbläsarhistoriken"@sv ;
    solid-memo:back "<title>"@zxx .

<#link>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Metadata that links the document to another resource, such as a style sheet or an icon"@en ,
                     "Metadata som kopplar dokumentet till en annan resurs, till exempel en CSS-fil eller en ikon"@sv ;
    solid-memo:back "<link>"@zxx ;
    solid-memo:backNote "Clickable links in the content are made with <a>."@en ,
                        "Klickbara länkar i innehållet görs med <a>."@sv .

<#meta>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Metadata that the <title>, <base>, <link>, <style> and <script> elements cannot express, such as the character encoding"@en ,
                     "Metadata som elementen <title>, <base>, <link>, <style> och <script> inte kan uttrycka, till exempel teckenkodningen"@sv ;
    solid-memo:back "<meta>"@zxx .

<#style>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Embedded CSS style information"@en ,
                     "Inbäddad stilinformation i CSS"@sv ;
    solid-memo:back "<style>"@zxx .

<#body>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "The contents of the document, as opposed to its metadata"@en ,
                     "Dokumentets innehåll, till skillnad från dess metadata"@sv ;
    solid-memo:back "<body>"@zxx .

<#script>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Embedded or external program code, usually JavaScript"@en ,
                     "Inbäddad eller extern programkod, oftast JavaScript"@sv ;
    solid-memo:back "<script>"@zxx ;
    solid-memo:backNote "It can also hold a data block, such as JSON, that the browser does not run."@en ,
                        "Det kan också innehålla ett datablock, till exempel JSON, som webbläsaren inte kör."@sv .

<#main>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "The main content of the document"@en ,
                     "Dokumentets huvudinnehåll"@sv ;
    solid-memo:back "<main>"@zxx ;
    solid-memo:backNote "A document may have only one <main> without the hidden attribute."@en ,
                        "Ett dokument får bara ha ett <main> utan attributet hidden."@sv .

<#header>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Introductory content for a page or section, such as its heading, a logo or a search form"@en ,
                     "Inledande innehåll för en sida eller ett avsnitt, till exempel dess rubrik, en logotyp eller ett sökformulär"@sv ;
    solid-memo:back "<header>"@zxx .

<#footer>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "A footer for a page or section, with information such as who wrote it and copyright details"@en ,
                     "En sidfot för en sida eller ett avsnitt, till exempel med upphovsperson och uppgifter om upphovsrätt"@sv ;
    solid-memo:back "<footer>"@zxx .

<#nav>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "A section of navigation links"@en ,
                     "Ett avsnitt med navigeringslänkar"@sv ;
    solid-memo:back "<nav>"@zxx .

<#article>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "A self-contained composition that could be distributed on its own, such as a blog post or a forum post"@en ,
                     "En fristående innehållsdel som skulle kunna spridas på egen hand, till exempel ett blogginlägg eller ett foruminlägg"@sv ;
    solid-memo:back "<article>"@zxx .

<#section>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "A generic thematic grouping of content, typically with its own heading"@en ,
                     "En allmän tematisk gruppering av innehåll, normalt med en egen rubrik"@sv ;
    solid-memo:back "<section>"@zxx ;
    solid-memo:backNote "Not a mere styling wrapper: for that, use <div>."@en ,
                        "Inte bara en behållare för formatering: till det används <div>."@sv .

<#aside>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Content only tangentially related to the content around it, often shown as a sidebar"@en ,
                     "Innehåll som bara har ett löst samband med innehållet runt omkring, ofta visat i en spalt vid sidan av"@sv ;
    solid-memo:back "<aside>"@zxx .

<#h1>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "A heading for a top-level section"@en ,
                     "En rubrik för ett avsnitt på översta nivån"@sv ;
    solid-memo:back "<h1>"@zxx ;
    solid-memo:backNote "<h2> to <h6> head ever deeper subsections."@en ,
                        "<h2> till <h6> är rubriker för allt djupare underavsnitt."@sv .

<#p>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "A paragraph"@en ,
                     "Ett stycke"@sv ;
    solid-memo:back "<p>"@zxx .

<#hr>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "A paragraph-level thematic break, such as a scene change in a story"@en ,
                     "Ett tematiskt avbrott på styckenivå, till exempel ett scenbyte i en berättelse"@sv ;
    solid-memo:back "<hr>"@zxx ;
    solid-memo:backNote "Browsers draw it as a horizontal line by default."@en ,
                        "Webbläsare visar det som en vågrät linje som standard."@sv .

<#pre>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "A block of preformatted text, shown with its spaces and line breaks as written"@en ,
                     "Ett block med förformaterad text som visas med mellanslag och radbrytningar som de är skrivna"@sv ;
    solid-memo:back "<pre>"@zxx .

<#blockquote>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "A section quoted from another source, set off as a block of its own"@en ,
                     "Ett avsnitt som citeras från en annan källa, avskilt som ett eget block"@sv ;
    solid-memo:back "<blockquote>"@zxx .

<#ol>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "A list whose order matters, numbered by default"@en ,
                     "En lista där ordningen spelar roll, numrerad som standard"@sv ;
    solid-memo:back "<ol>"@zxx .

<#ul>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "A list whose order does not matter, with bullets by default"@en ,
                     "En lista där ordningen inte spelar roll, med punkter som standard"@sv ;
    solid-memo:back "<ul>"@zxx ;
    solid-memo:backNote "<menu> is a similar list, meant as a toolbar of commands."@en ,
                        "<menu> är en liknande lista, tänkt som ett verktygsfält med kommandon."@sv .

<#li>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "An item in a list"@en ,
                     "Ett objekt i en lista"@sv ;
    solid-memo:back "<li>"@zxx .

<#figure>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Self-contained content, such as an image or a diagram, with an optional caption"@en ,
                     "Fristående innehåll, till exempel en bild eller ett diagram, med en valfri bildtext"@sv ;
    solid-memo:back "<figure>"@zxx .

<#figcaption>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "The caption of a figure"@en ,
                     "Bildtexten till en figur"@sv ;
    solid-memo:back "<figcaption>"@zxx ;
    solid-memo:backNote "It goes first or last inside <figure>."@en ,
                        "Det placeras först eller sist i <figure>."@sv .

<#div>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "A generic container for blocks of content, with no meaning of its own"@en ,
                     "En allmän behållare för innehållsblock, utan egen betydelse"@sv ;
    solid-memo:back "<div>"@zxx ;
    solid-memo:backNote "The HTML standard calls it an element of last resort, for when no other element fits."@en ,
                        "HTML-standarden kallar det en sista utväg, när inget annat element passar."@sv .

<#a>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "A hyperlink in the content, labelled by its own content"@en ,
                     "En hyperlänk i innehållet som får sin etikett från sitt eget innehåll"@sv ;
    solid-memo:back "<a>"@zxx ;
    solid-memo:backNote "<link> links the whole document to resources such as style sheets."@en ,
                        "<link> kopplar hela dokumentet till resurser som CSS-filer."@sv .

<#em>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Stress emphasis, which changes the meaning of the sentence"@en ,
                     "Betoning som ändrar meningens innebörd"@sv ;
    solid-memo:back "<em>"@zxx ;
    solid-memo:backNote "Shown in italics by default."@en ,
                        "Visas som standard i kursiv stil."@sv .

<#strong>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Strong importance, seriousness or urgency"@en ,
                     "Stor vikt, allvar eller brådska"@sv ;
    solid-memo:back "<strong>"@zxx ;
    solid-memo:backNote "Shown in a bolder weight (normally bold) by default."@en ,
                        "Visas som standard i fetare stil (normalt fetstil)."@sv .

<#q>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "A quotation within the running text"@en ,
                     "Ett citat i den löpande texten"@sv ;
    solid-memo:back "<q>"@zxx ;
    solid-memo:backNote "Browsers add the quotation marks."@en ,
                        "Webbläsare lägger till citattecknen."@sv .

<#abbr>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "An abbreviation or acronym"@en ,
                     "En förkortning eller akronym"@sv ;
    solid-memo:back "<abbr>"@zxx ;
    solid-memo:backNote "Its title attribute can give the expansion. The old <acronym> element is obsolete: use <abbr>."@en ,
                        "Attributet title kan ange vad förkortningen står för. Det gamla elementet <acronym> är föråldrat: använd <abbr>."@sv .

<#code>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "A fragment of computer code"@en ,
                     "En bit datorkod"@sv ;
    solid-memo:back "<code>"@zxx .

<#sub>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "A subscript, such as the 10 in x₁₀"@en ,
                     "Nedsänkt text, till exempel tian i x₁₀"@sv ;
    solid-memo:back "<sub>"@zxx .

<#sup>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "A superscript, such as the 2 in E = mc²"@en ,
                     "Upphöjd text, till exempel tvåan i E = mc²"@sv ;
    solid-memo:back "<sup>"@zxx .

<#mark>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Text highlighted for reference because of its relevance elsewhere, such as a search match"@en ,
                     "Text som markerats för att den är relevant i ett annat sammanhang, till exempel en sökträff"@sv ;
    solid-memo:back "<mark>"@zxx .

<#time>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "A date or time, together with a machine-readable form of it"@en ,
                     "Ett datum eller en tidpunkt, tillsammans med en maskinläsbar form av det"@sv ;
    solid-memo:back "<time>"@zxx .

<#br>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "A line break, as in a poem or a postal address"@en ,
                     "En radbrytning, som i en dikt eller en postadress"@sv ;
    solid-memo:back "<br>"@zxx .

<#span>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "A generic container for a run of text, with no meaning of its own"@en ,
                     "En allmän behållare för en bit text, utan egen betydelse"@sv ;
    solid-memo:back "<span>"@zxx .

<#img>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "An image"@en ,
                     "En bild"@sv ;
    solid-memo:back "<img>"@zxx ;
    solid-memo:backNote "A <picture> element can wrap it to offer alternative image sources."@en ,
                        "Ett <picture>-element kan omsluta det för att erbjuda alternativa bildkällor."@sv .

<#iframe>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "A frame that shows another web page inside this one"@en ,
                     "En ram som visar en annan webbsida inuti den här"@sv ;
    solid-memo:back "<iframe>"@zxx ;
    solid-memo:backNote "The i stands for inline: an inline frame."@en ,
                        "Bokstaven i står för engelskans inline, alltså en ”inline frame”."@sv .

<#video>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "A video player"@en ,
                     "En videospelare"@sv ;
    solid-memo:back "<video>"@zxx .

<#audio>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "A player for sound or an audio stream"@en ,
                     "En spelare för ljud eller en ljudström"@sv ;
    solid-memo:back "<audio>"@zxx .

<#canvas>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "A drawing surface on which scripts draw graphics, such as charts or game graphics"@en ,
                     "En rityta som skript ritar grafik på, till exempel diagram eller spelgrafik"@sv ;
    solid-memo:back "<canvas>"@zxx .

<#table>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "A table of data in rows and columns"@en ,
                     "En tabell med data i rader och kolumner"@sv ;
    solid-memo:back "<table>"@zxx .

<#tr>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "A row of cells in a table"@en ,
                     "En rad med celler i en tabell"@sv ;
    solid-memo:back "<tr>"@zxx .

<#td>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "A data cell in a table"@en ,
                     "En datacell i en tabell"@sv ;
    solid-memo:back "<td>"@zxx .

<#th>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "A header cell in a table"@en ,
                     "En rubrikcell i en tabell"@sv ;
    solid-memo:back "<th>"@zxx .

<#form>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "A form that the user can fill in and submit"@en ,
                     "Ett formulär som användaren kan fylla i och skicka in"@sv ;
    solid-memo:back "<form>"@zxx .

<#input>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "A form field whose kind, such as text, checkbox or date, is set by its type attribute"@en ,
                     "Ett formulärfält vars sort, till exempel text, kryssruta eller datum, anges med attributet type"@sv ;
    solid-memo:back "<input>"@zxx .

<#button>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "A button labelled by its own content"@en ,
                     "En knapp som får sin etikett från sitt eget innehåll"@sv ;
    solid-memo:back "<button>"@zxx ;
    solid-memo:backNote "<input type=\"submit\"> also makes a button, but takes its label from the value attribute."@en ,
                        "<input type=\"submit\"> ger också en knapp, men den får sin etikett från attributet value."@sv .

<#label>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "A caption for a form control"@en ,
                     "En etikett för en formulärkontroll"@sv ;
    solid-memo:back "<label>"@zxx .

<#select>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "A control for choosing among a set of options, such as a drop-down list"@en ,
                     "En kontroll för att välja bland ett antal alternativ, till exempel en rullgardinsmeny"@sv ;
    solid-memo:back "<select>"@zxx .

<#textarea>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "A text field for several lines of plain text"@en ,
                     "Ett textfält för flera rader oformaterad text"@sv ;
    solid-memo:back "<textarea>"@zxx .

<#details>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "A disclosure widget that the user can open to see more information"@en ,
                     "En utfällbar ruta som användaren kan öppna för att se mer information"@sv ;
    solid-memo:back "<details>"@zxx ;
    solid-memo:backNote "Its always-visible label is the <summary> element."@en ,
                        "Dess alltid synliga rubrik är elementet <summary>."@sv .

<#dialog>
    a solid-memo:Card ;
