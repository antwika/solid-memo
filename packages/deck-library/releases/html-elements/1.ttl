<>
    a solid-memo:Deck ,
      dcat:Dataset ;
    dcterms:title "HTML elements"@en ,
                  "HTML-element"@sv ;
    dcterms:creator <#anton-wiklund> ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:description "55 everyday elements of HTML, the markup language of the web: the front says in plain words what an element is for, in English and Swedish, and the back gives its tag, such as <a> or <main>. Covers the document and its metadata, sections, text, lists, images and media, tables and forms; obsolete elements are left out. Based on the WHATWG HTML Living Standard (CC BY 4.0), with every card checked against MDN Web Docs and Wikidata. Sources, method and quality control: https://github.com/antwika/solid-memo/blob/main/packages/deck-library/authored/html-elements.md"@en ,
                        "55 vanliga element i HTML, webbens märkspråk: på framsidan står med vanliga ord vad ett element används till, på engelska och svenska, och på baksidan dess tagg, till exempel <a> eller <main>. Täcker dokumentet och dess metadata, avsnitt, text, listor, bilder och media, tabeller och formulär; föråldrade element är utelämnade. Bygger på WHATWG:s HTML Living Standard (CC BY 4.0), och varje kort är kontrollerat mot MDN Web Docs och Wikidata. Källor, metod och kvalitetskontroll: https://github.com/antwika/solid-memo/blob/main/packages/deck-library/authored/html-elements.md"@sv ;
    prov:wasDerivedFrom <https://html.spec.whatwg.org/multipage/> ,
                        <https://www.wikidata.org/> ;
    prov:wasGeneratedBy <#compilation> ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    dcat:theme <http://publications.europa.eu/resource/authority/data-theme/EDUC> ,
               topic:computing ;
    dcat:keyword "HTML"@en ,
                 "web development"@en ,
                 "markup"@en ,
                 "elements"@en ,
                 "tags"@en ,
                 "WHATWG"@en ,
                 "HTML"@sv ,
                 "webbutveckling"@sv ,
                 "märkspråk"@sv ,
                 "element"@sv ,
                 "taggar"@sv ,
                 "WHATWG"@sv ;
    dcterms:language <http://publications.europa.eu/resource/authority/language/ENG> ,
                     <http://publications.europa.eu/resource/authority/language/SWE> ;
    solid-memo:studyDirection solid-memo:frontToBack ;
    solid-memo:formatVersion 5 ;
    dcat:version "1" ;
    dcterms:issued "2026-10-04T20:03:46Z"^^xsd:dateTime ;
    adms:versionNotes "First release: 55 cards, each checked against at least two sources; sources, method and quality control in authored/html-elements.md." ;
    dcterms:publisher <https://solid-memo.com/decks/index.ttl#solid-memo> ;
    dcat:inSeries <https://solid-memo.com/decks/index.ttl#html-elements> ;
    dcat:isVersionOf <https://solid-memo.com/decks/index.ttl#html-elements> ;
    dcat:distribution <#turtle> .

