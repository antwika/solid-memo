<#init>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Create a new, empty Git repository in the current directory"@en ,
                     "Skapa ett nytt, tomt Git-arkiv i den aktuella katalogen"@sv ;
    solid-memo:back "git init" .

<#clone>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Copy a remote repository, with its whole history, into a new directory"@en ,
                     "Kopiera ett fjärrarkiv med hela dess historik till en ny katalog"@sv ;
    solid-memo:back "git clone <url>" .

<#config-name>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Set the name recorded in your commits, for all your repositories"@en ,
                     "Ange namnet som skrivs in i dina incheckningar, för alla dina arkiv"@sv ;
    solid-memo:back "git config set --global user.name \"<name>\"" ;
    solid-memo:backNote "Subcommand form since Git 2.46. The older form git config --global user.name \"<name>\" is still accepted."@en ,
                        "Underkommandoformen finns sedan Git 2.46. Den äldre formen git config --global user.name \"<name>\" fungerar fortfarande."@sv .

<#config-email>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Set the email address recorded in your commits, for all your repositories"@en ,
                     "Ange e-postadressen som skrivs in i dina incheckningar, för alla dina arkiv"@sv ;
    solid-memo:back "git config set --global user.email \"<email>\"" ;
    solid-memo:backNote "Subcommand form since Git 2.46. The older form git config --global user.email \"<email>\" is still accepted."@en ,
                        "Underkommandoformen finns sedan Git 2.46. Den äldre formen git config --global user.email \"<email>\" fungerar fortfarande."@sv .

<#status>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Show which files are staged, modified or untracked"@en ,
                     "Visa vilka filer som är köade, ändrade eller ospårade"@sv ;
    solid-memo:back "git status" .

<#add-file>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Stage the changes in one file for the next commit"@en ,
                     "Köa ändringarna i en fil inför nästa incheckning"@sv ;
    solid-memo:back "git add <file>" .

<#add-all>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Stage every change in the whole working tree, including new and deleted files"@en ,
                     "Köa alla ändringar i hela arbetskatalogen, även nya och borttagna filer"@sv ;
    solid-memo:back "git add -A" ;
    solid-memo:backNote "Long form: --all. git add . only stages changes in the current directory and below."@en ,
                        "Lång form: --all. git add . köar bara ändringar i den aktuella katalogen och dess underkataloger."@sv .

<#add-patch>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Choose interactively which parts (hunks) of your changes to stage"@en ,
                     "Välj interaktivt vilka delar (stycken) av dina ändringar som ska köas"@sv ;
    solid-memo:back "git add -p" ;
    solid-memo:backNote "Long form: --patch. Answer y or n for each hunk."@en ,
                        "Lång form: --patch. Svara y eller n för varje stycke."@sv .

<#diff>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Show the changes in the working tree that are not yet staged"@en ,
                     "Visa ändringarna i arbetskatalogen som ännu inte är köade"@sv ;
    solid-memo:back "git diff" .

<#diff-staged>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Show the staged changes that will go into the next commit"@en ,
                     "Visa de köade ändringarna som kommer med i nästa incheckning"@sv ;
    solid-memo:back "git diff --staged" ;
    solid-memo:backNote "--cached is a synonym."@en ,
                        "--cached betyder samma sak."@sv .

<#commit-message>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Commit the staged changes with a message given on the command line"@en ,
                     "Checka in de köade ändringarna med ett meddelande som anges på kommandoraden"@sv ;
    solid-memo:back "git commit -m \"<message>\"" .

<#commit-amend>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Replace the last commit with a new one that also contains the staged changes, editing its message"@en ,
                     "Ersätt den senaste incheckningen med en ny som även innehåller de köade ändringarna, och redigera meddelandet"@sv ;
    solid-memo:back "git commit --amend" ;
    solid-memo:backNote "Add --no-edit to keep the message unchanged. Avoid amending commits you have already pushed."@en ,
                        "Lägg till --no-edit för att behålla meddelandet. Undvik att ändra incheckningar som du redan har skickat till ett fjärrarkiv (push)."@sv .

<#restore>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Discard the unstaged changes to a file"@en ,
                     "Kasta bort de oköade ändringarna i en fil"@sv ;
    solid-memo:back "git restore <file>" ;
    solid-memo:backNote "Older equivalent: git checkout -- <file>. The discarded changes cannot be recovered."@en ,
                        "Äldre motsvarighet: git checkout -- <file>. Ändringarna som kastas går inte att få tillbaka."@sv .

<#restore-staged>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Unstage a file but keep its changes in the working tree"@en ,
                     "Ta bort en fil från kön men behåll ändringarna i arbetskatalogen"@sv ;
    solid-memo:back "git restore --staged <file>" ;
    solid-memo:backNote "Older equivalent: git reset <file>."@en ,
                        "Äldre motsvarighet: git reset <file>."@sv .

<#rm>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Delete a tracked file and stage its removal"@en ,
                     "Ta bort en spårad fil och köa borttagningen"@sv ;
    solid-memo:back "git rm <file>" .

<#rm-cached>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Stop tracking a file but keep it in the working tree"@en ,
                     "Sluta spåra en fil men behåll den i arbetskatalogen"@sv ;
    solid-memo:back "git rm --cached <file>" ;
    solid-memo:backNote "The file becomes untracked; list it in .gitignore to keep it out of later commits."@en ,
                        "Filen blir ospårad; lägg till den i .gitignore så att den inte kommer med i senare incheckningar."@sv .

<#mv>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Rename a tracked file and stage the rename"@en ,
                     "Byt namn på en spårad fil och köa namnbytet"@sv ;
    solid-memo:back "git mv <old> <new>" .

<#branch-list>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "List the local branches"@en ,
                     "Visa de lokala grenarna"@sv ;
    solid-memo:back "git branch" ;
    solid-memo:backNote "The current branch is marked with *. Add -a to include remote-tracking branches."@en ,
                        "Den aktuella grenen är markerad med *. Lägg till -a för att även visa fjärrspårande grenar."@sv .

<#branch-create>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Create a new branch without switching to it"@en ,
                     "Skapa en ny gren utan att byta till den"@sv ;
    solid-memo:back "git branch <branch>" .

<#switch>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Switch to an existing branch"@en ,
                     "Byt till en befintlig gren"@sv ;
    solid-memo:back "git switch <branch>" ;
    solid-memo:backNote "Older equivalent: git checkout <branch>."@en ,
                        "Äldre motsvarighet: git checkout <branch>."@sv .

<#switch-create>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Create a new branch and switch to it"@en ,
                     "Skapa en ny gren och byt till den"@sv ;
    solid-memo:back "git switch -c <branch>" ;
    solid-memo:backNote "Older equivalent: git checkout -b <branch>. Long form: --create."@en ,
                        "Äldre motsvarighet: git checkout -b <branch>. Lång form: --create."@sv .

<#switch-previous>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Switch back to the branch you were on before"@en ,
                     "Byt tillbaka till grenen du var på innan"@sv ;
    solid-memo:back "git switch -" ;
    solid-memo:backNote "Older equivalent: git checkout -."@en ,
                        "Äldre motsvarighet: git checkout -."@sv .

<#branch-rename>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Rename the current branch"@en ,
                     "Byt namn på den aktuella grenen"@sv ;
    solid-memo:back "git branch -m <new-name>" ;
    solid-memo:backNote "Long form: --move."@en ,
                        "Lång form: --move."@sv .

<#branch-delete>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Delete a local branch that has been fully merged"@en ,
                     "Ta bort en lokal gren som redan är helt sammanslagen"@sv ;
    solid-memo:back "git branch -d <branch>" .

<#branch-force-delete>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Delete a local branch even if it has not been merged"@en ,
                     "Ta bort en lokal gren även om den inte har slagits ihop"@sv ;
    solid-memo:back "git branch -D <branch>" ;
    solid-memo:backNote "Short for --delete --force. Git prints the deleted branch's last commit id ('was …'); git branch <branch> <id> recreates the branch."@en ,
                        "Förkortning av --delete --force. Git skriver ut id:t för grenens sista incheckning ('var …'); git branch <branch> <id> återskapar grenen."@sv .

<#merge>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Merge another branch into the current branch"@en ,
                     "Slå ihop en annan gren med den aktuella grenen"@sv ;
    solid-memo:back "git merge <branch>" .

<#merge-abort>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Abandon a merge that stopped with conflicts and go back to the state before it"@en ,
                     "Avbryt en sammanslagning som har stoppats av konflikter och gå tillbaka till läget före den"@sv ;
    solid-memo:back "git merge --abort" .

<#rebase>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Move the current branch's commits so that they start from the tip of another branch"@en ,
                     "Flytta den aktuella grenens incheckningar så att de utgår från toppen av en annan gren"@sv ;
    solid-memo:back "git rebase <branch>" ;
    solid-memo:backNote "This rewrites the branch's commits; avoid rebasing commits others have already fetched."@en ,
                        "Detta skriver om grenens incheckningar; undvik att ombasera incheckningar som andra redan har hämtat."@sv .

<#rebase-continue>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Continue a rebase after resolving and staging the conflicts"@en ,
                     "Fortsätt en ombasering efter att du har löst och köat konflikterna"@sv ;
    solid-memo:back "git rebase --continue" .

<#rebase-abort>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Cancel a rebase in progress and return to the state before it began"@en ,
                     "Avbryt en pågående ombasering och återgå till läget innan den började"@sv ;
    solid-memo:back "git rebase --abort" .

<#cherry-pick>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Apply the change made by one existing commit as a new commit on the current branch"@en ,
                     "Tillämpa ändringen från en befintlig incheckning som en ny incheckning på den aktuella grenen"@sv ;
    solid-memo:back "git cherry-pick <commit>" .

<#log>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Show the commit history of the current branch"@en ,
                     "Visa incheckningshistoriken för den aktuella grenen"@sv ;
    solid-memo:back "git log" .

<#log-oneline>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Show the commit history with one short line per commit"@en ,
                     "Visa incheckningshistoriken med en kort rad per incheckning"@sv ;
    solid-memo:back "git log --oneline" .

<#log-follow>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "List the commits that changed one file, including those made before it was renamed"@en ,
                     "Lista incheckningarna som ändrade en fil, även de som gjordes innan den bytte namn"@sv ;
    solid-memo:back "git log --follow <file>" .

<#show>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Show a commit's author, message and changes"@en ,
                     "Visa en incheckning med författare, meddelande och ändringar"@sv ;
    solid-memo:back "git show <commit>" ;
    solid-memo:backNote "Without an argument it shows the latest commit (HEAD)."@en ,
                        "Utan argument visas den senaste incheckningen (HEAD)."@sv .

<#blame>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "For each line of a file, show the commit that last changed it and who made that commit"@en ,
                     "Visa för varje rad i en fil vilken incheckning som senast ändrade den och vem som gjorde incheckningen"@sv ;
    solid-memo:back "git blame <file>" .

<#reflog>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Show where HEAD has recently pointed, to find lost commits"@en ,
                     "Visa var HEAD nyligen har pekat, för att hitta förlorade incheckningar"@sv ;
    solid-memo:back "git reflog" .

<#remote-list>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "List the remotes with their URLs"@en ,
                     "Visa fjärrarkiven med deras URL:er"@sv ;
    solid-memo:back "git remote -v" .

<#remote-add>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Add a new remote under a name of your choice"@en ,
                     "Lägg till ett nytt fjärrarkiv under ett valfritt namn"@sv ;
    solid-memo:back "git remote add <name> <url>" .

<#fetch>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Download new commits and branches from the remote without changing your own branches"@en ,
                     "Hämta nya incheckningar och grenar från fjärrarkivet utan att ändra dina egna grenar"@sv ;
    solid-memo:back "git fetch" .

<#fetch-prune>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Fetch, and also delete your remote-tracking branches for branches that were deleted on the remote"@en ,
                     "Hämta och ta även bort de fjärrspårande grenar vars gren har tagits bort i fjärrarkivet"@sv ;
    solid-memo:back "git fetch --prune" ;
    solid-memo:backNote "Short form: -p."@en ,
                        "Kort form: -p."@sv .

<#pull>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Fetch the current branch's upstream and integrate it into the current branch"@en ,
                     "Hämta den aktuella grenens uppströmsgren och integrera den i den aktuella grenen"@sv ;
    solid-memo:back "git pull" ;
    solid-memo:backNote "If both sides have new commits, Git stops and asks you to choose --rebase, --no-rebase (merge) or --ff-only, or to set pull.rebase or pull.ff."@en ,
                        "Om båda sidor har nya incheckningar avbryter Git och ber dig välja --rebase, --no-rebase (sammanslagning) eller --ff-only, eller ställa in pull.rebase eller pull.ff."@sv .

<#pull-rebase>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Fetch the upstream and move your local commits so that they start from its new tip"@en ,
                     "Hämta uppströmsgrenen och flytta dina lokala incheckningar så att de utgår från dess nya topp"@sv ;
    solid-memo:back "git pull --rebase" .

<#push>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Send the current branch's new commits to its upstream branch"@en ,
                     "Skicka den aktuella grenens nya incheckningar till dess uppströmsgren"@sv ;
    solid-memo:back "git push" .

<#push-upstream>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Send a new local branch to origin for the first time and make origin's new branch the local branch's upstream"@en ,
                     "Skicka en ny lokal gren till origin för första gången och ställ in den nya grenen i origin som den lokala grenens uppströmsgren"@sv ;
    solid-memo:back "git push -u origin <branch>" ;
    solid-memo:backNote "Long form: --set-upstream. Afterwards plain git push and git pull use that branch."@en ,
                        "Lång form: --set-upstream. Därefter använder git push och git pull utan argument den grenen."@sv .

<#push-delete>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Delete a branch on the remote origin"@en ,
                     "Ta bort en gren i fjärrarkivet origin"@sv ;
    solid-memo:back "git push origin --delete <branch>" .

<#push-tag>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Send a single tag to origin"@en ,
                     "Skicka en enskild tagg till origin"@sv ;
    solid-memo:back "git push origin <tag>" ;
    solid-memo:backNote "By default git push sends no tags unless you name them; --tags sends all of them."@en ,
                        "Som standard skickar git push inga taggar om du inte anger dem; --tags skickar alla."@sv .

<#stash>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Set aside your uncommitted changes to tracked files and return to a clean working tree"@en ,
                     "Lägg undan dina ej incheckade ändringar i spårade filer och återgå till en ren arbetskatalog"@sv ;
    solid-memo:back "git stash" ;
    solid-memo:backNote "Same as git stash push. Untracked files are left where they are."@en ,
                        "Samma som git stash push. Ospårade filer lämnas kvar."@sv .

<#stash-untracked>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Stash your uncommitted changes, including untracked files"@en ,
                     "Lägg undan dina ej incheckade ändringar, även ospårade filer"@sv ;
    solid-memo:back "git stash -u" ;
    solid-memo:backNote "Long form: --include-untracked. Ignored files are still left alone."@en ,
                        "Lång form: --include-untracked. Ignorerade filer lämnas fortfarande kvar."@sv .

<#stash-list>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "List your stash entries"@en ,
                     "Visa dina undanlagda ändringar (stash-posterna)"@sv ;
    solid-memo:back "git stash list" .

<#stash-pop>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Reapply the most recent stash and remove it from the stash list"@en ,
                     "Applicera de senast undanlagda ändringarna på nytt och ta bort dem från stash-listan"@sv ;
    solid-memo:back "git stash pop" ;
    solid-memo:backNote "If applying gives conflicts, the entry is kept; git stash apply never removes it."@en ,
                        "Om det blir konflikter behålls posten; git stash apply tar aldrig bort den."@sv .

<#revert>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Undo an earlier commit by making a new commit that reverses its changes"@en ,
                     "Ångra en tidigare incheckning genom att göra en ny incheckning som upphäver dess ändringar"@sv ;
    solid-memo:back "git revert <commit>" ;
    solid-memo:backNote "Safe for commits that are already shared, because history is not rewritten."@en ,
                        "Säkert även för incheckningar som redan delats, eftersom historiken inte skrivs om."@sv .

<#reset-soft>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Undo the last commit but keep its changes staged"@en ,
                     "Ångra den senaste incheckningen men behåll dess ändringar köade"@sv ;
    solid-memo:back "git reset --soft HEAD~1" ;
    solid-memo:backNote "HEAD^ means the same as HEAD~1."@en ,
                        "HEAD^ betyder samma sak som HEAD~1."@sv .

<#reset-hard>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Move the current branch to a given commit and discard all uncommitted changes to tracked files"@en ,
                     "Flytta den aktuella grenen till en viss incheckning och kasta bort alla ej incheckade ändringar i spårade filer"@sv ;
    solid-memo:back "git reset --hard <commit>" ;
    solid-memo:backNote "Destructive: all uncommitted changes to tracked files are discarded (unstaged ones cannot be recovered at all). The old branch tip is kept in ORIG_HEAD (until another command such as reset, merge or rebase replaces it) and in the reflog, so dropped commits can be restored."@en ,
                        "Destruktivt: alla ej incheckade ändringar i spårade filer kastas bort (oköade ändringar går inte att få tillbaka alls). Grenens förra topp sparas i ORIG_HEAD (tills ett annat kommando, till exempel reset, merge eller rebase, ersätter den) och i referensloggen, så att bortkastade incheckningar kan återfås."@sv .

<#clean>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Delete the untracked files from the current directory down, leaving untracked directories alone"@en ,
                     "Ta bort de ospårade filerna från den aktuella katalogen och nedåt, men lämna ospårade kataloger orörda"@sv ;
    solid-memo:back "git clean -f" ;
    solid-memo:backNote "Without -f Git refuses. Add -d to delete untracked directories and their contents too; -n only lists what would be deleted."@en ,
                        "Utan -f vägrar Git. Lägg till -d för att även ta bort ospårade kataloger med innehåll; -n visar bara vad som skulle tas bort."@sv .

<#tag-annotated>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Create an annotated tag with a message on the current commit"@en ,
                     "Skapa en annoterad tagg med ett meddelande på den aktuella incheckningen"@sv ;
    solid-memo:back "git tag -a <tag> -m \"<message>\"" ;
    solid-memo:backNote "-m on its own also implies -a. git tag with no arguments lists the tags."@en ,
                        "-m ensamt innebär också -a. git tag utan argument visar taggarna."@sv .

<#turtle>
    a dcat:Distribution ;
    dcat:accessURL <> ;
    dcat:downloadURL <> ;
    dcat:mediaType <https://www.iana.org/assignments/media-types/text/turtle> ;
    dcterms:format <http://publications.europa.eu/resource/authority/file-type/RDF_TURTLE> .
