<>
    a solid-memo:Deck ,
      dcat:Dataset ;
    dcterms:title "Git commands"@en ,
                  "Git-kommandon"@sv ;
    dcterms:creator <#anton-wiklund> ;
    dcterms:license <https://creativecommons.org/publicdomain/zero/1.0/> ;
    dcterms:description "56 everyday Git commands: the front describes a task in plain words in English and Swedish, the back is the command that does it, with placeholders such as <branch> or <file>. Uses the current commands Git recommends (git switch and git restore rather than git checkout, git config set), with older equivalents in notes. Every command was run with Git 2.53.0 in a test repository and checked against the official Git reference manual. Sources, method and quality control: https://github.com/antwika/solid-memo/blob/main/packages/deck-library/authored/git-commands.md"@en ,
                        "56 vardagliga Git-kommandon: på framsidan en uppgift beskriven med vanliga ord på engelska och svenska, på baksidan kommandot som utför den, med platshållare som <branch> eller <file>. Använder de aktuella kommandon som Git rekommenderar (git switch och git restore i stället för git checkout, git config set), med äldre motsvarigheter i anteckningar. Varje kommando har körts med Git 2.53.0 i ett testarkiv och kontrollerats mot Gits officiella referenshandbok. Källor, metod och kvalitetskontroll: https://github.com/antwika/solid-memo/blob/main/packages/deck-library/authored/git-commands.md"@sv ;
    prov:wasDerivedFrom <https://github.com/antwika/solid-memo/blob/main/packages/deck-library/authored/git-commands.md#queries> ;
    prov:wasGeneratedBy <#compilation> ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    dcat:theme <http://publications.europa.eu/resource/authority/data-theme/EDUC> ,
               topic:computing ;
    dcat:keyword "Git" ,
                 "version control" ,
                 "command line" ,
                 "branches" ,
                 "commits" ,
                 "versionshantering" ,
                 "kommandorad" ,
                 "Git-kommandon" ,
                 "grenar" ,
                 "incheckningar" ;
    dcterms:language <http://publications.europa.eu/resource/authority/language/ENG> ,
                     <http://publications.europa.eu/resource/authority/language/SWE> ;
    solid-memo:studyDirection solid-memo:frontToBack ;
    solid-memo:formatVersion 4 ;
    dcat:version "1" ;
    dcterms:issued "2026-10-04T00:32:58Z"^^xsd:dateTime ;
    adms:versionNotes "First release: 56 cards, each checked against at least two sources; sources, method and quality control in authored/git-commands.md." ;
    dcterms:publisher <https://solid-memo.com/decks/index.ttl#solid-memo> ;
