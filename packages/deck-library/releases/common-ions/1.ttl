              <https://iupac.org/wp-content/uploads/2016/07/Red_Book_2005.pdf> ,
              <https://kemisamfundet.se/wp-content/uploads/2020/05/Skrivregler-S%C3%A4rtryck-Kemisk-Tidskrift.pdf> ,
              <https://www.lth.se/fileadmin/kemigen/pdf/nomenklaturregler.pdf> ,
              <https://sv.wikipedia.org/> ;
