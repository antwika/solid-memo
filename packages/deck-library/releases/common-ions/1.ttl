    dcterms:title "Common ions"@en ,
                  "Vanliga joner"@sv ;
    dcterms:creator <#anton-wiklund> ;
    dcterms:license <https://creativecommons.org/publicdomain/zero/1.0/> ;
    dcterms:description "43 common ions of school chemistry: 16 cations, from the hydrogen and oxonium ions to iron(III) and aluminium, and 27 anions, from chloride and oxide to sulfate, phosphate, permanganate and thiosulfate. Front: the ion's name in English and Swedish, e.g. \"Sulfate ion\" / \"sulfatjon\"; back: its formula with the charge as a superscript, e.g. SO₄²⁻. English names follow IUPAC (oxonium, hydrogencarbonate), Swedish names are formed by the Swedish Chemical Society's writing rules and checked for use. Formulas from Wikidata and PubChem; names checked against the IUPAC Red Book and Swedish sources. Studied in both directions. Sources, method and quality control: https://github.com/antwika/solid-memo/blob/main/packages/deck-library/authored/common-ions.md"@en ,
                        "43 vanliga joner från skolkemin: 16 katjoner, från vätejonen och oxoniumjonen till järn(III)jonen och aluminiumjonen, och 27 anjoner, från kloridjonen och oxidjonen till sulfatjonen, fosfatjonen, permanganatjonen och tiosulfatjonen. Framsida: jonens namn på engelska och svenska, t.ex. ”Sulfate ion” / ”sulfatjon”; baksida: dess formel med laddningen upphöjd, t.ex. SO₄²⁻. De engelska namnen följer IUPAC (oxonium, hydrogencarbonate), de svenska är bildade efter Svenska Kemisamfundets skrivregler och kontrollerade i bruk. Formlerna kommer från Wikidata och PubChem; namnen är kontrollerade mot IUPAC:s Red Book och svenska källor. Övas i båda riktningarna. Källor, metod och kvalitetskontroll: https://github.com/antwika/solid-memo/blob/main/packages/deck-library/authored/common-ions.md"@sv ;
    prov:wasDerivedFrom <https://www.wikidata.org/> ,
                        <https://pubchem.ncbi.nlm.nih.gov/> ;
    prov:wasGeneratedBy <#compilation> ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    dcat:theme <http://publications.europa.eu/resource/authority/data-theme/EDUC> ,
               topic:chemistry ;
    dcat:keyword "chemistry"@en ,
                 "ions"@en ,
                 "chemical formulas"@en ,
                 "cations"@en ,
                 "anions"@en ,
                 "kemi"@sv ,
                 "joner"@sv ,
                 "kemiska formler"@sv ,
                 "katjoner"@sv ,
                 "anjoner"@sv ;
    dcterms:language <http://publications.europa.eu/resource/authority/language/ENG> ,
                     <http://publications.europa.eu/resource/authority/language/SWE> ;
    solid-memo:studyDirection solid-memo:bidirectional ;
    solid-memo:formatVersion 5 ;
    dcat:version "1" ;
    dcterms:issued "2026-10-04T19:59:21Z"^^xsd:dateTime ;
    adms:versionNotes "First release: 43 cards, each checked against at least two sources; sources, method and quality control in authored/common-ions.md." ;
    dcterms:publisher <https://solid-memo.com/decks/index.ttl#solid-memo> ;
    dcat:inSeries <https://solid-memo.com/decks/index.ttl#common-ions> ;
    dcat:isVersionOf <https://solid-memo.com/decks/index.ttl#common-ions> ;
