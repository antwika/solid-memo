    rdfs:seeAlso <https://github.com/antwika/solid-memo/blob/main/packages/deck-library/authored/common-ions.md> ;
    rdfs:comment "Compiled from the dossier authored/common-ions.json, which records every source, the method, the quality-control rounds and the evidence for each card; built with python3 packages/deck-library/scripts/authored_decks.py build common-ions." .

<https://github.com/antwika/solid-memo/blob/main/packages/deck-library/scripts/authored_decks.py>
    a prov:SoftwareAgent ;
    dcterms:title "authored_decks.py" .

