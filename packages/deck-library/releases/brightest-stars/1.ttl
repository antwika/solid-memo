<>
    a solid-memo:Deck ,
      dcat:Dataset ;
    dcterms:title "Brightest stars of the night sky"@en ,
                  "Natthimlens ljusaste stjärnor"@sv ;
    dcterms:creator <#anton-wiklund> ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:description "52 cards on the brightest stars of the night sky. 49 cover every star with a name approved by the International Astronomical Union (IAU) that is brighter than apparent magnitude 2.0 (close pairs by their combined light), plus Polaris: front, the star's name, e.g. “Sirius”; back, its constellation, in English by its official IAU name (e.g. “Canis Major”), in Swedish by its Swedish name (“Stora hunden”), with the Bayer designation in a note. Three more ask for the brightest and second-brightest star of the night sky and the north pole star. Names from the IAU Working Group on Star Names; constellations and magnitudes from Wikidata, checked against SIMBAD. Sources, method and quality control: https://github.com/antwika/solid-memo/blob/main/packages/deck-library/authored/brightest-stars.md"@en ,
                        "52 kort om natthimlens ljusaste stjärnor. 49 av dem gäller alla stjärnor med ett namn som godkänts av Internationella astronomiska unionen (IAU) och som är ljusare än skenbar magnitud 2,0 (täta par efter sitt sammanlagda ljus), samt Polstjärnan: på framsidan stjärnans namn, t.ex. ”Sirius”; på baksidan dess stjärnbild, på engelska med det officiella IAU-namnet (t.ex. ”Canis Major”), på svenska med det svenska namnet (”Stora hunden”), med Bayerbeteckningen i en anteckning. Tre kort frågar efter natthimlens ljusaste och näst ljusaste stjärna och stjärnan närmast norra himmelspolen. Namnen kommer från IAU:s arbetsgrupp för stjärnnamn; stjärnbilder och magnituder från Wikidata, kontrollerade mot SIMBAD. Källor, metod och kvalitetskontroll: https://github.com/antwika/solid-memo/blob/main/packages/deck-library/authored/brightest-stars.md"@sv ;
    prov:wasDerivedFrom <https://www.pas.rochester.edu/~emamajek/WGSN/IAU-CSN.txt> ,
                        <https://www.wikidata.org/wiki/Q3409> ,
                        <https://iauarchive.eso.org/public/themes/constellations/> ;
    prov:wasGeneratedBy <#compilation> ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    dcat:theme <http://publications.europa.eu/resource/authority/data-theme/EDUC> ,
               topic:astronomy ;
    dcat:keyword "stars"@en ,
                 "star names"@en ,
                 "constellations"@en ,
                 "night sky"@en ,
                 "astronomy"@en ,
                 "IAU"@en ,
                 "stjärnor"@sv ,
                 "stjärnnamn"@sv ,
                 "stjärnbilder"@sv ,
                 "natthimlen"@sv ,
                 "astronomi"@sv ,
                 "IAU"@sv ;
    dcterms:language <http://publications.europa.eu/resource/authority/language/ENG> ,
                     <http://publications.europa.eu/resource/authority/language/SWE> ;
    solid-memo:studyDirection solid-memo:frontToBack ;
    solid-memo:formatVersion 5 ;
    dcat:version "1" ;
    dcterms:issued "2026-10-04T19:58:25Z"^^xsd:dateTime ;
    adms:versionNotes "First release: 52 cards, each checked against at least two sources; sources, method and quality control in authored/brightest-stars.md." ;
    dcterms:publisher <https://solid-memo.com/decks/index.ttl#solid-memo> ;
    dcat:inSeries <https://solid-memo.com/decks/index.ttl#brightest-stars> ;
    dcat:isVersionOf <https://solid-memo.com/decks/index.ttl#brightest-stars> ;
    dcat:distribution <#turtle> .

