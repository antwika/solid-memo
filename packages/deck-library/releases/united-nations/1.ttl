<>
    a solid-memo:Deck ,
      dcat:Dataset ;
    dcterms:title "United Nations: Secretaries-General and seats of UN bodies"@en ,
                  "FN: generalsekreterare och FN-organens säten"@sv ;
    dcterms:creator <#anton-wiklund> ;
    dcterms:license <https://creativecommons.org/publicdomain/zero/1.0/> ;
    dcterms:description "40 cards on the United Nations as of 4 October 2026. Nine give the years in office of each Secretary-General, from Trygve Lie (1946) to António Guterres (since 2017): front the name, back the years. Thirty-one give the seat of a body of the UN system (the six principal organs, the 15 specialized agencies, the six funds and programmes, UNHCR, the IAEA, the WTO and the OPCW): front the body's name, back the city. Taken from Wikidata and checked against the United Nations Handbook 2026–27, the UN's own pages and Swedish UN sources. Sources, method and quality control: https://github.com/antwika/solid-memo/blob/main/packages/deck-library/authored/united-nations.md"@en ,
                        "40 kort om Förenta nationerna per den 4 oktober 2026. Nio anger ämbetsåren för var och en av generalsekreterarna, från Trygve Lie (1946) till António Guterres (sedan 2017): framsida namnet, baksida åren. Trettioett anger var ett organ i FN-systemet har sitt säte (de sex huvudorganen, de 15 fackorganen, de sex fonderna och programmen, UNHCR, IAEA, WTO och OPCW): framsida organets namn, baksida staden. Uppgifterna är hämtade från Wikidata och kontrollerade mot United Nations Handbook 2026–27, FN:s egna webbsidor och svenska FN-källor. Källor, metod och kvalitetskontroll: https://github.com/antwika/solid-memo/blob/main/packages/deck-library/authored/united-nations.md"@sv ;
    prov:wasDerivedFrom <https://www.wikidata.org/wiki/Q81066> ,
                        <https://data.riksdagen.se/dokument/HC0361.html> ;
    prov:wasGeneratedBy <#compilation> ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    dcat:theme <http://publications.europa.eu/resource/authority/data-theme/EDUC> ,
               topic:history ,
               topic:geography ;
    dcat:keyword "United Nations"@en ,
                 "UN"@en ,
                 "Secretary-General"@en ,
                 "UN specialized agencies"@en ,
                 "international organizations"@en ,
                 "Förenta nationerna"@sv ,
                 "FN"@sv ,
                 "generalsekreterare"@sv ,
                 "FN:s fackorgan"@sv ,
                 "internationella organisationer"@sv ;
    dcterms:language <http://publications.europa.eu/resource/authority/language/ENG> ,
                     <http://publications.europa.eu/resource/authority/language/SWE> ;
    solid-memo:studyDirection solid-memo:frontToBack ;
    solid-memo:formatVersion 5 ;
    dcat:version "1" ;
    dcterms:issued "2026-10-04T20:16:52Z"^^xsd:dateTime ;
    adms:versionNotes "First release: 40 cards, each checked against at least two sources; sources, method and quality control in authored/united-nations.md." ;
    dcterms:publisher <https://solid-memo.com/decks/index.ttl#solid-memo> ;
    dcat:inSeries <https://solid-memo.com/decks/index.ttl#united-nations> ;
