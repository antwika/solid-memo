<>
    a solid-memo:Deck ,
      dcat:Dataset ;
    dcterms:title "Classical music: who composed it?"@en ,
                  "Klassisk musik: vem komponerade den?"@sv ;
    dcterms:creator <#anton-wiklund> ;
    dcterms:license <https://creativecommons.org/publicdomain/zero/1.0/> ;
    dcterms:description "83 famous works of Western classical music composed before 1950 – operas, ballets and concert works chosen by how many Wikimedia sites (mostly language editions of Wikipedia) have a page on them. Front: the work's title in English and Swedish (where a title has been used for several works, the best-known one is meant); back: its composer. Titles and composers from Wikidata, checked against the Library of Congress name authorities and IMSLP. Sources, method and quality control: https://github.com/antwika/solid-memo/blob/main/packages/deck-library/authored/classical-music-composers.md"@en ,
                        "83 berömda verk ur den västerländska klassiska musiken, komponerade före 1950 – operor, baletter och konsertverk utvalda efter hur många Wikimedia-webbplatser (främst språkversioner av Wikipedia) som har en sida om dem. Framsida: verkets titel på engelska och svenska (har flera verk samma titel avses det mest kända); baksida: tonsättaren. Titlar och tonsättare från Wikidata, kontrollerade mot Library of Congress namnauktoriteter och IMSLP. Källor, metod och kvalitetskontroll: https://github.com/antwika/solid-memo/blob/main/packages/deck-library/authored/classical-music-composers.md"@sv ;
    prov:wasDerivedFrom <https://www.wikidata.org/> ;
    prov:wasGeneratedBy <#compilation> ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    dcat:theme <http://publications.europa.eu/resource/authority/data-theme/EDUC> ,
               topic:music ;
    dcat:keyword "classical music"@en ,
                 "composers"@en ,
                 "opera"@en ,
                 "ballet"@en ,
                 "music history"@en ,
                 "klassisk musik"@sv ,
                 "tonsättare"@sv ,
                 "kompositörer"@sv ,
                 "balett"@sv ,
                 "musikhistoria"@sv ,
                 "opera"@sv ;
    dcterms:language <http://publications.europa.eu/resource/authority/language/ENG> ,
                     <http://publications.europa.eu/resource/authority/language/SWE> ;
    solid-memo:studyDirection solid-memo:frontToBack ;
    solid-memo:formatVersion 5 ;
    dcat:version "1" ;
    dcterms:issued "2026-10-04T10:51:51Z"^^xsd:dateTime ;
    adms:versionNotes "First release: 83 cards, each checked against at least two sources; sources, method and quality control in authored/classical-music-composers.md." ;
    dcterms:publisher <https://solid-memo.com/decks/index.ttl#solid-memo> ;
    dcat:inSeries <https://solid-memo.com/decks/index.ttl#classical-music-composers> ;
    dcat:isVersionOf <https://solid-memo.com/decks/index.ttl#classical-music-composers> ;
    dcat:distribution <#turtle> .

