<>
    a solid-memo:Deck ,
      dcat:Dataset ;
    dcterms:title "Mathematical symbols"@en ,
                  "Matematiska symboler"@sv ;
    dcterms:creator <#anton-wiklund> ;
    dcterms:license <https://creativecommons.org/publicdomain/zero/1.0/> ;
    dcterms:description "45 common mathematical symbols and what they mean: logic (∀, ∃, ¬, ∧, ∨, ⇒, ⇔), sets and number sets (∈, ⊆, ⊂, ∪, ∩, ℕ, ℝ …), relations (≠, ≈, ∝, ≤, ≡ …), operators (∑, ∏, √, ∫, ∂, ∇, n! …) and the constants π, e and i, plus ∞. Front: the symbol, in a short expression where it needs one (⌊x⌋, g ∘ f); back: its meaning in English and Swedish. ⊂ is read as proper subset and ℕ includes 0. Checked against Wikidata, the Unicode Character Database and the English and Swedish Wikipedia. Sources, method and quality control: https://github.com/antwika/solid-memo/blob/main/packages/deck-library/authored/mathematical-symbols.md"@en ,
                        "45 vanliga matematiska symboler och vad de betyder: logik (∀, ∃, ¬, ∧, ∨, ⇒, ⇔), mängder och talmängder (∈, ⊆, ⊂, ∪, ∩, ℕ, ℝ …), relationer (≠, ≈, ∝, ≤, ≡ …), operatorer (∑, ∏, √, ∫, ∂, ∇, n! …) och konstanterna π, e och i, samt ∞. Framsida: symbolen, vid behov i ett kort uttryck (⌊x⌋, g ∘ f); baksida: dess betydelse på engelska och svenska. ⊂ läses som äkta delmängd och ℕ innehåller 0. Kontrollerade mot Wikidata, Unicodes teckendatabas och engelskspråkiga och svenskspråkiga Wikipedia. Källor, metod och kvalitetskontroll: https://github.com/antwika/solid-memo/blob/main/packages/deck-library/authored/mathematical-symbols.md"@sv ;
    prov:wasDerivedFrom <https://www.wikidata.org/> ;
    prov:wasGeneratedBy <#compilation> ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    dcat:theme <http://publications.europa.eu/resource/authority/data-theme/EDUC> ,
               topic:mathematics ;
    dcat:keyword "mathematical symbols"@en ,
                 "mathematical notation"@en ,
                 "logic"@en ,
                 "set theory"@en ,
                 "mathematical analysis"@en ,
                 "matematiska symboler"@sv ,
                 "matematisk notation"@sv ,
                 "logik"@sv ,
                 "mängdlära"@sv ,
                 "matematisk analys"@sv ;
    dcterms:language <http://publications.europa.eu/resource/authority/language/ENG> ,
                     <http://publications.europa.eu/resource/authority/language/SWE> ;
    solid-memo:studyDirection solid-memo:frontToBack ;
    solid-memo:formatVersion 5 ;
    dcat:version "1" ;
    dcterms:issued "2026-10-04T20:06:20Z"^^xsd:dateTime ;
    adms:versionNotes "First release: 45 cards, each checked against at least two sources; sources, method and quality control in authored/mathematical-symbols.md." ;
    dcterms:publisher <https://solid-memo.com/decks/index.ttl#solid-memo> ;
    dcat:inSeries <https://solid-memo.com/decks/index.ttl#mathematical-symbols> ;
