<>
    a solid-memo:Deck ,
      dcat:Dataset ;
    dcterms:title "FIFA Men's and Women's World Cups: winners and hosts"@en ,
                  "Fotbolls-VM: segrare och värdländer"@sv ;
    dcterms:creator <#anton-wiklund> ;
    dcterms:license <https://creativecommons.org/publicdomain/zero/1.0/> ;
    dcterms:description "The winner and the host country (or countries) of every FIFA World Cup, the men's tournament from 1930 to 2026 (23 tournaments) and the women's from 1991 to 2023 (9 tournaments): 64 cards. Front: the tournament and the question, e.g. \"FIFA World Cup 1958: winner\" or \"FIFA Women's World Cup 2023: host\"; back: the country in English and Swedish. Countries are named as they were at the time: \"West Germany\" for the titles of 1954, 1974 and 1990 and for the 1974 host. Results up to and including the 2026 men's World Cup, won by Spain on 19 July 2026. Taken from Wikidata and checked against FIFA's own data and the RSSSF. Sources, method and quality control: https://github.com/antwika/solid-memo/blob/main/packages/deck-library/authored/fifa-world-cup.md"@en ,
                        "Segraren och värdlandet (eller värdländerna) i varje VM i fotboll, för herrar 1930–2026 (23 turneringar) och för damer 1991–2023 (9 turneringar): 64 kort. Framsida: turneringen och frågan, t.ex. ”VM i fotboll 1958: segrare” eller ”VM i fotboll för damer 2023: värdland”; baksida: landet på engelska och svenska. Länderna anges med de namn de hade då: ”Västtyskland” för segrarna 1954, 1974 och 1990 och för värdlandet 1974. Resultat till och med herrarnas VM 2026, som Spanien vann den 19 juli 2026. Uppgifterna är hämtade från Wikidata och kontrollerade mot Fifas egna data och RSSSF. Källor, metod och kvalitetskontroll: https://github.com/antwika/solid-memo/blob/main/packages/deck-library/authored/fifa-world-cup.md"@sv ;
    prov:wasDerivedFrom <https://www.wikidata.org/wiki/Q19317> ;
    prov:wasGeneratedBy <#compilation> ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    dcat:theme <http://publications.europa.eu/resource/authority/data-theme/EDUC> ,
               topic:sports ;
    dcat:keyword "FIFA World Cup" ,
                 "FIFA Women's World Cup" ,
                 "football" ,
                 "soccer" ,
                 "world champions" ,
                 "sports history" ,
                 "VM i fotboll" ,
                 "fotbolls-VM" ,
                 "damfotboll" ,
                 "världsmästare" ,
                 "värdland" ,
                 "idrottshistoria" ;
    dcterms:language <http://publications.europa.eu/resource/authority/language/ENG> ,
                     <http://publications.europa.eu/resource/authority/language/SWE> ;
    solid-memo:studyDirection solid-memo:frontToBack ;
    solid-memo:formatVersion 4 ;
    dcat:version "1" ;
    dcterms:issued "2026-10-04T05:23:57Z"^^xsd:dateTime ;
    adms:versionNotes "First release: 64 cards, each checked against at least two sources; sources, method and quality control in authored/fifa-world-cup.md." ;
    dcterms:publisher <https://solid-memo.com/decks/index.ttl#solid-memo> ;
    dcat:inSeries <https://solid-memo.com/decks/index.ttl#fifa-world-cup> ;
    dcat:isVersionOf <https://solid-memo.com/decks/index.ttl#fifa-world-cup> ;
    dcat:distribution <#turtle> .

