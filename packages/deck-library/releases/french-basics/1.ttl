    dcterms:language <http://publications.europa.eu/resource/authority/language/ENG> ,
                     <http://publications.europa.eu/resource/authority/language/SWE> ,
                     <http://publications.europa.eu/resource/authority/language/FRA> ;
    solid-memo:studyDirection solid-memo:frontToBack ;
    solid-memo:formatVersion 5 ;
    dcat:version "1" ;
    dcterms:issued "2026-10-04T10:54:29Z"^^xsd:dateTime ;
    adms:versionNotes "First release: 120 cards, each checked against at least two sources; sources, method and quality control in authored/french-basics.md." ;
