<>
    a solid-memo:Deck ,
      dcat:Dataset ;
    dcterms:title "Rivers of the world and their mouths"@en ,
                  "Världens floder och deras mynningar"@sv ;
    dcterms:creator <#anton-wiklund> ;
    dcterms:license <https://creativecommons.org/publicdomain/zero/1.0/> ;
    dcterms:description "50 major rivers of the world and the water each one flows into: a sea, ocean, bay, lake or another river. The rivers come from every continent except Antarctica, seven of them Nordic, such as the Torne and the Göta älv. Front: the river; back: where it flows into, in English and Swedish. The mouth is a water that Wikidata records for the river (P403); where it records several, the card gives the sea or bay that the other sources also name, sometimes with a note. Rivers whose mouth is disputed or splits between different waters are left out. From Wikidata, checked against Wikipedia and Nationalencyklopedin. Sources, method and quality control: https://github.com/antwika/solid-memo/blob/main/packages/deck-library/authored/world-rivers.md"@en ,
                        "50 av världens stora floder och det vatten som var och en mynnar i: ett hav, en ocean, en vik, en sjö eller en annan flod. Floderna kommer från alla världsdelar utom Antarktis, sju av dem nordiska, som Torne älv och Göta älv. Framsida: floden; baksida: var den mynnar, på engelska och svenska. Mynningen är ett vatten som Wikidata anger för floden (P403, mynnar i); där Wikidata anger flera ger kortet det hav eller den vik som även de andra källorna nämner, ibland med en anteckning. Floder vars mynning är omstridd eller delas mellan olika vatten är utelämnade. Uppgifterna kommer från Wikidata och är kontrollerade mot Wikipedia och Nationalencyklopedin. Källor, metod och kvalitetskontroll: https://github.com/antwika/solid-memo/blob/main/packages/deck-library/authored/world-rivers.md"@sv ;
    prov:wasDerivedFrom <https://www.wikidata.org/> ,
                        <https://www.govinfo.gov/content/pkg/FR-2025-01-31/pdf/2025-02096.pdf> ;
    prov:wasGeneratedBy <#compilation> ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    dcat:theme <http://publications.europa.eu/resource/authority/data-theme/EDUC> ,
               topic:geography ;
    dcat:keyword "rivers"@en ,
                 "river mouths"@en ,
                 "world geography"@en ,
                 "seas and oceans"@en ,
                 "lakes"@en ,
                 "floder"@sv ,
                 "flodmynningar"@sv ,
                 "världens geografi"@sv ,
                 "hav och oceaner"@sv ,
                 "sjöar"@sv ;
    dcterms:language <http://publications.europa.eu/resource/authority/language/ENG> ,
                     <http://publications.europa.eu/resource/authority/language/SWE> ;
    solid-memo:studyDirection solid-memo:frontToBack ;
    solid-memo:formatVersion 5 ;
    dcat:version "1" ;
    dcterms:issued "2026-10-04T20:18:02Z"^^xsd:dateTime ;
    adms:versionNotes "First release: 50 cards, each checked against at least two sources; sources, method and quality control in authored/world-rivers.md." ;
    dcterms:publisher <https://solid-memo.com/decks/index.ttl#solid-memo> ;
    dcat:inSeries <https://solid-memo.com/decks/index.ttl#world-rivers> ;
    dcat:isVersionOf <https://solid-memo.com/decks/index.ttl#world-rivers> ;
