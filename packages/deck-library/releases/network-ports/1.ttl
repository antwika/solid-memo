<>
    a solid-memo:Deck ,
      dcat:Dataset ;
    dcterms:title "Common network ports" ;
    dcterms:creator <#anton-wiklund> ;
    dcterms:license <https://creativecommons.org/publicdomain/zero/1.0/> ;
    dcterms:description "78 TCP and UDP port numbers you meet in practice and the services IANA assigns them, from 22 (SSH) and 443 (HTTPS) to databases, mail, VPNs and message brokers. The port on the front, the service on the back. Ports used only by convention, such as Kafka's 9092, are left out: every card is an assignment in IANA's Service Name and Port Number Registry." ;
    prov:wasDerivedFrom <https://www.iana.org/assignments/service-names-port-numbers> ;
    prov:wasGeneratedBy <#generation> ;
    dcterms:created "2026-09-28T21:24:16.000Z"^^xsd:dateTime ;
    dcat:theme <http://publications.europa.eu/resource/authority/data-theme/EDUC> ,
               topic:computing ;
    dcat:keyword "networking" ,
                 "ports" ,
                 "TCP" ,
                 "UDP" ;
    dcterms:language <http://publications.europa.eu/resource/authority/language/ENG> ;
    solid-memo:studyDirection solid-memo:bidirectional ;
    solid-memo:formatVersion 3 ;
    dcat:version "1" ;
    dcterms:issued "2026-09-28T21:25:01Z"^^xsd:dateTime ;
    adms:versionNotes "First release: 78 common TCP/UDP ports and their IANA-assigned services." ;
    dcterms:publisher <https://solid-memo.com/decks/index.ttl#solid-memo> ;
    dcat:inSeries <https://solid-memo.com/decks/index.ttl#network-ports> ;
