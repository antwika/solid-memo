<#flower-halsingland>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Hälsingland: provincial flower"@en ,
                     "Hälsingland: landskapsblomma"@sv ;
    solid-memo:back "flax"@en ,
                    "lin"@sv ;
    solid-memo:backNote "The 1908 list named the Scots pine; after protests from Hälsingland the choice was changed to flax in 1909. Scientific name: Linum usitatissimum."@en ,
                        "1908 års lista angav tall; efter protester från Hälsingland byttes den mot lin 1909. Vetenskapligt namn: Linum usitatissimum."@sv .

