<#flower-blekinge>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Blekinge: provincial flower"@en ,
                     "Blekinge: landskapsblomma"@sv ;
    solid-memo:frontNote "two plants are named"@en ,
                         "två växter anges"@sv ;
    solid-memo:back "pedunculate oak or great mullein"@en ,
                    "ek eller kungsljus"@sv ;
    solid-memo:backNote "The 1908 list named the oak; some lists also give the great mullein. Scientific names: Quercus robur, Verbascum thapsus."@en ,
                        "1908 års lista angav ek; vissa listor anger även kungsljus. Vetenskapliga namn: Quercus robur, Verbascum thapsus."@sv .

<#flower-bohuslan>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Bohuslän: provincial flower"@en ,
                     "Bohuslän: landskapsblomma"@sv ;
    solid-memo:back "common honeysuckle"@en ,
                    "vildkaprifol"@sv ;
    solid-memo:backNote "Scientific name: Lonicera periclymenum."@en ,
                        "Vetenskapligt namn: Lonicera periclymenum."@sv .

<#flower-dalarna>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
