<>
    a solid-memo:Deck ,
      dcat:Dataset ;
    dcterms:title "Chemical compounds"@en ,
                  "Kemiska föreningar"@sv ;
    dcterms:creator <#anton-wiklund> ;
    dcterms:license <https://creativecommons.org/publicdomain/zero/1.0/> ;
    dcterms:description "60 common chemical compounds and their formulas: the front is the compound's name in English and Swedish, the back its chemical formula with subscripts (conventional formulas for inorganic compounds, molecular formulas in Hill order for organic compounds). Compiled from Wikidata and PubChem; Swedish names checked against Swedish Wikipedia and, for the less common ones, Svenska Akademiens ordböcker and Swedish official sources. Sources, method and quality control: https://github.com/antwika/solid-memo/blob/main/packages/deck-library/authored/chemical-compounds.md"@en ,
                        "60 vanliga kemiska föreningar och deras formler: på framsidan föreningens namn på engelska och svenska, på baksidan dess kemiska formel med nedsänkta siffror (gängse formler för oorganiska föreningar, summaformler i Hill-ordning för organiska föreningar). Sammanställd från Wikidata och PubChem; de svenska namnen är kontrollerade mot svenskspråkiga Wikipedia och, för de mindre vanliga, mot Svenska Akademiens ordböcker och svenska myndighetskällor. Källor, metod och kvalitetskontroll: https://github.com/antwika/solid-memo/blob/main/packages/deck-library/authored/chemical-compounds.md"@sv ;
    prov:wasDerivedFrom <https://www.wikidata.org/> ,
                        <https://pubchem.ncbi.nlm.nih.gov/> ;
    prov:wasGeneratedBy <#compilation> ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    dcat:theme <http://publications.europa.eu/resource/authority/data-theme/EDUC> ,
               topic:chemistry ;
    dcat:keyword "chemistry" ,
                 "chemical compounds" ,
                 "chemical formulas" ,
                 "molecular formulas" ,
                 "kemi" ,
                 "kemiska föreningar" ,
                 "kemiska formler" ,
                 "summaformler" ;
    dcterms:language <http://publications.europa.eu/resource/authority/language/ENG> ,
                     <http://publications.europa.eu/resource/authority/language/SWE> ;
    solid-memo:studyDirection solid-memo:bidirectional ;
    solid-memo:formatVersion 4 ;
    dcat:version "1" ;
    dcterms:issued "2026-10-04T00:31:37Z"^^xsd:dateTime ;
    adms:versionNotes "First release: 60 cards, each checked against at least two sources; sources, method and quality control in authored/chemical-compounds.md." ;
    dcterms:publisher <https://solid-memo.com/decks/index.ttl#solid-memo> ;
    dcat:inSeries <https://solid-memo.com/decks/index.ttl#chemical-compounds> ;
    dcat:isVersionOf <https://solid-memo.com/decks/index.ttl#chemical-compounds> ;
    dcat:distribution <#turtle> .

