<>
    a solid-memo:Deck ,
      dcat:Dataset ;
    dcterms:title "Shakespeare: characters and their plays"@en ,
                  "Shakespeare: rollfigurer och deras pjäser"@sv ;
    dcterms:creator <#anton-wiklund> ;
    dcterms:license <https://creativecommons.org/publicdomain/zero/1.0/> ;
    dcterms:description "60 characters from 28 of Shakespeare's plays (tragedies, comedies, romances and two histories), each of whom appears in only one play. Front: the character's name in English and in Swedish (where Swedish has an established form of its own, such as Ofelia, Jago or Botten, that form; otherwise the original name); back: the play, by its English and Swedish title, with a short note on who the character is. Characters whose name is in the play's title are left out. Built from the play texts (Project Gutenberg) and Wikidata, with the Swedish names checked against C. A. Hagberg's translation, and cross-checked against the Folger Shakespeare. Sources, method and quality control: https://github.com/antwika/solid-memo/blob/main/packages/deck-library/authored/shakespeare-plays.md"@en ,
                        "60 rollfigurer ur 28 av Shakespeares pjäser (tragedier, komedier, sagospel och två krönikespel), som var och en förekommer i bara en pjäs. Framsida: rollfigurens namn på engelska och svenska (den etablerade svenska formen där en sådan finns, som Ofelia, Jago eller Botten, annars originalnamnet); baksida: pjäsen med dess engelska och svenska titel och en kort anteckning om vem rollfiguren är. Rollfigurer vars namn står i pjäsens titel ingår inte. Uppgifterna kommer från pjästexterna (Project Gutenberg) och Wikidata. De svenska namnen har kontrollerats mot C. A. Hagbergs översättning och allt har jämförts med Folger Shakespeare. Källor, metod och kvalitetskontroll: https://github.com/antwika/solid-memo/blob/main/packages/deck-library/authored/shakespeare-plays.md"@sv ;
    prov:wasDerivedFrom <https://www.gutenberg.org/ebooks/100> ,
                        <https://www.wikidata.org/wiki/Q692> ,
                        <https://runeberg.org/hagberg/> ;
    prov:wasGeneratedBy <#compilation> ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    dcat:theme <http://publications.europa.eu/resource/authority/data-theme/EDUC> ,
               topic:literature ;
    dcat:keyword "Shakespeare" ,
                 "plays" ,
                 "characters" ,
                 "English literature" ,
                 "drama" ,
                 "pjäser" ,
                 "rollfigurer" ,
                 "engelsk litteratur" ,
                 "dramatik" ,
                 "teater" ;
    dcterms:language <http://publications.europa.eu/resource/authority/language/ENG> ,
                     <http://publications.europa.eu/resource/authority/language/SWE> ;
    solid-memo:studyDirection solid-memo:frontToBack ;
    solid-memo:formatVersion 4 ;
    dcat:version "1" ;
    dcterms:issued "2026-10-04T05:23:14Z"^^xsd:dateTime ;
    adms:versionNotes "First release: 60 cards, each checked against at least two sources; sources, method and quality control in authored/shakespeare-plays.md." ;
    dcterms:publisher <https://solid-memo.com/decks/index.ttl#solid-memo> ;
    dcat:inSeries <https://solid-memo.com/decks/index.ttl#shakespeare-plays> ;
    dcat:isVersionOf <https://solid-memo.com/decks/index.ttl#shakespeare-plays> ;
    dcat:distribution <#turtle> .

