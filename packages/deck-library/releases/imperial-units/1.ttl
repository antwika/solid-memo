    solid-memo:back "0.09290304 m²"@zxx ;
    solid-memo:backNote "144 square inches, exact."@en ,
                        "144 kvadrattum, exakt."@sv .

<#acre>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "1 acre"@en ,
                     "1 acre"@sv ;
    solid-memo:back "≈ 4047 m²"@zxx ;
    solid-memo:backNote "Exactly 4046.8564224 m² (43 560 ft² = 4840 yd²), about 0.4047 ha."@en ,
                        "Exakt 4046,8564224 m² (43 560 ft² = 4840 yd²), cirka 0,4047 ha."@sv .

<#square-mile>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "1 square mile (mi²)"@en ,
