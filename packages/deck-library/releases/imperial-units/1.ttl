<#horsepower>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "1 horsepower (mechanical, hp)"@en ,
                     "1 brittisk hästkraft (hp)"@sv ;
    solid-memo:back "≈ 745.7 W"@zxx ;
    solid-memo:backNote "550 foot-pounds-force per second ≈ 745.6999 W. The metric horsepower (PS) is smaller, ≈ 735.5 W."@en ,
                        "550 foot-pound-force per sekund ≈ 745,6999 W. Den metriska hästkraften (hk) är mindre, ≈ 735,5 W."@sv .

<#btu>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "1 British thermal unit (Btu, IT)"@en ,
                     "1 Btu (British thermal unit, IT)"@sv ;
    solid-memo:back "≈ 1055 J"@zxx ;
    solid-memo:backNote "The International Table Btu: exactly 1055.05585262 J."@en ,
                        "Btu enligt International Table (IT): exakt 1055,05585262 J."@sv .

<#fahrenheit-to-celsius>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Convert °F to °C"@en ,
                     "Omvandla °F till °C"@sv ;
    solid-memo:back "°C = (°F − 32) / 1.8"@zxx ;
    solid-memo:backNote "Same as × 5/9. Check: 32 °F = 0 °C, 212 °F = 100 °C."@en ,
                        "Samma som × 5/9. Kontroll: 32 °F = 0 °C, 212 °F = 100 °C."@sv .

<#celsius-to-fahrenheit>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Convert °C to °F"@en ,
                     "Omvandla °C till °F"@sv ;
    solid-memo:back "°F = °C × 1.8 + 32"@zxx ;
    solid-memo:backNote "Same as × 9/5 + 32. Check: −40 °C = −40 °F."@en ,
                        "Samma som × 9/5 + 32. Kontroll: −40 °C = −40 °F."@sv .

