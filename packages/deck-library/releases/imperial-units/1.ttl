<#inch>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "1 inch (in)"@en ,
                     "1 tum (in)"@sv ;
    solid-memo:back "2.54 cm"@zxx ;
    solid-memo:backNote "Exact since 1959 (international yard and pound): 1 in = 25.4 mm."@en ,
                        "Exakt sedan 1959 (den internationella yarden och det internationella pundet): 1 in = 25,4 mm."@sv .

<#foot>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "1 foot (ft)"@en ,
                     "1 fot (ft)"@sv ;
    solid-memo:back "0.3048 m"@zxx ;
    solid-memo:backNote "12 inches, exact. The old US survey foot (1200/3937 m) was deprecated at the end of 2022."@en ,
                        "12 tum, exakt. Den äldre amerikanska US survey foot (1200/3937 m) fasades ut vid utgången av 2022."@sv .

<#yard>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "1 yard (yd)"@en ,
                     "1 yard (yd)"@sv ;
    solid-memo:back "0.9144 m"@zxx ;
    solid-memo:backNote "3 feet, exact; also the definition in UK law."@en ,
                        "3 fot, exakt; också definitionen i brittisk lag."@sv .

<#mile>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "1 mile (mi)"@en ,
                     "1 engelsk mil (mi)"@sv ;
    solid-memo:back "1609.344 m"@zxx ;
    solid-memo:backNote "1760 yards = 5280 feet, exact. Also called the statute mile."@en ,
                        "1760 yard = 5280 fot, exakt. Kallas på engelska även statute mile."@sv .

<#nautical-mile>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "1 nautical mile"@en ,
                     "1 nautisk mil"@sv ;
    solid-memo:back "1852 m"@zxx ;
    solid-memo:backNote "Not an imperial or US customary unit: the international nautical mile, exact by definition (1929; adopted by the US in 1954). Included as a common non-SI unit."@en ,
                        "Ingen brittisk eller amerikansk enhet: den internationella nautiska milen (sjömil, distansminut), exakt per definition (1929; antagen i USA 1954). Med som vanlig enhet utanför SI."@sv .

<#fathom>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "1 fathom"@en ,
                     "1 engelsk famn (fathom)"@sv ;
    solid-memo:back "1.8288 m"@zxx ;
    solid-memo:backNote "6 feet, exact (international foot)."@en ,
                        "6 fot, exakt (internationell fot)."@sv .

<#chain>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "1 chain (ch)"@en ,
                     "1 chain (ch)"@sv ;
    solid-memo:back "20.1168 m"@zxx ;
    solid-memo:backNote "66 feet = 22 yards, exact; 10 chains make a furlong."@en ,
                        "66 fot = 22 yard, exakt; 10 chain är en furlong."@sv .

<#furlong>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "1 furlong (fur)"@en ,
                     "1 furlong (fur)"@sv ;
    solid-memo:back "201.168 m"@zxx ;
    solid-memo:backNote "660 feet = 220 yards = 1/8 mile, exact."@en ,
                        "660 fot = 220 yard = 1/8 engelsk mil, exakt."@sv .

<#square-foot>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "1 square foot (ft²)"@en ,
