    solid-memo:back "≈ 2.590 km²"@zxx ;
    solid-memo:backNote "Exactly 2.589988110336 km² (640 acres)."@en ,
                        "Exakt 2,589988110336 km² (640 acre)."@sv .

<#cubic-foot>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "1 cubic foot (ft³)"@en ,
                     "1 kubikfot (ft³)"@sv ;
    solid-memo:back "≈ 28.32 L"@zxx ;
    solid-memo:backNote "Exactly 28.316846592 L (1728 cubic inches)."@en ,
                        "Exakt 28,316846592 l (1728 kubiktum)."@sv .

<#us-gallon>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "1 US gallon"@en ,
                     "1 amerikansk gallon"@sv ;
    solid-memo:back "≈ 3.785 L"@zxx ;
    solid-memo:backNote "Exactly 3.785411784 L (231 cubic inches). The imperial gallon is about 20 % larger."@en ,
                        "Exakt 3,785411784 l (231 kubiktum). Den brittiska (imperial) gallonen är cirka 20 % större."@sv .

<#imperial-gallon>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "1 imperial gallon"@en ,
                     "1 brittisk gallon (imperial)"@sv ;
    solid-memo:back "4.54609 L"@zxx ;
    solid-memo:backNote "Exact by definition (UK and Canada); 8 imperial pints = 160 imperial fluid ounces."@en ,
                        "Exakt per definition (Storbritannien och Kanada); 8 brittiska pint = 160 brittiska fluid ounce."@sv .

<#us-pint>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "1 US liquid pint"@en ,
                     "1 amerikansk pint (våt)"@sv ;
    solid-memo:back "≈ 0.4732 L"@zxx ;
    solid-memo:backNote "Exactly 0.473176473 L: 1/8 US gallon = 16 US fluid ounces. The US dry pint is larger (≈ 0.5506 L)."@en ,
                        "Exakt 0,473176473 l: 1/8 amerikansk gallon = 16 amerikanska fluid ounce. Den amerikanska torra pinten är större (≈ 0,5506 l)."@sv .

<#imperial-pint>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "1 imperial pint"@en ,
                     "1 brittisk pint (imperial)"@sv ;
    solid-memo:back "0.56826125 L"@zxx ;
    solid-memo:backNote "Exact: 1/8 imperial gallon = 20 imperial fluid ounces."@en ,
                        "Exakt: 1/8 brittisk gallon = 20 brittiska fluid ounce."@sv .

<#us-fluid-ounce>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "1 US fluid ounce"@en ,
                     "1 amerikanskt fluid ounce"@sv ;
    solid-memo:back "≈ 29.57 mL"@zxx ;
    solid-memo:backNote "Exactly 29.5735295625 mL: 1/128 US gallon. A volume, not the ounce of mass."@en ,
                        "Exakt 29,5735295625 ml: 1/128 amerikansk gallon. En volym, inte massenheten uns."@sv .

<#imperial-fluid-ounce>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "1 imperial fluid ounce"@en ,
                     "1 brittiskt fluid ounce (imperial)"@sv ;
    solid-memo:back "≈ 28.41 mL"@zxx ;
    solid-memo:backNote "Exactly 28.4130625 mL: 1/160 imperial gallon = 1/20 imperial pint."@en ,
                        "Exakt 28,4130625 ml: 1/160 brittisk gallon = 1/20 brittisk pint."@sv .

<#oil-barrel>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "1 barrel of oil (bbl)"@en ,
                     "1 fat olja (barrel, bbl)"@sv ;
    solid-memo:back "≈ 159.0 L"@zxx ;
    solid-memo:backNote "42 US gallons = exactly 158.987294928 L, the customary barrel for crude oil. Other barrels exist (31 gallons for beer in US tax law)."@en ,
                        "42 amerikanska gallon = exakt 158,987294928 l, det vedertagna fatet för råolja. Det finns andra fat (31 gallon för öl i amerikansk skattelag)."@sv .

<#grain>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "1 grain (gr)"@en ,
                     "1 grain (gr)"@sv ;
    solid-memo:back "64.79891 mg"@zxx ;
    solid-memo:backNote "1/7000 pound, exact; the same grain in avoirdupois, troy and apothecaries' weight."@en ,
                        "1/7000 pund, exakt; samma grain i avoirdupois-, troy- och apoteksvikt."@sv .

<#ounce>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "1 ounce (avoirdupois, oz)"@en ,
                     "1 uns (avoirdupois, oz)"@sv ;
    solid-memo:back "≈ 28.35 g"@zxx ;
    solid-memo:backNote "Exactly 28.349523125 g: 1/16 pound. Not the troy ounce used for precious metals."@en ,
                        "Exakt 28,349523125 g: 1/16 pund. Inte troy-unsen som används för ädelmetaller."@sv .

<#troy-ounce>
    a solid-memo:Card ;
