    solid-memo:back "≈ 31.10 g"@zxx ;
    solid-memo:backNote "Exactly 31.1034768 g (480 grains); the ounce for precious metals."@en ,
                        "Exakt 31,1034768 g (480 grain); unsen för ädelmetaller."@sv .

<#pound>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
