<>
    a solid-memo:Deck ,
      dcat:Dataset ;
    dcterms:title "Geometry formulas"@en ,
                  "Geometriska formler"@sv ;
    dcterms:creator <#anton-wiklund> ;
    dcterms:license <https://creativecommons.org/publicdomain/zero/1.0/> ;
    dcterms:description "39 formulas of school geometry: perimeters, areas, diagonals and angle sums of plane figures (square, rectangle, parallelogram, trapezoid, rhombus, triangle, polygon, circle, sector), the Pythagorean theorem and the law of cosines, and volumes and surface areas of solids (cube, rectangular box, prism, cylinder, pyramid, cone, sphere). Front: what is asked, naming every variable, e.g. \"Area of a circle with radius r\"; back: the formula in plain notation, e.g. \"πr²\". Every formula is derived and machine-checked with the computer algebra system SymPy and checked against English Wikipedia (and, for 35 cards, Swedish Wikipedia) and, where it has one, Wikidata's defining formula. Sources, method and quality control: https://github.com/antwika/solid-memo/blob/main/packages/deck-library/authored/geometry-formulas.md"@en ,
                        "39 formler ur skolans geometri: omkrets, area, diagonaler och vinkelsummor för plana figurer (kvadrat, rektangel, parallellogram, parallelltrapets, romb, triangel, polygon, cirkel, cirkelsektor), Pythagoras sats och cosinussatsen samt volym och begränsningsarea för kroppar (kub, rätblock, prisma, cylinder, pyramid, kon, klot och sfär). Framsida: vad som efterfrågas, med alla variabler namngivna, t.ex. ”Arean av en cirkel med radien r”; baksida: formeln i enkel notation, t.ex. ”πr²”. Varje formel är härledd och maskinkontrollerad med datoralgebrasystemet SymPy och kontrollerad mot engelska Wikipedia (och för 35 kort svenska Wikipedia) och, där den finns, Wikidatas definierande formel. Källor, metod och kvalitetskontroll: https://github.com/antwika/solid-memo/blob/main/packages/deck-library/authored/geometry-formulas.md"@sv ;
    prov:wasDerivedFrom <https://github.com/antwika/solid-memo/blob/main/packages/deck-library/authored/geometry-formulas.json> ,
                        <https://www.wikidata.org/> ;
    prov:wasGeneratedBy <#compilation> ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    dcat:theme <http://publications.europa.eu/resource/authority/data-theme/EDUC> ,
               topic:mathematics ;
    dcat:keyword "geometry"@en ,
                 "formulas"@en ,
                 "area"@en ,
                 "volume"@en ,
                 "perimeter"@en ,
                 "mathematics"@en ,
                 "geometri"@sv ,
                 "formler"@sv ,
                 "volym"@sv ,
                 "omkrets"@sv ,
                 "matematik"@sv ,
                 "area"@sv ;
    dcterms:language <http://publications.europa.eu/resource/authority/language/ENG> ,
                     <http://publications.europa.eu/resource/authority/language/SWE> ;
    solid-memo:studyDirection solid-memo:frontToBack ;
    solid-memo:formatVersion 5 ;
    dcat:version "1" ;
    dcterms:issued "2026-10-04T10:54:49Z"^^xsd:dateTime ;
    adms:versionNotes "First release: 39 cards, each checked against at least two sources; sources, method and quality control in authored/geometry-formulas.md." ;
    dcterms:publisher <https://solid-memo.com/decks/index.ttl#solid-memo> ;
    dcat:inSeries <https://solid-memo.com/decks/index.ttl#geometry-formulas> ;
    dcat:isVersionOf <https://solid-memo.com/decks/index.ttl#geometry-formulas> ;
    dcat:distribution <#turtle> .

