<#square-area>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Area of a square with side a"@en ,
                     "Arean av en kvadrat med sidan a"@sv ;
    solid-memo:back "a²"@zxx .

<#square-perimeter>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Perimeter of a square with side a"@en ,
                     "Omkretsen av en kvadrat med sidan a"@sv ;
    solid-memo:back "4a"@zxx .

<#square-diagonal>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Diagonal of a square with side a"@en ,
                     "Diagonalen i en kvadrat med sidan a"@sv ;
    solid-memo:back "a√2"@zxx ;
    solid-memo:backNote "Also written √2·a. By the Pythagorean theorem: d² = a² + a²."@en ,
                        "Skrivs även √2·a. Enligt Pythagoras sats: d² = a² + a²."@sv .

<#rectangle-area>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Area of a rectangle with sides a and b"@en ,
                     "Arean av en rektangel med sidorna a och b"@sv ;
    solid-memo:back "ab"@zxx .

<#rectangle-perimeter>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Perimeter of a rectangle with sides a and b"@en ,
                     "Omkretsen av en rektangel med sidorna a och b"@sv ;
    solid-memo:back "2(a + b)"@zxx ;
    solid-memo:backNote "Also written 2a + 2b."@en ,
                        "Skrivs även 2a + 2b."@sv .

<#rectangle-diagonal>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Diagonal of a rectangle with sides a and b"@en ,
                     "Diagonalen i en rektangel med sidorna a och b"@sv ;
    solid-memo:back "√(a² + b²)"@zxx .

<#parallelogram-area>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Area of a parallelogram with base b and height h"@en ,
                     "Arean av en parallellogram med basen b och höjden h"@sv ;
    solid-memo:back "bh"@zxx ;
    solid-memo:backNote "The height is measured at right angles to the base."@en ,
                        "Höjden mäts vinkelrätt mot basen."@sv .

<#trapezoid-area>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Area of a trapezoid with parallel sides a and b and height h"@en ,
                     "Arean av ett parallelltrapets med de parallella sidorna a och b och höjden h"@sv ;
    solid-memo:back "½(a + b)h"@zxx ;
    solid-memo:backNote "Also written (a + b)h/2: the mean of the parallel sides times the height. Called a trapezium in British English."@en ,
                        "Skrivs även (a + b)h/2: medelvärdet av de parallella sidorna gånger höjden."@sv .

<#rhombus-area>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Area of a rhombus with diagonals d₁ and d₂"@en ,
                     "Arean av en romb med diagonalerna d₁ och d₂"@sv ;
    solid-memo:back "½d₁d₂"@zxx ;
    solid-memo:backNote "Also written d₁d₂/2."@en ,
                        "Skrivs även d₁d₂/2."@sv .

<#triangle-area>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Area of a triangle with base b and height h"@en ,
                     "Arean av en triangel med basen b och höjden h"@sv ;
    solid-memo:back "½bh"@zxx ;
    solid-memo:backNote "Also written bh/2."@en ,
                        "Skrivs även bh/2."@sv .

<#triangle-area-sine>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Area of a triangle with sides a and b and the angle C between them"@en ,
                     "Arean av en triangel med sidorna a och b och vinkeln C mellan dem"@sv ;
    solid-memo:back "½ab·sin C"@zxx ;
    solid-memo:backNote "Also written (ab·sin C)/2."@en ,
                        "Skrivs även (ab·sin C)/2."@sv .

<#equilateral-triangle-area>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Area of an equilateral triangle with side a"@en ,
                     "Arean av en liksidig triangel med sidan a"@sv ;
    solid-memo:back "(√3/4)a²"@zxx ;
    solid-memo:backNote "Also written a²√3/4. The height is (√3/2)a."@en ,
                        "Skrivs även a²√3/4. Höjden är (√3/2)a."@sv .

<#herons-formula>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Heron's formula: area of a triangle with sides a, b and c"@en ,
                     "Herons formel: arean av en triangel med sidorna a, b och c"@sv ;
    solid-memo:frontNote "s = (a + b + c)/2, half the perimeter"@en ,
                         "s = (a + b + c)/2, halva omkretsen"@sv ;
    solid-memo:back "√(s(s − a)(s − b)(s − c))"@zxx .

<#pythagorean-theorem>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Pythagorean theorem for a right triangle with legs a and b and hypotenuse c"@en ,
                     "Pythagoras sats för en rätvinklig triangel med kateterna a och b och hypotenusan c"@sv ;
    solid-memo:back "a² + b² = c²"@zxx .

<#law-of-cosines>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Law of cosines: c² in a triangle with sides a, b, c and the angle C opposite c"@en ,
                     "Cosinussatsen: c² i en triangel med sidorna a, b, c och vinkeln C mitt emot sidan c"@sv ;
    solid-memo:back "c² = a² + b² − 2ab·cos C"@zxx ;
    solid-memo:backNote "With C = 90° it becomes the Pythagorean theorem."@en ,
                        "Med C = 90° övergår den i Pythagoras sats."@sv .

<#triangle-angle-sum>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Sum of the interior angles of a triangle, in degrees"@en ,
                     "Vinkelsumman i en triangel, i grader"@sv ;
    solid-memo:back "180°"@zxx ;
    solid-memo:backNote "π radians. In plane (Euclidean) geometry."@en ,
                        "π radianer. I plan (euklidisk) geometri."@sv .

<#polygon-angle-sum>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Sum of the interior angles of a polygon with n sides, in degrees"@en ,
                     "Vinkelsumman i en n-hörning, i grader"@sv ;
    solid-memo:back "(n − 2)·180°"@zxx ;
    solid-memo:backNote "For a simple polygon (its sides do not cross); it splits into n − 2 triangles."@en ,
                        "För en enkel polygon (sidorna korsar inte varandra); den kan delas upp i n − 2 trianglar."@sv .

<#regular-polygon-interior-angle>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Each interior angle of a regular convex polygon with n sides, in degrees"@en ,
                     "Varje inre vinkel i en regelbunden konvex n-hörning, i grader"@sv ;
    solid-memo:back "(n − 2)·180°/n"@zxx ;
    solid-memo:backNote "For a regular hexagon: 120°."@en ,
                        "För en regelbunden sexhörning: 120°."@sv .

<#circle-area>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Area of a circle with radius r"@en ,
                     "Arean av en cirkel med radien r"@sv ;
    solid-memo:back "πr²"@zxx ;
    solid-memo:backNote "With diameter d: πd²/4."@en ,
                        "Med diametern d: πd²/4."@sv .

<#circle-circumference-radius>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Circumference of a circle with radius r"@en ,
                     "Omkretsen av en cirkel med radien r"@sv ;
    solid-memo:back "2πr"@zxx .

<#circle-circumference-diameter>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Circumference of a circle with diameter d"@en ,
                     "Omkretsen av en cirkel med diametern d"@sv ;
    solid-memo:back "πd"@zxx .

<#arc-length>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Length of a circular arc with radius r and central angle θ in radians"@en ,
                     "Längden av en cirkelbåge med radien r och medelpunktsvinkeln θ i radianer"@sv ;
    solid-memo:back "rθ"@zxx ;
    solid-memo:backNote "With the angle v in degrees: (v/360°)·2πr."@en ,
                        "Med vinkeln v i grader: (v/360°)·2πr."@sv .

<#sector-area>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Area of a circular sector with radius r and central angle θ in radians"@en ,
                     "Arean av en cirkelsektor med radien r och medelpunktsvinkeln θ i radianer"@sv ;
    solid-memo:back "½r²θ"@zxx ;
    solid-memo:backNote "Also written r²θ/2. With the angle v in degrees: (v/360°)·πr²."@en ,
                        "Skrivs även r²θ/2. Med vinkeln v i grader: (v/360°)·πr²."@sv .

<#cube-volume>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Volume of a cube with edge a"@en ,
                     "Volymen av en kub med kantlängden a"@sv ;
    solid-memo:back "a³"@zxx .

<#cube-surface-area>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Surface area of a cube with edge a"@en ,
                     "Begränsningsarean av en kub med kantlängden a"@sv ;
    solid-memo:back "6a²"@zxx .

<#cube-space-diagonal>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Space diagonal of a cube with edge a"@en ,
                     "Rymddiagonalen i en kub med kantlängden a"@sv ;
    solid-memo:back "a√3"@zxx ;
    solid-memo:backNote "Also written √3·a. A face diagonal is a√2."@en ,
                        "Skrivs även √3·a. En sidoytas diagonal är a√2."@sv .

<#cuboid-volume>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Volume of a rectangular box with edges a, b and c"@en ,
                     "Volymen av ett rätblock med kantlängderna a, b och c"@sv ;
    solid-memo:back "abc"@zxx ;
    solid-memo:backNote "Length · width · height. A rectangular box is also called a rectangular cuboid."@en ,
                        "Längd · bredd · höjd."@sv .

<#cuboid-surface-area>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Surface area of a rectangular box with edges a, b and c"@en ,
                     "Begränsningsarean av ett rätblock med kantlängderna a, b och c"@sv ;
    solid-memo:back "2(ab + bc + ac)"@zxx ;
    solid-memo:backNote "Also written 2ab + 2bc + 2ac: two faces of each size."@en ,
                        "Skrivs även 2ab + 2bc + 2ac: två sidoytor av varje storlek."@sv .

<#cuboid-space-diagonal>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Space diagonal of a rectangular box with edges a, b and c"@en ,
                     "Rymddiagonalen i ett rätblock med kantlängderna a, b och c"@sv ;
    solid-memo:back "√(a² + b² + c²)"@zxx .

<#prism-volume>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Volume of a prism with base area B and height h"@en ,
                     "Volymen av ett prisma med basarean B och höjden h"@sv ;
    solid-memo:back "Bh"@zxx ;
    solid-memo:backNote "The height is the perpendicular distance between the two bases."@en ,
                        "Höjden är det vinkelräta avståndet mellan de två basytorna."@sv .

<#cylinder-volume>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Volume of a cylinder with radius r and height h"@en ,
                     "Volymen av en cylinder med radien r och höjden h"@sv ;
    solid-memo:back "πr²h"@zxx ;
    solid-memo:backNote "A circular cylinder: base area πr² times height."@en ,
                        "En cirkulär cylinder: basarean πr² gånger höjden."@sv .

<#cylinder-lateral-area>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Lateral surface area of a right circular cylinder with radius r and height h"@en ,
                     "Mantelarean av en rät cirkulär cylinder med radien r och höjden h"@sv ;
    solid-memo:back "2πrh"@zxx ;
    solid-memo:backNote "The curved surface only, without the two circular ends."@en ,
                        "Bara den välvda ytan, utan de två cirkelformade ändytorna."@sv .

<#cylinder-surface-area>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Total surface area of a right circular cylinder with radius r and height h"@en ,
                     "Begränsningsarean av en rät cirkulär cylinder med radien r och höjden h"@sv ;
    solid-memo:back "2πr² + 2πrh"@zxx ;
    solid-memo:backNote "Also written 2πr(r + h): the two ends plus the lateral surface."@en ,
                        "Skrivs även 2πr(r + h): de två ändytorna plus mantelytan."@sv .

<#pyramid-volume>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Volume of a pyramid with base area B and height h"@en ,
                     "Volymen av en pyramid med basarean B och höjden h"@sv ;
    solid-memo:back "Bh/3"@zxx ;
    solid-memo:backNote "A third of the prism with the same base and height. Also written ⅓Bh."@en ,
                        "En tredjedel av prismat med samma bas och höjd. Skrivs även ⅓Bh."@sv .

<#cone-volume>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Volume of a cone with radius r and height h"@en ,
                     "Volymen av en kon med radien r och höjden h"@sv ;
    solid-memo:back "πr²h/3"@zxx ;
    solid-memo:backNote "A third of the cylinder with the same base and height. Also written ⅓πr²h."@en ,
                        "En tredjedel av cylindern med samma bas och höjd. Skrivs även ⅓πr²h."@sv .

<#cone-lateral-area>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Lateral surface area of a right circular cone with radius r and slant height s"@en ,
                     "Mantelarean av en rät cirkulär kon med radien r och sidan s"@sv ;
    solid-memo:frontNote "s: the straight distance along the side from the apex to the rim of the base"@en ,
                         "s: den raka sträckan längs mantelytan från spetsen till basens rand"@sv ;
    solid-memo:back "πrs"@zxx ;
    solid-memo:backNote "s = √(r² + h²), where h is the height."@en ,
                        "s = √(r² + h²), där h är höjden."@sv .

<#cone-surface-area>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Total surface area of a right circular cone with radius r and slant height s"@en ,
                     "Begränsningsarean av en rät cirkulär kon med radien r och sidan s"@sv ;
    solid-memo:frontNote "s: the straight distance along the side from the apex to the rim of the base"@en ,
                         "s: den raka sträckan längs mantelytan från spetsen till basens rand"@sv ;
    solid-memo:back "πr² + πrs"@zxx ;
    solid-memo:backNote "Also written πr(r + s): the base plus the lateral surface."@en ,
                        "Skrivs även πr(r + s): basytan plus mantelytan."@sv .

<#sphere-volume>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Volume of a sphere with radius r"@en ,
                     "Volymen av ett klot med radien r"@sv ;
    solid-memo:back "(4/3)πr³"@zxx ;
    solid-memo:backNote "Also written 4πr³/3. Strictly the volume of the ball the sphere encloses (Swedish: klot)."@en ,
                        "Skrivs även 4πr³/3. Klotet är den kropp som sfären omsluter."@sv .

<#sphere-surface-area>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Surface area of a sphere with radius r"@en ,
                     "Arean av en sfär med radien r"@sv ;
    solid-memo:back "4πr²"@zxx ;
    solid-memo:backNote "Four times the area of a great circle, πr²."@en ,
                        "Fyra gånger arean av en storcirkel, πr²."@sv .

