<#marco-polo-bridge-incident>
    a solid-memo:Card ;
    solid-memo:formatVersion 4 ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    solid-memo:front "Marco Polo Bridge incident: fighting between Japan and China begins"@en ,
                     "Marco Polo-broincidenten: striderna mellan Japan och Kina börjar"@sv ;
    solid-memo:back "7 July 1937"@en ,
                    "7 juli 1937"@sv ;
    solid-memo:backNote "Start of the Second Sino-Japanese War, the war in Asia that merged into the Second World War"@en ,
                        "Början på andra kinesisk-japanska kriget, kriget i Asien som blev en del av andra världskriget"@sv .

