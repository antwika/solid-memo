    solid-memo:back "Rysy"@en ,
                    "Rysy"@sv ;
    solid-memo:backNote "Its north-western summit, on the border with Slovakia; Rysy's highest summit is in Slovakia."@en ,
                        "Dess nordvästra topp, på gränsen mot Slovakien; Rysys högsta topp ligger i Slovakien."@sv .

