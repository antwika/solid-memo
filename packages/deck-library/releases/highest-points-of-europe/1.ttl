<>
    a solid-memo:Deck ,
      dcat:Dataset ;
    dcterms:title "Highest points of European countries"@en ,
                  "Högsta punkterna i Europas länder"@sv ;
    dcterms:creator <#anton-wiklund> ;
    dcterms:license <https://creativecommons.org/publicdomain/zero/1.0/> ;
    dcterms:description "The highest point of 40 sovereign states of Europe, one card each: the states that the UN's M49 standard places in Europe, Russia included and Cyprus, Turkey and the Caucasus states not, leaving out Italy, Serbia, Monaco and Vatican City, whose highest point is disputed or not a named summit. Front: the country, e.g. “Highest point of Sweden”; back: the name of the summit in English and Swedish, often with a short note. For Denmark the card asks about Denmark proper (without Greenland and the Faroe Islands), for the Netherlands about the European part. Taken from Wikidata and checked against the CIA World Factbook's last edition, Wikipedia and national sources. Sources, method and quality control: https://github.com/antwika/solid-memo/blob/main/packages/deck-library/authored/highest-points-of-europe.md"@en ,
                        "Den högsta punkten i 40 självständiga stater i Europa, ett kort för varje: de stater som FN:s standard M49 räknar till Europa, med Ryssland men utan Cypern, Turkiet och Kaukasusländerna, och utan Italien, Serbien, Monaco och Vatikanstaten, vars högsta punkt är omstridd eller inte en namngiven topp. Framsida: landet, t.ex. ”Högsta punkten i Sverige”; baksida: toppens namn på engelska och svenska, ofta med en kort anteckning. För Danmark gäller kortet det egentliga Danmark (utan Grönland och Färöarna), för Nederländerna den europeiska delen. Uppgifterna är hämtade från Wikidata och kontrollerade mot den sista utgåvan av CIA:s World Factbook, Wikipedia och nationella källor. Källor, metod och kvalitetskontroll: https://github.com/antwika/solid-memo/blob/main/packages/deck-library/authored/highest-points-of-europe.md"@sv ;
    prov:wasDerivedFrom <https://www.wikidata.org/wiki/Property:P610> ;
    prov:wasGeneratedBy <#compilation> ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    dcat:theme <http://publications.europa.eu/resource/authority/data-theme/EDUC> ,
               topic:geography ;
    dcat:keyword "highest points"@en ,
                 "mountains"@en ,
                 "summits"@en ,
                 "Europe"@en ,
                 "geography"@en ,
                 "högsta punkter"@sv ,
                 "berg"@sv ,
                 "bergstoppar"@sv ,
                 "Europa"@sv ,
                 "geografi"@sv ;
    dcterms:language <http://publications.europa.eu/resource/authority/language/ENG> ,
                     <http://publications.europa.eu/resource/authority/language/SWE> ;
    solid-memo:studyDirection solid-memo:frontToBack ;
    solid-memo:formatVersion 5 ;
    dcat:version "1" ;
    dcterms:issued "2026-10-04T20:03:15Z"^^xsd:dateTime ;
    adms:versionNotes "First release: 40 cards, each checked against at least two sources; sources, method and quality control in authored/highest-points-of-europe.md." ;
    dcterms:publisher <https://solid-memo.com/decks/index.ttl#solid-memo> ;
    dcat:inSeries <https://solid-memo.com/decks/index.ttl#highest-points-of-europe> ;
    dcat:isVersionOf <https://solid-memo.com/decks/index.ttl#highest-points-of-europe> ;
