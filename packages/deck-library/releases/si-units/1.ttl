    dcterms:title "SI units and prefixes"@en ,
                  "SI-enheter och prefix"@sv ;
    dcterms:creator <#anton-wiklund> ;
    dcterms:license <https://creativecommons.org/publicdomain/zero/1.0/> ;
    dcterms:description "The International System of Units (SI) in 53 cards: the 7 base units, the 22 derived units with special names and the 24 SI prefixes, including ronna, quetta, ronto and quecto from 2022. The front names a quantity or a prefix; the back gives the SI unit with its symbol, or the prefix's factor and symbol. Compiled from NIST's SI guide and prefix table, Swedac's regulations on units of measurement (STAFS 2009:26) and Wikidata, and checked against the BIPM SI Brochure. Sources, method and quality control: https://github.com/antwika/solid-memo/blob/main/packages/deck-library/authored/si-units.md"@en ,
                        "Internationella måttenhetssystemet (SI) i 53 kort: de 7 grundenheterna, de 22 härledda enheterna med särskilda namn och de 24 SI-prefixen, inklusive ronna, quetta, ronto och quekto från 2022. Framsidan anger en storhet eller ett prefix; baksidan ger SI-enheten och dess beteckning, eller prefixets faktor och beteckning. Sammanställd ur NIST:s SI-guide och prefixtabell, Swedacs föreskrifter om måttenheter (STAFS 2009:26) och Wikidata, och kontrollerad mot BIPM:s SI-broschyr. Källor, metod och kvalitetskontroll: https://github.com/antwika/solid-memo/blob/main/packages/deck-library/authored/si-units.md"@sv ;
    prov:wasDerivedFrom <https://nvlpubs.nist.gov/nistpubs/Legacy/SP/nistspecialpublication811e2008.pdf> ,
                        <https://www.nist.gov/pml/owm/metric-si-prefixes> ,
                        <https://regelverk.swedac.se/foreskrifter/swedac/stafs-2009-26-konsol.pdf> ,
                        <https://www.wikidata.org/> ;
    prov:wasGeneratedBy <#compilation> ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
