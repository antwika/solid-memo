<>
    a solid-memo:Deck ,
      dcat:Dataset ;
    dcterms:title "Basic Spanish"@en ,
                  "Grundläggande spanska"@sv ;
    dcterms:creator <#anton-wiklund> ;
    dcterms:license <https://creativecommons.org/publicdomain/zero/1.0/> ;
    dcterms:description "120 basic Spanish words and phrases for beginners: the numbers 0–20, the tens and 100, the days of the week, the months, eight colours, family members, greetings and common phrases, and everyday nouns and verbs. The front shows the Spanish word, nouns with their article (el libro), except the days and months, whose gender is in a note; the back gives its English and Swedish meaning, or the digits for a number. Words, genders and meanings from Wikidata's lexemes and the US Foreign Service Institute's Spanish Basic Course (public domain), checked against the Real Academia Española's dictionary, Wiktionary and Folkets lexikon. Sources, method and quality control: https://github.com/antwika/solid-memo/blob/main/packages/deck-library/authored/spanish-basics.md"@en ,
                        "120 grundläggande spanska ord och fraser för nybörjare: talen 0–20, tiotalen och 100, veckodagarna, månaderna, åtta färger, familjemedlemmar, hälsningar och vanliga fraser samt vardagliga substantiv och verb. Framsidan visar det spanska ordet, substantiv med sin artikel (el libro) utom veckodagar och månader, vars genus står i en anteckning; baksidan ger betydelsen på engelska och svenska, eller siffrorna för ett tal. Ord, genus och betydelser från Wikidatas lexem och amerikanska Foreign Service Institutes Spanish Basic Course (fri från upphovsrätt), kontrollerade mot Real Academia Españolas ordbok, Wiktionary och Folkets lexikon. Källor, metod och kvalitetskontroll: https://github.com/antwika/solid-memo/blob/main/packages/deck-library/authored/spanish-basics.md"@sv ;
    prov:wasDerivedFrom <https://www.wikidata.org/> ,
                        <https://archive.org/details/Fsi-SpanishBasicCourse-StudentText> ;
    prov:wasGeneratedBy <#compilation> ;
    dcterms:created "2026-10-04T12:00:00.000Z"^^xsd:dateTime ;
    dcat:theme <http://publications.europa.eu/resource/authority/data-theme/EDUC> ,
               topic:languages ,
               topic:spanish ;
