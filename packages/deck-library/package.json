{
  "name": "@solid-memo/deck-library",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "exports": {
    "./*": "./src/*.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p .",
    "test": "vitest run --coverage",
    "release": "node -e \"import('./src/deckRelease.ts').then((m) => m.run(process))\" --",
    "format:turtle": "node -e \"import('@solid-memo/turtle/formatTurtle').then((m) => m.run(process))\" -- decks",
    "format:turtle:check": "node -e \"import('@solid-memo/turtle/formatTurtle').then((m) => m.run(process))\" -- --check decks"
  },
  "dependencies": {
    "@solid-memo/shacl": "*",
    "@solid-memo/turtle": "*",
    "@solid-memo/vocab": "*",
    "n3": "^2.0.0",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@rdfjs/types": "^2.0.1",
    "@types/n3": "^1.26.4"
  }
}
